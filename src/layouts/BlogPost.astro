---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/ui/BaseHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import FormattedDate from '../components/ui/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="id">
        <head>
                <BaseHead title={title} description={description} />
		<style>
			main {
				width: min(100%, 1100px);
				margin: 0 auto;
				padding: clamp(4rem, 8vw, 6rem) clamp(1.5rem, 6vw, 3.5rem);
			}
			.hero-image {
				width: 100%;
				margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
				position: relative;
			}
			.hero-image::after {
				content: "";
				position: absolute;
				inset: auto 10% -30% 10%;
				height: 160px;
				background: radial-gradient(circle, rgba(124, 77, 255, 0.4), transparent 70%);
				filter: blur(18px);
				opacity: 0.55;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: clamp(1.4rem, 4vw, 1.9rem);
				box-shadow: 0 0 45px rgba(12, 18, 36, 0.45);
				border: 1px solid rgba(124, 133, 178, 0.18);
			}
			.prose {
				width: min(720px, 100%);
				margin: auto;
				padding: 0 clamp(0.5rem, 2vw, 1.25rem) clamp(2rem, 6vw, 3rem);
				color: rgb(var(--text-secondary));
				background: rgba(17, 22, 36, 0.78);
				border-radius: clamp(1.8rem, 4vw, 2.2rem);
				border: 1px solid rgba(124, 133, 178, 0.18);
				box-shadow: 0 0 48px rgba(12, 18, 36, 0.45);
			}
			.title {
				margin-bottom: clamp(1.25rem, 3vw, 1.75rem);
				padding: clamp(1.35rem, 3vw, 1.75rem) clamp(1rem, 3vw, 1.8rem) 0;
				text-align: center;
				line-height: 1.1;
			}
			.title h1 {
				margin: 0 0 0.6em 0;
			}
			.date {
				margin-bottom: 0.75em;
				color: rgba(198, 204, 238, 0.65);
				text-transform: uppercase;
				letter-spacing: 0.18em;
				font-size: 0.75rem;
			}
			.last-updated-on {
				font-style: italic;
				color: rgba(198, 204, 238, 0.55);
			}
			.prose hr {
				border-top: 1px solid rgba(124, 77, 255, 0.2);
				margin: clamp(1.5rem, 3vw, 2rem) 0;
			}
			.prose p,
			.prose li {
				color: rgb(var(--text-secondary));
			}
		</style>
	</head>

        <body>
                <MarketingHeader />
                <main>
                        <article>
				<div class="hero-image">
					{heroImage && <img width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
                </main>
                <MarketingFooter />
        </body>
</html>
