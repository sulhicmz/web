---
import BaseHead from '../components/ui/BaseHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
        	<BaseHead title={title} description={description} type="website" />
        </head>
        <body class="marketing-shell">
                <div class="marketing-backdrop" aria-hidden="true"></div>
                <div class="marketing-grid" aria-hidden="true"></div>
                <MarketingHeader />
                <main class="marketing-main">
                        <slot />
                </main>
                <MarketingFooter />
                <AnalyticsConsent />
        </body>
</html>

<style>
        .marketing-shell {
                margin: 0;
                min-height: 100vh;
                background: transparent;
                position: relative;
                overflow-x: hidden;
                color: var(--color-text-primary);
        }

        .marketing-backdrop {
                position: fixed;
                inset: -20% -25% auto;
                pointer-events: none;
                background:
                        radial-gradient(35% 45% at 25% 18%, rgba(147, 51, 234, 0.35), transparent 72%),
                        radial-gradient(48% 60% at 75% 12%, rgba(34, 211, 238, 0.3), transparent 75%),
                        radial-gradient(60% 55% at 55% 80%, rgba(244, 114, 182, 0.22), transparent 78%);
                filter: blur(0px);
                z-index: -3;
                animation: backdropFloat 28s ease-in-out infinite alternate;
        }

        .marketing-grid {
                position: fixed;
                inset: 0;
                pointer-events: none;
                background-image:
                        linear-gradient(90deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px),
                        linear-gradient(0deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px);
                background-size: 120px 120px;
                mix-blend-mode: screen;
                z-index: -2;
                opacity: 0.4;
        }

        .marketing-main {
                width: 100%;
                max-width: 1160px;
                margin: 0 auto;
                padding: clamp(3.75rem, 7vw, 6.5rem) clamp(1.8rem, 6vw, 4rem) clamp(5rem, 10vw, 7.5rem);
        }

        @keyframes backdropFloat {
                0% {
                        transform: translate3d(0, 0, 0) scale(1);
                        opacity: 0.75;
                }
                50% {
                        transform: translate3d(-30px, 18px, 0) scale(1.04);
                        opacity: 0.9;
                }
                100% {
                        transform: translate3d(24px, -26px, 0) scale(1.06);
                        opacity: 0.8;
                }
        }

        @media (max-width: 720px) {
                .marketing-main {
                        padding: 3.5rem 1.4rem 4.75rem;
                }
        }
</style>
