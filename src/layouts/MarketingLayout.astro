---
import BaseHead from '../components/ui/BaseHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
        	<BaseHead title={title} description={description} type="website" />
        </head>
        <body class="marketing-shell">
                <div class="marketing-grid" aria-hidden="true"></div>
                <MarketingHeader />
                <main class="marketing-main">
                        <slot />
                </main>
                <MarketingFooter />
                <AnalyticsConsent />
        </body>
</html>

<style>
        .marketing-shell {
                margin: 0;
                min-height: 100vh;
                position: relative;
                overflow-x: hidden;
                color: var(--color-text-primary);
                background:
                        linear-gradient(160deg, rgba(8, 12, 32, 0.95) 0%, rgba(12, 18, 36, 0.92) 55%, rgba(17, 26, 48, 0.9) 100%),
                        radial-gradient(48% 58% at 18% 20%, rgba(147, 51, 234, 0.18), transparent 70%),
                        radial-gradient(40% 50% at 78% 12%, rgba(34, 211, 238, 0.12), transparent 72%);
        }

        .marketing-grid {
                position: absolute;
                inset: 0;
                pointer-events: none;
                background-image:
                        linear-gradient(90deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px),
                        linear-gradient(0deg, rgba(148, 163, 184, 0.04) 1px, transparent 1px);
                background-size: 120px 120px;
                mix-blend-mode: screen;
                z-index: -2;
                opacity: 0.28;
        }

        .marketing-main {
                width: 100%;
                max-width: 1160px;
                margin: 0 auto;
                padding: clamp(3.75rem, 7vw, 6.5rem) clamp(1.8rem, 6vw, 4rem) clamp(5rem, 10vw, 7.5rem);
        }

        @media (max-width: 720px) {
                .marketing-main {
                        padding: 3.5rem 1.4rem 4.75rem;
                }

                .marketing-grid {
                        opacity: 0.2;
                        background-size: 160px 160px;
                }
        }
</style>
