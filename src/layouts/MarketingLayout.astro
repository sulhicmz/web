---
import BaseHead from '../components/ui/BaseHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
                <BaseHead title={title} description={description} />
        </head>
        <body class="marketing-shell">
                <div class="marketing-backdrop" aria-hidden="true"></div>
                <MarketingHeader />
                <main class="marketing-main">
                        <slot />
                </main>
                <MarketingFooter />
                <AnalyticsConsent />
        </body>
</html>

<style>
        .marketing-shell {
                margin: 0;
                min-height: 100vh;
                background: transparent;
                position: relative;
                overflow-x: hidden;
        }

        .marketing-backdrop {
                position: fixed;
                inset: -15% -30%;
                pointer-events: none;
                background:
                        radial-gradient(38% 42% at 20% 15%, rgba(90, 209, 255, 0.22), transparent 68%),
                        radial-gradient(45% 55% at 80% 10%, rgba(168, 137, 255, 0.18), transparent 70%),
                        radial-gradient(55% 45% at 60% 85%, rgba(66, 233, 207, 0.12), transparent 72%);
                filter: blur(0px);
                z-index: -1;
                animation: backdropFloat 24s ease-in-out infinite alternate;
        }

        .marketing-main {
                width: 100%;
                max-width: 1140px;
                margin: 0 auto;
                padding: clamp(3.5rem, 7vw, 6rem) clamp(1.75rem, 6vw, 3.75rem) clamp(4.5rem, 10vw, 7rem);
        }

        @keyframes backdropFloat {
                0% {
                        transform: translate3d(0, 0, 0) scale(1);
                        opacity: 0.7;
                }
                100% {
                        transform: translate3d(-28px, 26px, 0) scale(1.05);
                        opacity: 0.9;
                }
        }

        @media (max-width: 720px) {
                .marketing-main {
                        padding: 3.5rem 1.4rem 4.5rem;
                }
        }
</style>
