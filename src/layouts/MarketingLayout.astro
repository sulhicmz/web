---
import BaseHead from '../components/ui/BaseHead.astro';
import MarketingHeader from '../components/marketing/MarketingHeader.astro';
import MarketingFooter from '../components/marketing/MarketingFooter.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
                <BaseHead title={title} description={description} />
        </head>
<body class="marketing-shell">
                <div class="marketing-gradient" aria-hidden="true"></div>
                <MarketingHeader />
                <main class="marketing-main">
                        <slot />
                </main>
                <MarketingFooter />
                <AnalyticsConsent />
        </body>
</html>

<style>
        .marketing-shell {
                margin: 0;
                min-height: 100vh;
                background: transparent;
                position: relative;
                overflow-x: hidden;
        }

        .marketing-gradient {
                position: fixed;
                inset: -15vh -20vw;
                pointer-events: none;
                background: radial-gradient(40% 60% at 15% 20%, rgba(124, 77, 255, 0.35), transparent 70%),
                        radial-gradient(50% 60% at 80% 10%, rgba(0, 187, 255, 0.28), transparent 75%),
                        radial-gradient(55% 65% at 50% 85%, rgba(255, 72, 155, 0.18), transparent 75%);
                filter: blur(0px);
                transform: translateZ(0);
                z-index: -1;
                animation: pulseGlow 16s ease-in-out infinite alternate;
        }

        .marketing-main {
                width: 100%;
                max-width: 1100px;
                margin: 0 auto;
                padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem) clamp(4rem, 10vw, 7rem);
        }

        @keyframes pulseGlow {
                0% {
                        opacity: 0.55;
                }
                100% {
                        opacity: 0.85;
                }
        }

        @media (max-width: 720px) {
                .marketing-main {
                        padding: 3.5rem 1.25rem 4.5rem;
                }
        }
</style>
