---
import BaseHead from '../components/ui/BaseHead.astro';
import PortalNav from '../components/portal/PortalNav.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = `${SITE_TITLE} Portal`, description = 'Portal klien untuk mengelola proyek, paket, dan dukungan.' } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
        	<BaseHead title={title} description={description} type="website" />
        </head>
        <body class="portal-shell">
                <div class="portal-background" aria-hidden="true"></div>
                <aside class="sidebar">
                        <PortalNav />
                </aside>
                <main class="portal-main">
                        <div class="portal-main__surface">
                                <slot />
                        </div>
                </main>
                <AnalyticsConsent />
        </body>
</html>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

  const logoutButton = document.getElementById('logout-button');

  logoutButton.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/login';
  });
</script>

<style>
        .portal-shell {
                margin: 0;
                min-height: 100vh;
                display: grid;
                grid-template-columns: minmax(240px, 280px) 1fr;
                background: var(--bg-base);
                position: relative;
                overflow-x: hidden;
        }

        .portal-background {
                position: fixed;
                inset: -20% -25%;
                background:
                        radial-gradient(40% 48% at 20% 25%, rgba(90, 209, 255, 0.2), transparent 70%),
                        radial-gradient(52% 55% at 70% 80%, rgba(168, 137, 255, 0.18), transparent 70%);
                filter: blur(0px);
                opacity: 0.75;
                z-index: -1;
                animation: ambientShift 24s ease-in-out infinite alternate;
        }

        .sidebar {
                background: rgba(8, 11, 22, 0.88);
                color: #f5f7fb;
                backdrop-filter: blur(18px);
                border-right: 1px solid rgba(108, 126, 171, 0.22);
                box-shadow: inset -1px 0 0 rgba(108, 126, 171, 0.05), 18px 0 38px rgba(7, 11, 22, 0.4);
        }

        .portal-main {
                width: 100%;
                padding: clamp(2.5rem, 5vw, 3.5rem) clamp(2rem, 6vw, 4rem) clamp(3rem, 6vw, 4.5rem);
                position: relative;
        }

        .portal-main__surface {
                background: rgba(13, 18, 32, 0.78);
                border-radius: clamp(2rem, 5vw, 2.6rem);
                border: 1px solid rgba(108, 126, 171, 0.22);
                box-shadow: 0 18px 40px rgba(7, 11, 22, 0.35);
                padding: clamp(2rem, 5vw, 2.8rem);
                min-height: calc(100vh - clamp(5rem, 10vw, 7rem));
        }

        @media (max-width: 960px) {
                .portal-shell {
                        grid-template-columns: 1fr;
                }

                .sidebar {
                        position: sticky;
                        top: 0;
                        z-index: 10;
                }

                .portal-main {
                        padding: 2.5rem 1.6rem 3.5rem;
                }
        }

        @keyframes ambientShift {
                0% {
                        transform: translate3d(0, 0, 0) scale(1);
                        opacity: 0.6;
                }
                100% {
                        transform: translate3d(-28px, 22px, 0) scale(1.05);
                        opacity: 0.82;
                }
        }
</style>
