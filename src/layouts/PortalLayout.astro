---
import BaseHead from '../components/ui/BaseHead.astro';
import PortalNav from '../components/portal/PortalNav.astro';
import AnalyticsConsent from '../components/analytics/AnalyticsConsent.astro';
import { SITE_TITLE } from '../consts';

interface Props {
        title?: string;
        description?: string;
}

const { title = `${SITE_TITLE} Portal`, description = 'Portal klien untuk mengelola proyek, paket, dan dukungan.' } = Astro.props as Props;
---

<!doctype html>
<html lang="id">
        <head>
                <BaseHead title={title} description={description} />
        </head>
<body class="portal-shell">
                <div class="portal-background" aria-hidden="true"></div>
                <aside class="sidebar">
                        <PortalNav />
                </aside>
                <main class="portal-main">
                        <div class="portal-main__surface">
                                <slot />
                        </div>
                </main>
                <AnalyticsConsent />
        </body>
</html>

<style>
        .portal-shell {
                margin: 0;
                min-height: 100vh;
                display: grid;
                grid-template-columns: minmax(240px, 280px) 1fr;
                background: radial-gradient(circle at top left, rgba(124, 77, 255, 0.12), transparent 45%),
                        radial-gradient(circle at bottom right, rgba(0, 187, 255, 0.1), transparent 55%),
                        #05060f;
                position: relative;
                overflow-x: hidden;
        }

        .portal-background {
                position: fixed;
                inset: -20%;
                background: radial-gradient(35% 55% at 20% 25%, rgba(124, 77, 255, 0.35), transparent 70%),
                        radial-gradient(50% 60% at 70% 80%, rgba(0, 187, 255, 0.25), transparent 75%);
                filter: blur(0px);
                opacity: 0.75;
                z-index: -2;
                animation: ambientShift 18s ease-in-out infinite alternate;
        }

        .sidebar {
                background: rgba(11, 13, 22, 0.88);
                color: #f5f7fb;
                backdrop-filter: blur(18px);
                border-right: 1px solid rgba(124, 133, 178, 0.16);
                box-shadow: inset -1px 0 0 rgba(124, 133, 178, 0.04), 20px 0 40px rgba(5, 6, 15, 0.4);
        }

        .portal-main {
                width: 100%;
                padding: clamp(2.5rem, 5vw, 3.5rem) clamp(2rem, 6vw, 4rem) clamp(3rem, 6vw, 4.5rem);
                position: relative;
        }

        .portal-main__surface {
                background: rgba(18, 22, 34, 0.72);
                border-radius: clamp(2rem, 5vw, 2.75rem);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 45px rgba(18, 22, 40, 0.4), 0 0 60px rgba(124, 77, 255, 0.12);
                padding: clamp(2rem, 5vw, 3rem);
                min-height: calc(100vh - clamp(5rem, 10vw, 7rem));
        }

        @media (max-width: 960px) {
                .portal-shell {
                        grid-template-columns: 1fr;
                }

                .sidebar {
                        position: sticky;
                        top: 0;
                        z-index: 10;
                }

                .portal-main {
                        padding: 2.5rem 1.5rem 3.5rem;
                }
        }

        @keyframes ambientShift {
                0% {
                        transform: translate3d(0, 0, 0) scale(1);
                        opacity: 0.6;
                }
                100% {
                        transform: translate3d(-25px, 18px, 0) scale(1.05);
                        opacity: 0.85;
                }
        }
</style>
