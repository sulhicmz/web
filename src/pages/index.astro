---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildWhatsappLink } from '../consts';

const heroWhatsappLink = buildWhatsappLink('Halo, saya butuh konsultasi website');
---

<MarketingLayout title="Jasa Website Astro + Portal Klien" description="Bangun situs pemasaran, portofolio, blog, dan portal klien terpadu dengan arsitektur Astro yang cepat dan aman.">
        <section class="hero" data-animate>
                <div class="hero-grid">
                        <div class="hero-copy">
                                <p class="eyebrow">Website + Portal Klien dalam Satu Sprint</p>
                                <h1>Solusi digital futuristik yang tetap ramah dioperasikan tim Anda.</h1>
                                <p class="lead">
                                        Kami mendesain pengalaman terpadu—dari situs pemasaran, knowledge base, hingga portal klien—dengan fondasi Astro, Supabase, dan otomasi pembayaran lokal yang siap scale.
                                </p>
                                <div class="hero-actions">
                                        <a class="btn primary" href={heroWhatsappLink} target="_blank" rel="noreferrer">
                                                Konsultasi via WhatsApp
                                        </a>
                                        <a class="btn ghost" href="/layanan">Lihat Paket Layanan</a>
                                </div>
                                <dl class="hero-stats">
                                        <div>
                                                <dt>30+</dt>
                                                <dd>implementasi portal aktif dengan SLA respons &lt; 48 jam</dd>
                                        </div>
                                        <div>
                                                <dt>94%</dt>
                                                <dd>kepuasan klien terhadap onboarding digital</dd>
                                        </div>
                                        <div>
                                                <dt>6 minggu</dt>
                                                <dd>rata-rata waktu go-live dari discovery ke produksi</dd>
                                        </div>
                                </dl>
                        </div>
                        <aside class="hero-panel">
                                <span class="hero-panel__glow" aria-hidden="true"></span>
                                <h2>Blueprint Cepat</h2>
                                <ul>
                                        <li>
                                                <span>Astro hybrid untuk marketing cepat &amp; portal SSR.</span>
                                                <strong>Performa &lt; 1s TTFB</strong>
                                        </li>
                                        <li>
                                                <span>Supabase dengan RLS siap multi klien.</span>
                                                <strong>Peran owner/staff/client/viewer</strong>
                                        </li>
                                        <li>
                                                <span>Integrasi Midtrans Snap dan webhook tervalidasi.</span>
                                                <strong>Pembayaran IDR otomatis</strong>
                                        </li>
                                </ul>
                        </aside>
                </div>
        </section>

        <section class="value-grid" data-animate>
                <h2>Mengapa memilih kami</h2>
                <div class="grid">
                        <article>
                                <span class="icon">⚙️</span>
                                <h3>Arsitektur Modular</h3>
                                <p>Integrasi marketing, portal, dan analitik dalam komponen yang mudah dipelihara.</p>
                        </article>
                        <article>
                                <span class="icon">🛰️</span>
                                <h3>Pengalaman Futuristik</h3>
                                <p>Desain responsif dengan mikrointeraksi halus yang menjaga fokus pengguna.</p>
                        </article>
                        <article>
                                <span class="icon">🤝</span>
                                <h3>Ramah Operasional</h3>
                                <p>Runbook, automasi notifikasi, dan guard Supabase memastikan tim support tetap ringan.</p>
                        </article>
                </div>
        </section>

        <section class="process" data-animate>
                <h2>Peta kolaborasi cepat</h2>
                <ol>
                        <li>
                                <div class="step-badge">01</div>
                                <h3>Discovery &amp; Scope</h3>
                                <p>Workshop kebutuhan, definisi KPI, dan penentuan journey pengguna.</p>
                        </li>
                        <li>
                                <div class="step-badge">02</div>
                                <h3>Desain &amp; Validasi</h3>
                                <p>Design system tematik, prototipe, dan uji aksesibilitas.</p>
                        </li>
                        <li>
                                <div class="step-badge">03</div>
                                <h3>Integrasi &amp; Automasi</h3>
                                <p>Konfigurasi Supabase, pembayaran, dan sinkronisasi WhatsApp/email.</p>
                        </li>
                        <li>
                                <div class="step-badge">04</div>
                                <h3>Go-Live &amp; Optimasi</h3>
                                <p>Deploy ke Cloudflare, pelatihan tim, dan observability berkelanjutan.</p>
                        </li>
                </ol>
        </section>

        <section class="cta-banner" data-animate>
                <div class="cta-content">
                        <h2>Siap melesat ke pengalaman digital baru?</h2>
                        <p>Jadwalkan sesi strategi 30 menit untuk melihat demo portal dan rencana implementasi yang paling pas.</p>
                </div>
                <a class="btn primary" href="/kontak">Jadwalkan Demo</a>
        </section>
</MarketingLayout>

<style>
        .hero {
                position: relative;
                padding: clamp(3rem, 6vw, 5rem) clamp(2rem, 6vw, 3rem);
                background: rgba(15, 19, 34, 0.65);
                border: 1px solid rgba(108, 126, 171, 0.18);
                border-radius: clamp(2.4rem, 6vw, 3rem);
                box-shadow: 0 18px 42px rgba(7, 11, 22, 0.35);
                overflow: hidden;
        }

        .hero::after {
                content: "";
                position: absolute;
                inset: -45% auto auto 55%;
                width: 420px;
                height: 420px;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.14), transparent 70%);
                filter: blur(12px);
                opacity: 0.7;
        }

        .hero-grid {
                display: grid;
                gap: clamp(2rem, 6vw, 3rem);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                align-items: center;
                position: relative;
        }

        .hero-copy {
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
        }

        .eyebrow {
                text-transform: uppercase;
                letter-spacing: 0.36em;
                color: rgba(255, 255, 255, 0.7);
                font-weight: 600;
                font-size: 0.8rem;
        }

        .lead {
                font-size: clamp(1.05rem, 2.2vw, 1.25rem);
                margin: 0;
                color: rgb(var(--text-secondary));
        }

        .hero-actions {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
        }

        .hero-stats {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
                gap: 1rem;
                margin: 0;
                padding: 0;
        }

        .hero-stats dt {
                font-size: clamp(1.4rem, 3vw, 1.9rem);
                font-weight: 700;
                color: rgb(var(--text-primary));
        }

        .hero-stats dd {
                margin: 0.35rem 0 0;
                color: rgb(var(--text-muted));
                font-size: 0.9rem;
        }

        .hero-panel {
                position: relative;
                background: rgba(12, 18, 32, 0.82);
                border-radius: clamp(1.8rem, 5vw, 2.2rem);
                border: 1px solid rgba(108, 126, 171, 0.18);
                padding: clamp(1.8rem, 4vw, 2.3rem);
                box-shadow: 0 18px 36px rgba(7, 11, 22, 0.32);
                display: grid;
                gap: 1.2rem;
        }

        .hero-panel__glow {
                position: absolute;
                inset: -25% -15% auto auto;
                width: 240px;
                height: 240px;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.18), transparent 65%);
                filter: blur(16px);
                opacity: 0.6;
        }

        .hero-panel h2 {
                margin: 0;
                font-size: 1.1rem;
                color: rgb(var(--text-primary));
        }

        .hero-panel ul {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 1rem;
        }

        .hero-panel li {
                display: grid;
                gap: 0.35rem;
                padding: 0.25rem 0;
                color: rgb(var(--text-secondary));
        }

        .hero-panel strong {
                font-size: 0.85rem;
                color: rgb(var(--text-primary));
        }

        .value-grid {
                margin-top: clamp(4rem, 8vw, 6rem);
                text-align: center;
        }

        .value-grid .grid {
                margin-top: clamp(1.5rem, 4vw, 2.5rem);
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .value-grid article {
                position: relative;
                background: rgba(15, 20, 36, 0.8);
                border-radius: clamp(1.5rem, 4vw, 1.9rem);
                padding: clamp(1.8rem, 4vw, 2.3rem);
                border: 1px solid rgba(108, 126, 171, 0.18);
                box-shadow: 0 16px 32px rgba(7, 11, 22, 0.28);
                display: grid;
                gap: 0.75rem;
        }

        .value-grid .icon {
                font-size: 1.6rem;
        }

        .process {
                margin-top: clamp(4rem, 8vw, 6rem);
        }

        .process ol {
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
                counter-reset: steps;
                grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
                padding-left: 0;
                list-style: none;
        }

        .process li {
                background: rgba(15, 20, 36, 0.78);
                border-radius: clamp(1.6rem, 4vw, 1.9rem);
                padding: clamp(1.8rem, 4vw, 2.3rem);
                border: 1px solid rgba(108, 126, 171, 0.18);
                box-shadow: 0 14px 28px rgba(7, 11, 22, 0.26);
                position: relative;
                display: grid;
                gap: 0.65rem;
        }

        .step-badge {
                width: 2.25rem;
                height: 2.25rem;
                border-radius: 0.75rem;
                background: rgba(90, 209, 255, 0.18);
                color: rgb(var(--text-primary));
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 0.9rem;
        }

        .cta-banner {
                margin-top: clamp(4.5rem, 9vw, 7rem);
                background: rgba(11, 16, 30, 0.88);
                border-radius: clamp(1.8rem, 5vw, 2.3rem);
                padding: clamp(2.5rem, 6vw, 3.5rem);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: clamp(1.5rem, 4vw, 2.5rem);
                flex-wrap: wrap;
                border: 1px solid rgba(108, 126, 171, 0.22);
                box-shadow: 0 16px 36px rgba(7, 11, 22, 0.32);
        }

        .cta-banner h2 {
                color: rgb(var(--text-primary));
        }

        [data-animate] {
                animation: floatFade 720ms var(--transition-smooth) both;
        }

        [data-animate]:nth-of-type(2) {
                animation-delay: 120ms;
        }

        [data-animate]:nth-of-type(3) {
                animation-delay: 220ms;
        }

        [data-animate]:nth-of-type(4) {
                animation-delay: 320ms;
        }

        @keyframes floatFade {
                0% {
                        opacity: 0;
                        transform: translateY(22px) scale(0.98);
                }
                100% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                }
        }

        @media (max-width: 900px) {
                .hero {
                        padding: clamp(2.5rem, 6vw, 3.2rem);
                }

                .hero-grid {
                        grid-template-columns: 1fr;
                }

                .hero-panel {
                        order: -1;
                }
        }

        @media (max-width: 720px) {
                .cta-banner {
                        text-align: center;
                        justify-content: center;
                }
        }
</style>
