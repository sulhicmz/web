---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import HeroSection from '../components/marketing/HeroSection.astro';
import FeatureCard from '../components/marketing/FeatureCard.astro';
import TestimonialCard from '../components/marketing/TestimonialCard.astro';
const heroWhatsappLink = 'https://wa.me/6281234567890?text=Halo%2C%20saya%20tertarik%20dengan%20layanan%20digital%20agency';
---

<MarketingLayout title="Jasa Website Astro + Portal Klien" description="Bangun situs pemasaran, portofolio, blog, dan portal klien terpadu dengan arsitektur Astro yang cepat dan aman.">
  <!-- Hero Section -->
  <HeroSection
    title="Platform Agency Modern untuk Masa Depan Digital"
    subtitle="Satukan marketing site, client portal, dan operasional dalam satu platform terpadu. Dibangun dengan Astro, Supabase, dan Cloudflare untuk performa dan skalabilitas maksimal."
    primaryCTA={{
      text: 'Mulai Konsultasi',
      href: heroWhatsappLink
    }}
    secondaryCTA={{
      text: 'Lihat Demo',
      href: '/portal'
    }}
    backgroundPattern="gradient"
  />

  <section class="outcomes-section" aria-label="Hasil transformasi klien">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Hasil nyata</p>
        <h2>Dampak utama yang dicapai klien AstroPro</h2>
        <p class="section-subtitle">
          Blueprint kami menggabungkan marketing site, portal klien, dan automasi operasional dalam satu ekosistem yang siap scale.
        </p>
      </div>

      <div class="outcomes-grid">
        <article class="outcome-card">
          <span class="outcome-card__value">+72%</span>
          <span class="outcome-card__label">Conversion rate marketing site</span>
          <p class="outcome-card__detail">Optimasi landing, copy berbasis data, dan eksperimen terukur.</p>
        </article>
        <article class="outcome-card">
          <span class="outcome-card__value">-60%</span>
          <span class="outcome-card__label">Waktu pengerjaan onboarding</span>
          <p class="outcome-card__detail">Portal klien streamline dengan alur approval otomatis.</p>
        </article>
        <article class="outcome-card">
          <span class="outcome-card__value">98%</span>
          <span class="outcome-card__label">Kepuasan klien yang diukur</span>
          <p class="outcome-card__detail">Survey NPS di dalam portal plus laporan kinerja berkala.</p>
        </article>
        <article class="outcome-card">
          <span class="outcome-card__value">24/7</span>
          <span class="outcome-card__label">Operasional siap produksi</span>
          <p class="outcome-card__detail">Observability real-time dan runbook insiden terstandarisasi.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="solutions-section" aria-label="Solusi untuk agensi digital">
    <div class="container">
      <div class="solutions-layout">
        <header class="solutions-header">
          <p class="section-eyebrow">Solusi terpadu</p>
          <h2>Layout konten dirancang mengikuti tujuan bisnis</h2>
          <p class="section-subtitle">
            Setiap modul siap dikustomisasi untuk menangani penjualan layanan, kolaborasi tim internal, hingga dukungan pasca-proyek.
          </p>
        </header>

        <div class="solutions-grid">
          <article class="solution-card">
            <div class="solution-card__icon" aria-hidden="true">🎯</div>
            <h3>Lead Generation yang terukur</h3>
            <p>Landing page modular, formulir multi-step, dan automasi nurturing terhubung CRM.</p>
            <ul>
              <li>Komponen hero &amp; CTA berbasis eksperimen</li>
              <li>Integrasi analitik consent-first</li>
              <li>Segmentasi konten dan personalisasi</li>
            </ul>
          </article>

          <article class="solution-card">
            <div class="solution-card__icon" aria-hidden="true">🪐</div>
            <h3>Portal Klien kolaboratif</h3>
            <p>Dashboard status, repository dokumen, dan ticketing dengan SLA yang jelas.</p>
            <ul>
              <li>Hak akses granular dengan Supabase RLS</li>
              <li>Timeline proyek dan milestone otomatis</li>
              <li>Widget laporan KPI siap ekspor</li>
            </ul>
          </article>

          <article class="solution-card">
            <div class="solution-card__icon" aria-hidden="true">⚙️</div>
            <h3>Operasional &amp; billing otomatis</h3>
            <p>Integrasi Midtrans, invoice otomatis, dan notifikasi lintas kanal yang sinkron.</p>
            <ul>
              <li>Template kontrak &amp; tagihan digital</li>
              <li>Sinkronisasi Slack/Email real-time</li>
              <li>Audit trail lengkap untuk compliance</li>
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features-section" aria-label="Fitur utama platform">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Blueprint produk</p>
        <h2>Fondasi produk siap produksi yang kami bangun</h2>
        <p class="section-subtitle">Fitur lengkap untuk memastikan marketing site dan portal klien berjalan harmonis.</p>
      </div>

      <div class="features-grid">
        <FeatureCard
          title="Marketing Site Modern"
          description="Website pemasaran yang cepat, SEO-friendly, dan conversion-optimized dengan konten dinamis."
          icon="globe"
          benefits={[
            'SSG untuk performa maksimal',
            'Content collections dengan MDX',
            'SEO dan analytics terintegrasi',
            'Responsive design untuk semua device'
          ]}
          ctaText="Lihat Fitur"
          ctaHref="/layanan"
          variant="detailed"
        />

        <FeatureCard
          title="Client Portal Terpadu"
          description="Dashboard klien dengan manajemen proyek, billing, dan support system yang user-friendly."
          icon="users"
          benefits={[
            'SSR untuk interaktivitas real-time',
            'RBAC dengan Supabase Auth',
            'Multi-tenant architecture',
            'Real-time notifications'
          ]}
          ctaText="Coba Portal"
          ctaHref="/portal"
          variant="detailed"
        />

        <FeatureCard
          title="Payment & Billing"
          description="Sistem pembayaran terintegrasi dengan Midtrans untuk transaksi yang aman dan mudah."
          icon="payment"
          benefits={[
            'Midtrans payment gateway',
            'Invoice otomatis',
            'Webhook validation',
            'Multi-currency support'
          ]}
          ctaText="Lihat Pricing"
          ctaHref="/layanan"
          variant="detailed"
        />

        <FeatureCard
          title="Operational Automation"
          description="Otomasi operasional dengan CI/CD, monitoring, dan runbook untuk efisiensi tim."
          icon="automation"
          benefits={[
            'Cloudflare Workers deployment',
            'Automated testing & QA',
            'Performance monitoring',
            'Incident response runbooks'
          ]}
          ctaText="Pelajari Lebih Lanjut"
          ctaHref="/about"
          variant="detailed"
        />
      </div>
    </div>
  </section>

  <section class="workflow-section" aria-label="Alur implementasi">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Cara kami bekerja</p>
        <h2>Roadmap kolaborasi empat fase</h2>
        <p class="section-subtitle">Setiap fase dibekali artefak, dokumentasi, dan standar QA supaya tim Anda siap melanjutkan sendiri.</p>
      </div>

      <ol class="workflow-timeline">
        <li class="workflow-step">
          <div class="step-badge">01</div>
          <h3>Discovery &amp; alignment</h3>
          <p>Pemetaan persona, audit stack, serta definisi KPI marketing &amp; portal.</p>
        </li>
        <li class="workflow-step">
          <div class="step-badge">02</div>
          <h3>Experience design</h3>
          <p>Wireframe alur klien, design system neon futuristik, dan copy konversi tinggi.</p>
        </li>
        <li class="workflow-step">
          <div class="step-badge">03</div>
          <h3>Build &amp; integration</h3>
          <p>Astro + Supabase, Midtrans, serta automasi email/Slack yang terukur.</p>
        </li>
        <li class="workflow-step">
          <div class="step-badge">04</div>
          <h3>Launch &amp; scale</h3>
          <p>Deploy Cloudflare, training tim, dan backlog optimalisasi berkelanjutan.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="stack-section" aria-label="Teknologi dan dukungan">
    <div class="container">
      <div class="stack-layout">
        <div class="stack-intro">
          <p class="section-eyebrow">Stack siap produksi</p>
          <h2>Teknologi pilihan yang kami gunakan</h2>
          <p class="section-subtitle">Fondasi yang scalable memastikan portal klien dan marketing site Anda tetap stabil, aman, dan mudah dipelihara.</p>
        </div>
        <div class="stack-cards">
          <article class="stack-card">
            <h3>Lapisan presentasi</h3>
            <ul>
              <li>Astro dengan Islands Architecture</li>
              <li>Styling modular dengan tokens neon</li>
              <li>MDX untuk konten kampanye</li>
            </ul>
          </article>
          <article class="stack-card">
            <h3>Data &amp; integrasi</h3>
            <ul>
              <li>Supabase Postgres + Storage</li>
              <li>Midtrans &amp; invoice otomatis</li>
              <li>Webhook terverifikasi</li>
            </ul>
          </article>
          <article class="stack-card">
            <h3>Operasional</h3>
            <ul>
              <li>Cloudflare Workers &amp; Pages</li>
              <li>Observability &amp; alerting siap pakai</li>
              <li>Runbook QA dan incident response</li>
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="testimonials-section" aria-label="Testimoni klien">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Buktipakai</p>
        <h2>Yang dikatakan klien setelah go-live</h2>
        <p class="section-subtitle">Mereka merasakan peningkatan performa, efisiensi, dan kepuasan klien sejak fase pertama.</p>
      </div>

      <div class="testimonials-grid">
        <TestimonialCard
          quote="Platform ini benar-benar mengubah cara kami mengelola proyek dan klien. Setup cepat, fitur lengkap, dan support yang responsif. Sangat recommended untuk agensi modern."
          author={{
            name: 'Sarah Wijaya',
            role: 'CEO',
            company: 'DigitalCraft Agency'
          }}
          rating={5}
          metrics={[
            { label: 'Proyek Selesai', value: '150+' },
            { label: 'Client Satisfaction', value: '98%' }
          ]}
          variant="featured"
        />

        <TestimonialCard
          quote="Dari yang manual menjadi automated. Portal klien yang profesional dan marketing site yang convert. Best investment untuk bisnis kami tahun ini."
          author={{
            name: 'Budi Santoso',
            role: 'Founder',
            company: 'TechVantage Solutions'
          }}
          rating={5}
          metrics={[
            { label: 'Revenue Increase', value: '+45%' },
            { label: 'Time Saved', value: '20h/week' }
          ]}
          variant="featured"
        />

        <TestimonialCard
          quote="Integrasi pembayaran dan sistem support yang seamless. Tim development kami jadi lebih fokus ke inovasi, bukan maintenance."
          author={{
            name: 'Maya Putri',
            role: 'CTO',
            company: 'InnovateHub'
          }}
          rating={5}
          metrics={[
            { label: 'Dev Productivity', value: '+60%' },
            { label: 'Support Tickets', value: '-80%' }
          ]}
          variant="featured"
        />
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section" aria-label="Call to action">
    <div class="container">
      <div class="cta-content">
        <h2>Siap transformasi digital agency Anda?</h2>
        <p class="cta-description">
          Bergabunglah dengan agensi modern lainnya. Konsultasi gratis, demo langsung, dan roadmap implementasi yang terstruktur untuk kesuksesan bisnis Anda.
        </p>

        <div class="cta-actions">
          <a href={heroWhatsappLink} class="btn btn--cta-primary" target="_blank" rel="noreferrer">
            Konsultasi Sekarang
            <span aria-hidden="true">→</span>
          </a>
          <a href="/kontak" class="btn btn--cta-secondary">
            Jadwalkan Demo
            <span aria-hidden="true">📅</span>
          </a>
        </div>

        <div class="cta-features">
          <div class="cta-feature">
            <span class="cta-feature__icon" aria-hidden="true">⚡</span>
            <span class="cta-feature__text">Setup dalam 1 hari</span>
          </div>
          <div class="cta-feature">
            <span class="cta-feature__icon" aria-hidden="true">🔒</span>
            <span class="cta-feature__text">Security enterprise-grade</span>
          </div>
          <div class="cta-feature">
            <span class="cta-feature__icon" aria-hidden="true">🎯</span>
            <span class="cta-feature__text">Support 24/7</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .container {
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    position: relative;
  }

  .section-header h2 {
    font-size: clamp(2rem, 2rem + 1vw, 2.75rem);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-4);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 26px rgba(147, 51, 234, 0.25);
  }

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: rgba(var(--text-secondary), 0.85);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-subtitle {
    font-size: var(--text-lg);
    color: rgba(var(--text-secondary), 0.85);
    margin: 0 auto;
    max-width: 720px;
    line-height: var(--leading-relaxed);
  }

  .outcomes-section {
    position: relative;
    padding: clamp(5rem, 8vw, 6.5rem) 0;
  }

  .outcomes-section::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: linear-gradient(155deg, rgba(6, 12, 32, 0.85) 0%, rgba(17, 26, 48, 0.78) 60%, rgba(28, 36, 64, 0.82) 100%);
    border: 1px solid rgba(56, 189, 248, 0.2);
    box-shadow: 0 26px 58px rgba(2, 6, 23, 0.55);
  }

  .outcomes-section::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: radial-gradient(circle at 20% 25%, rgba(147, 51, 234, 0.28), transparent 65%),
      radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.25), transparent 70%);
    pointer-events: none;
    opacity: 0.6;
  }

  .outcomes-section > .container {
    position: relative;
    z-index: 1;
  }

  .outcomes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
  }

  .outcome-card {
    background: rgba(8, 12, 32, 0.82);
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(56, 189, 248, 0.28);
    padding: clamp(1.75rem, 3vw, 2.4rem);
    box-shadow: 0 18px 36px rgba(2, 6, 23, 0.45);
    display: grid;
    gap: 0.75rem;
    position: relative;
    overflow: hidden;
  }

  .outcome-card::before {
    content: '';
    position: absolute;
    inset: -40% 40% 40% -40%;
    background: radial-gradient(circle, rgba(244, 114, 182, 0.32), transparent 70%);
    opacity: 0.7;
    pointer-events: none;
  }

  .outcome-card__value {
    font-size: clamp(2rem, 1.8rem + 1.2vw, 2.8rem);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
  }

  .outcome-card__label {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--text-secondary), 0.7);
  }

  .outcome-card__detail {
    margin: 0;
    color: rgba(var(--text-secondary), 0.85);
    line-height: var(--leading-relaxed);
  }

  .solutions-section {
    position: relative;
    padding: clamp(5.5rem, 9vw, 7rem) 0;
  }

  .solutions-section::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: linear-gradient(140deg, rgba(6, 12, 32, 0.9) 0%, rgba(17, 26, 48, 0.8) 50%, rgba(35, 47, 78, 0.82) 100%);
    border: 1px solid rgba(244, 114, 182, 0.22);
    box-shadow: 0 30px 62px rgba(2, 6, 23, 0.58);
  }

  .solutions-section::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: radial-gradient(circle at 18% 32%, rgba(244, 114, 182, 0.28), transparent 65%),
      radial-gradient(circle at 82% 22%, rgba(56, 189, 248, 0.26), transparent 65%);
    pointer-events: none;
  }

  .solutions-section > .container {
    position: relative;
    z-index: 1;
  }

  .solutions-layout {
    display: grid;
    gap: clamp(2.5rem, 4vw, 3rem);
  }

  .solutions-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
  }

  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .solution-card {
    background: rgba(8, 12, 32, 0.78);
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(147, 51, 234, 0.32);
    padding: clamp(1.9rem, 3vw, 2.6rem);
    box-shadow: 0 22px 44px rgba(2, 6, 23, 0.5);
    display: grid;
    gap: 0.9rem;
    position: relative;
    overflow: hidden;
  }

  .solution-card::before {
    content: '';
    position: absolute;
    inset: -35% -40% 45% 30%;
    background: radial-gradient(circle, rgba(147, 51, 234, 0.28), transparent 70%);
    opacity: 0.6;
    pointer-events: none;
  }

  .solution-card__icon {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    background: rgba(56, 189, 248, 0.14);
    border: 1px solid rgba(56, 189, 248, 0.32);
    font-size: 1.5rem;
    color: var(--color-text-primary);
  }

  .solution-card h3 {
    margin: 0;
    font-size: clamp(1.3rem, 1.1rem + 0.4vw, 1.6rem);
    color: var(--color-text-primary);
  }

  .solution-card p {
    margin: 0;
    color: rgba(var(--text-secondary), 0.85);
  }

  .solution-card ul {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    list-style: none;
  }

  .solution-card li {
    position: relative;
    padding-left: 1.5rem;
    color: rgba(var(--text-secondary), 0.75);
    line-height: 1.5;
  }

  .solution-card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-secondary);
    box-shadow: 0 0 10px rgba(34, 211, 238, 0.6);
  }

  .features-section {
    position: relative;
    padding: clamp(5rem, 8vw, 6.5rem) 0;
  }

  .features-section::before,
  .features-section::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    pointer-events: none;
  }

  .features-section::before {
    background: linear-gradient(155deg, rgba(6, 12, 32, 0.85) 0%, rgba(17, 26, 48, 0.78) 60%, rgba(28, 36, 64, 0.8) 100%);
    border: 1px solid rgba(56, 189, 248, 0.18);
    box-shadow: 0 28px 60px rgba(2, 6, 23, 0.55);
  }

  .features-section::after {
    background: radial-gradient(circle at 20% 25%, rgba(147, 51, 234, 0.28), transparent 65%),
      radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.25), transparent 70%);
    opacity: 0.6;
  }

  .features-section > .container {
    position: relative;
    z-index: 1;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  .workflow-section {
    position: relative;
    padding: clamp(5.5rem, 9vw, 7rem) 0;
  }

  .workflow-section::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: linear-gradient(150deg, rgba(15, 23, 42, 0.85) 0%, rgba(6, 12, 32, 0.9) 60%, rgba(17, 26, 48, 0.86) 100%);
    border: 1px solid rgba(244, 114, 182, 0.25);
    box-shadow: 0 30px 60px rgba(2, 6, 23, 0.55);
  }

  .workflow-section::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: clamp(2rem, 3vw, 3rem);
    background: radial-gradient(circle at 30% 30%, rgba(244, 114, 182, 0.28), transparent 70%),
      radial-gradient(circle at 70% 65%, rgba(56, 189, 248, 0.22), transparent 65%);
    pointer-events: none;
    opacity: 0.7;
  }

  .workflow-section > .container {
    position: relative;
    z-index: 1;
  }

  .workflow-timeline {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.5rem, 3vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .workflow-step {
    background: rgba(8, 12, 32, 0.78);
    border-radius: var(--radius-2xl);
    border: 1px solid rgba(56, 189, 248, 0.24);
    padding: clamp(1.9rem, 3vw, 2.6rem);
    box-shadow: 0 22px 44px rgba(2, 6, 23, 0.48);
    display: grid;
    gap: 0.85rem;
    position: relative;
    overflow: hidden;
  }

  .workflow-step::before {
    content: '';
    position: absolute;
    inset: -30% 30% 40% -30%;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.3), transparent 70%);
    opacity: 0.6;
    pointer-events: none;
  }

  .step-badge {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 0.9rem;
