---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildWhatsappLink } from '../consts';

const heroWhatsappLink = buildWhatsappLink('Halo, saya butuh konsultasi website');
---

<MarketingLayout title="Jasa Website Astro + Portal Klien" description="Bangun situs pemasaran, portofolio, blog, dan portal klien terpadu dengan arsitektur Astro yang cepat dan aman.">
        <section class="hero" data-animate>
                <div class="hero-content">
                        <span class="eyebrow">Digital sprint terpadu</span>
                        <h1>Bangun pengalaman digital futuristik yang tetap mudah dioperasikan.</h1>
                        <p class="lead">
                                Kami menyatukan marketing site, knowledge base, dan portal klien dalam satu sprint terarah—mengemas Astro, Supabase, dan pembayaran lokal menjadi solusi yang ramah tim dan cepat scale.
                        </p>
                        <div class="hero-actions">
                                <a class="btn primary" href={heroWhatsappLink} target="_blank" rel="noreferrer">
                                        Konsultasi via WhatsApp
                                </a>
                                <a class="btn ghost" href="/layanan">Lihat Paket Layanan</a>
                        </div>
                        <ul class="hero-benefits">
                                <li>
                                        <strong>Blueprint terverifikasi</strong>
                                        <span>SSR portal + SSG marketing dengan guard RBAC, siap multi tenant.</span>
                                </li>
                                <li>
                                        <strong>Automasi operasional</strong>
                                        <span>Midtrans Snap, notifikasi lintas kanal, dan runbook insiden siap pakai.</span>
                                </li>
                                <li>
                                        <strong>Kolaborasi efisien</strong>
                                        <span>CI/CD Cloudflare, content collections MDX, dan kontrol akses granular.</span>
                                </li>
                        </ul>
                </div>
                <aside class="hero-summary">
                        <div class="hero-summary__glow" aria-hidden="true"></div>
                        <h2>Peta perjalanan</h2>
                        <dl>
                                <div>
                                        <dt>Discovery &amp; scope</dt>
                                        <dd>Model KPI, journey pengguna, arsitektur informasi.</dd>
                                </div>
                                <div>
                                        <dt>Desain &amp; validasi</dt>
                                        <dd>Design system futuristik, prototipe aksesibel, copy terpandu.</dd>
                                </div>
                                <div>
                                        <dt>Integrasi inti</dt>
                                        <dd>Supabase RLS, pembayaran locale, analitik consent-first.</dd>
                                </div>
                                <div>
                                        <dt>Go-live &amp; optimasi</dt>
                                        <dd>Deploy Cloudflare, observability, dan sesi enablement tim.</dd>
                                </div>
                        </dl>
                </aside>
        </section>

        <section class="value-grid" data-animate>
                <h2>Mengapa bermitra dengan kami</h2>
                <div class="grid">
                        <article>
                                <span class="icon">⚙️</span>
                                <h3>Arsitektur modular</h3>
                                <p>Komponen terstruktur membuat fitur baru dan iterasi UI tetap gesit.</p>
                        </article>
                        <article>
                                <span class="icon">🛰️</span>
                                <h3>Pengalaman masa depan</h3>
                                <p>Transisi lembut, tipografi terang, dan respons cepat menjaga fokus pengguna.</p>
                        </article>
                        <article>
                                <span class="icon">🤝</span>
                                <h3>Operasional ramah tim</h3>
                                <p>Runbook, checklist QA, dan integrasi otomatis meminimalkan beban support.</p>
                        </article>
                </div>
        </section>

        <section class="process" data-animate>
                <h2>Peta kolaborasi empat fase</h2>
                <ol>
                        <li>
                                <div class="step-badge">01</div>
                                <h3>Discovery</h3>
                                <p>Audit journey, segmentasi persona, dan definisi KPI.</p>
                        </li>
                        <li>
                                <div class="step-badge">02</div>
                                <h3>Desain &amp; prototipe</h3>
                                <p>Visual futuristik yang tetap mudah dibaca serta aksesibilitas WCAG.</p>
                        </li>
                        <li>
                                <div class="step-badge">03</div>
                                <h3>Integrasi teknis</h3>
                                <p>Supabase, pembayaran, dan notifikasi terpadu lintas kanal.</p>
                        </li>
                        <li>
                                <div class="step-badge">04</div>
                                <h3>Go-live</h3>
                                <p>Deploy Cloudflare, observability, dan sesi enablement tim.</p>
                        </li>
                </ol>
        </section>

        <section class="cta-banner" data-animate>
                <div class="cta-content">
                        <h2>Siap melesat menuju pengalaman digital baru?</h2>
                        <p>Kami bantu rangkai demo, timeline, dan roadmap peningkatan layanan Anda.</p>
                </div>
                <a class="btn primary" href="/kontak">Jadwalkan Demo</a>
        </section>
</MarketingLayout>

<style>
        .hero {
                position: relative;
                display: grid;
                gap: clamp(2rem, 6vw, 3.5rem);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                padding: clamp(3rem, 6vw, 5rem);
                background: rgba(18, 24, 40, 0.78);
                border: 1px solid rgba(110, 132, 182, 0.18);
                border-radius: clamp(2.2rem, 6vw, 3rem);
                box-shadow: 0 20px 44px rgba(12, 18, 36, 0.3);
                overflow: hidden;
        }

        .hero::before {
                content: "";
                position: absolute;
                inset: -30% 40% auto auto;
                width: 420px;
                height: 420px;
                background: radial-gradient(circle, rgba(100, 193, 255, 0.18), transparent 70%);
                filter: blur(14px);
                opacity: 0.7;
        }

        .hero-content {
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
                position: relative;
                z-index: 1;
        }

        .eyebrow {
                text-transform: uppercase;
                letter-spacing: 0.32em;
                color: rgba(255, 255, 255, 0.68);
                font-weight: 600;
                font-size: 0.78rem;
        }

        .lead {
                font-size: clamp(1.05rem, 2.1vw, 1.25rem);
                margin: 0;
                color: rgb(var(--text-secondary));
                max-width: 52ch;
        }

        .hero-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 1rem;
        }

        .hero-benefits {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 0.85rem;
        }

        .hero-benefits li {
                display: grid;
                gap: 0.3rem;
                background: rgba(15, 21, 35, 0.82);
                border: 1px solid rgba(110, 132, 182, 0.2);
                border-radius: 1.1rem;
                padding: 0.9rem 1.1rem;
        }

        .hero-benefits strong {
                color: rgb(var(--text-primary));
        }

        .hero-benefits span {
                color: rgb(var(--text-muted));
                font-size: 0.95rem;
        }

        .hero-summary {
                position: relative;
                background: rgba(14, 20, 36, 0.82);
                border: 1px solid rgba(110, 132, 182, 0.2);
                border-radius: clamp(1.8rem, 5vw, 2.2rem);
                padding: clamp(1.9rem, 4vw, 2.4rem);
                box-shadow: 0 18px 38px rgba(12, 18, 36, 0.28);
                display: grid;
                gap: 1.1rem;
        }

        .hero-summary__glow {
                position: absolute;
                inset: -25% -10% auto auto;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(100, 193, 255, 0.18), transparent 70%);
                filter: blur(14px);
                opacity: 0.65;
        }

        .hero-summary h2 {
                margin: 0;
                font-size: 1.05rem;
                color: rgb(var(--text-primary));
        }

        .hero-summary dl {
                margin: 0;
                padding: 0;
                display: grid;
                gap: 1rem;
        }

        .hero-summary dt {
                font-weight: 600;
                color: rgb(var(--text-primary));
        }

        .hero-summary dd {
                margin: 0.3rem 0 0;
                color: rgb(var(--text-muted));
        }

        .value-grid {
                margin-top: clamp(4rem, 8vw, 6rem);
                text-align: center;
        }

        .value-grid .grid {
                margin-top: clamp(1.5rem, 4vw, 2.5rem);
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .value-grid article {
                position: relative;
                background: rgba(17, 23, 40, 0.82);
                border-radius: clamp(1.5rem, 4vw, 1.9rem);
                padding: clamp(1.8rem, 4vw, 2.3rem);
                border: 1px solid rgba(110, 132, 182, 0.18);
                box-shadow: 0 14px 32px rgba(12, 18, 36, 0.24);
                display: grid;
                gap: 0.75rem;
        }

        .value-grid .icon {
                font-size: 1.6rem;
        }

        .process {
                margin-top: clamp(4rem, 8vw, 6rem);
        }

        .process ol {
                display: grid;
                gap: clamp(1.2rem, 3vw, 1.8rem);
                counter-reset: steps;
                grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
                padding-left: 0;
                list-style: none;
        }

        .process li {
                background: rgba(17, 23, 40, 0.8);
                border-radius: clamp(1.6rem, 4vw, 1.9rem);
                padding: clamp(1.8rem, 4vw, 2.2rem);
                border: 1px solid rgba(110, 132, 182, 0.18);
                box-shadow: 0 14px 28px rgba(12, 18, 36, 0.24);
                position: relative;
                display: grid;
                gap: 0.65rem;
        }

        .step-badge {
                width: 2.25rem;
                height: 2.25rem;
                border-radius: 0.75rem;
                background: rgba(100, 193, 255, 0.16);
                color: rgb(var(--text-primary));
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 600;
                font-size: 0.9rem;
        }

        .cta-banner {
                margin-top: clamp(4.5rem, 9vw, 7rem);
                background: rgba(13, 19, 34, 0.85);
                border-radius: clamp(1.8rem, 5vw, 2.2rem);
                padding: clamp(2.5rem, 6vw, 3.5rem);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: clamp(1.5rem, 4vw, 2.5rem);
                flex-wrap: wrap;
                border: 1px solid rgba(110, 132, 182, 0.2);
                box-shadow: 0 16px 34px rgba(12, 18, 36, 0.26);
        }

        .cta-banner h2 {
                color: rgb(var(--text-primary));
        }

        [data-animate] {
                animation: floatFade 720ms var(--transition-smooth) both;
        }

        [data-animate]:nth-of-type(2) {
                animation-delay: 120ms;
        }

        [data-animate]:nth-of-type(3) {
                animation-delay: 220ms;
        }

        [data-animate]:nth-of-type(4) {
                animation-delay: 320ms;
        }

        @keyframes floatFade {
                0% {
                        opacity: 0;
                        transform: translateY(22px) scale(0.98);
                }
                100% {
                        opacity: 1;
                        transform: translateY(0) scale(1);
                }
        }

        @media (max-width: 900px) {
                .hero {
                        grid-template-columns: 1fr;
                        padding: clamp(2.5rem, 6vw, 3.2rem);
                }

                .hero-summary {
                        order: -1;
                }
        }

        @media (max-width: 720px) {
                .cta-banner {
                        text-align: center;
                        justify-content: center;
                }
        }
</style>
