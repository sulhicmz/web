<style>
        /* ==========================================================================
           AstroPro Digital - Homepage Styles
           Modern marketing site dengan komponen terbaru
           ========================================================================== */

        /* Container utility */
        .container {
                max-width: 1400px;
                margin: 0 auto;
                padding: 0 var(--space-6);
        }

        /* Section Headers */
        .section-header {
                text-align: center;
                margin-bottom: var(--space-16);
        }

        .section-header h2 {
                font-size: var(--text-3xl);
                font-weight: var(--font-bold);
                margin-bottom: var(--space-4);
                background: var(--gradient-primary);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
        }

        .section-subtitle {
                font-size: var(--text-lg);
                color: var(--color-text-secondary);
                margin: 0;
                max-width: 600px;
                margin-left: auto;
                margin-right: auto;
        }

        /* Features Section */
        .features-section {
                padding: var(--space-20) 0;
                background: rgba(15, 23, 42, 0.5);
        }

        .features-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
                gap: var(--space-8);
        }

        /* Testimonials Section */
        .testimonials-section {
                padding: var(--space-20) 0;
                background: var(--gradient-surface);
                position: relative;
        }

        .testimonials-section::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: radial-gradient(circle at 30% 50%, rgba(124, 58, 237, 0.1) 0%, transparent 50%);
                pointer-events: none;
        }

        .testimonials-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
                gap: var(--space-8);
                position: relative;
                z-index: 1;
        }

        /* CTA Section */
        .cta-section {
                padding: var(--space-20) 0;
                background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%);
                border-top: 1px solid rgba(124, 58, 237, 0.2);
        }

        .cta-content {
                text-align: center;
                max-width: 800px;
                margin: 0 auto;
        }

        .cta-content h2 {
                font-size: var(--text-3xl);
                font-weight: var(--font-bold);
                margin-bottom: var(--space-4);
                color: var(--color-text-primary);
        }

        .cta-description {
                font-size: var(--text-lg);
                color: var(--color-text-secondary);
                margin-bottom: var(--space-8);
                line-height: var(--leading-relaxed);
        }

        .cta-actions {
                display: flex;
                gap: var(--space-4);
                justify-content: center;
                align-items: center;
                margin-bottom: var(--space-8);
                flex-wrap: wrap;
        }

        .btn {
                display: inline-flex;
                align-items: center;
                gap: var(--space-2);
                padding: var(--space-4) var(--space-8);
                border-radius: var(--radius-full);
                font-size: var(--text-lg);
                font-weight: var(--font-semibold);
                text-decoration: none;
                transition: all var(--transition-base);
                position: relative;
                overflow: hidden;
        }

        .btn--cta-primary {
                background: var(--gradient-primary);
                color: white;
                box-shadow: var(--shadow-gradient);
        }

        .btn--cta-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 30px rgba(124, 58, 237, 0.4);
                background: linear-gradient(135deg, #6D28D9 0%, #1E40AF 100%);
        }

        .btn--cta-secondary {
                background: rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(10px);
                color: white;
                border: 1px solid rgba(255, 255, 255, 0.3);
        }

        .btn--cta-secondary:hover {
                background: rgba(255, 255, 255, 0.2);
                border-color: rgba(255, 255, 255, 0.5);
        }

        .cta-features {
                display: flex;
                justify-content: center;
                gap: var(--space-8);
                flex-wrap: wrap;
        }

        .cta-feature {
                display: flex;
                align-items: center;
                gap: var(--space-2);
                font-size: var(--text-sm);
                color: var(--color-text-secondary);
        }

        .cta-feature__icon {
                font-size: 1.25rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
                .features-section,
                .testimonials-section,
                .cta-section {
                        padding: var(--space-16) 0;
                }

                .features-grid,
                .testimonials-grid {
                        grid-template-columns: 1fr;
                        gap: var(--space-6);
                }

                .section-header {
                        margin-bottom: var(--space-12);
                }

                .section-header h2 {
                        font-size: var(--text-2xl);
                }

                .cta-actions {
                        flex-direction: column;
                        gap: var(--space-3);
                }

                .btn {
                        width: 100%;
                        max-width: 280px;
                        justify-content: center;
                }

                .cta-features {
                        gap: var(--space-4);
                        flex-direction: column;
                        align-items: center;
                }
        }

        @media (max-width: 480px) {
                .container {
                        padding: 0 var(--space-4);
                }

                .cta-content h2 {
                        font-size: var(--text-2xl);
                }

                .cta-description {
                        font-size: var(--text-base);
                }
        }

        /* Reduced Motion Support */
        @media (prefers-reduced-motion: reduce) {
                .btn {
                        transition: none;
                }

                .btn:hover {
                        transform: none;
                }
        }

        /* High Contrast Mode */
        @media (prefers-contrast: high) {
                .btn--cta-primary,
                .btn--cta-secondary {
                        border-width: 2px;
                }

                .cta-features {
                        gap: var(--space-6);
                }
        }

        /* Focus Styles for Accessibility */
        .btn:focus-visible {
                outline: 2px solid rgba(255, 255, 255, 0.8);
                outline-offset: 2px;
        }

