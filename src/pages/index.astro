---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildWhatsappLink } from '../consts';

const heroWhatsappLink = buildWhatsappLink('Halo, saya butuh konsultasi website');
---

<MarketingLayout title="Jasa Website Astro + Portal Klien" description="Bangun situs pemasaran, portofolio, blog, dan portal klien terpadu dengan arsitektur Astro yang cepat dan aman.">
        <section class="hero">
                <p class="eyebrow">Website + Portal Klien dalam Satu Sprint</p>
                <h1>Saatnya menghadirkan pengalaman digital premium untuk tim dan klien Anda.</h1>
                <p class="lead">
                        Kami membantu bisnis B2B dan agensi meluncurkan situs pemasaran, knowledge base, dan portal klien yang terintegrasi penuh dengan Supabase, pembayaran lokal, serta otomatisasi operasional.
                </p>
                <div class="hero-actions">
                        <a class="btn primary" href={heroWhatsappLink} target="_blank" rel="noreferrer">
                                Konsultasi via WhatsApp
                        </a>
                        <a class="btn ghost" href="/layanan">Lihat Paket Layanan</a>
                </div>
        </section>

        <section class="value-grid">
                <h2>Mengapa memilih kami</h2>
                <div class="grid">
                        <article>
                                <h3>Arsitektur Cepat &amp; Aman</h3>
                                <p>Astro Islands, optimasi SEO, serta proteksi Cloudflare memastikan performa dan keamanan kelas enterprise.</p>
                        </article>
                        <article>
                                <h3>Portal Klien Siap Pakai</h3>
                                <p>Monitoring proyek, pembayaran, knowledge base privat, dan dukungan terpadu dalam satu dashboard.</p>
                        </article>
                        <article>
                                <h3>Automasi Operasional</h3>
                                <p>Integrasi Supabase, pembayaran lokal, WhatsApp, dan analitik ringan yang patuh privasi.</p>
                        </article>
                </div>
        </section>

        <section class="process">
                <h2>Proses kolaborasi 4 langkah</h2>
                <ol>
                        <li>
                                <h3>Discovery &amp; Scope</h3>
                                <p>Workshop kebutuhan, definisi KPI, dan mapping konten awal.</p>
                        </li>
                        <li>
                                <h3>Desain &amp; Implementasi</h3>
                                <p>Setup design system, struktur konten, dan komponen utama.</p>
                        </li>
                        <li>
                                <h3>Integrasi &amp; Automasi</h3>
                                <p>Konfigurasi Supabase, pembayaran, notifikasi WhatsApp, dan analitik.</p>
                        </li>
                        <li>
                                <h3>Go-Live &amp; Operasional</h3>
                                <p>CI/CD GitHub → Cloudflare, training tim, serta monitoring berkelanjutan.</p>
                        </li>
                </ol>
        </section>

        <section class="cta-banner">
                <div>
                        <h2>Siap tingkatkan layanan digital Anda?</h2>
                        <p>Jadwalkan sesi strategi 30 menit untuk melihat demo portal dan roadmap implementasi.</p>
                </div>
                <a class="btn primary" href="/kontak">Jadwalkan Demo</a>
        </section>
</MarketingLayout>

<style>
        .hero {
                display: grid;
                gap: 1.5rem;
                text-align: center;
        }

        .eyebrow {
                text-transform: uppercase;
                letter-spacing: 0.2em;
                color: rgb(var(--accent));
                font-weight: 600;
        }

        .lead {
                font-size: 1.15rem;
                margin: 0 auto;
                max-width: 720px;
        }

        .hero-actions {
                display: flex;
                gap: 1rem;
                justify-content: center;
                flex-wrap: wrap;
        }

        .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.75rem 1.5rem;
                border-radius: 999px;
                font-weight: 600;
                text-decoration: none;
                transition: background 0.2s ease;
        }

        .btn.primary {
                background: var(--accent);
                color: #fff;
        }

        .btn.primary:hover,
        .btn.primary:focus-visible {
                background: var(--accent-dark);
        }

        .btn.ghost {
                border: 1px solid rgba(var(--gray), 0.4);
                color: rgb(var(--black));
        }

        .btn.ghost:hover,
        .btn.ghost:focus-visible {
                border-color: var(--accent);
                color: var(--accent);
        }

        .value-grid {
                margin-top: 5rem;
                text-align: center;
        }

        .value-grid .grid {
                margin-top: 2rem;
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        .value-grid article {
                background: #fff;
                border-radius: 1rem;
                padding: 2rem;
                box-shadow: 0 20px 40px rgba(15, 18, 25, 0.05);
        }

        .process {
                margin-top: 5rem;
        }

        .process ol {
                display: grid;
                gap: 1.5rem;
                counter-reset: steps;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                padding-left: 0;
                list-style: none;
        }

        .process li {
                background: #fff;
                border-radius: 1rem;
                padding: 2rem;
                position: relative;
                box-shadow: 0 20px 40px rgba(15, 18, 25, 0.05);
        }

        .process li::before {
                counter-increment: steps;
                content: counter(steps, decimal-leading-zero);
                position: absolute;
                top: 1rem;
                right: 1.5rem;
                font-weight: 700;
                color: rgba(var(--accent), 0.7);
        }

        .cta-banner {
                margin-top: 5rem;
                background: linear-gradient(135deg, var(--accent), var(--accent-dark));
                color: #fff;
                border-radius: 1.25rem;
                padding: 3rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 2rem;
                flex-wrap: wrap;
        }

        .cta-banner h2 {
                color: inherit;
        }

        @media (max-width: 720px) {
                .value-grid article,
                .process li {
                        text-align: left;
                }

                .cta-banner {
                        text-align: center;
                        justify-content: center;
                }
        }
</style>
