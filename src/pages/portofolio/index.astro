---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Portofolio & Studi Kasus" description="Lihat contoh implementasi website Astro dan portal klien yang kami bangun untuk berbagai industri.">
        <section class="intro">
                <h1>Portofolio terkurasi</h1>
                <p>Setiap proyek difokuskan pada hasil bisnis: peningkatan konversi, otomasi onboarding klien, dan efisiensi operasional.</p>
        </section>
        <section class="cases">
                <article>
                        <h2>FinServe Pro</h2>
                        <p>Portal onboarding nasabah B2B dengan SLA dukungan 24 jam dan dashboard status proyek.</p>
                        <a href="/portofolio/studi-kasus/finserve-pro">Baca studi kasus</a>
                </article>
                <article>
                        <h2>EduPlus Academy</h2>
                        <p>Situs pemasaran multi-bahasa, katalog kursus, dan portal alumni dengan pembayaran berulang.</p>
                        <a href="/portofolio/studi-kasus/eduplus-academy">Baca studi kasus</a>
                </article>
                <article>
                        <h2>CraftHub Studio</h2>
                        <p>E-commerce katalog produk custom dengan portal klien untuk approve desain dan memantau produksi.</p>
                        <a href="/portofolio/studi-kasus/crafthub-studio">Baca studi kasus</a>
                </article>
        </section>
</MarketingLayout>

<style>
        .intro {
                text-align: center;
                max-width: 760px;
                margin: 0 auto clamp(2.5rem, 6vw, 3.5rem);
        }

        .cases {
                display: grid;
                gap: clamp(1.35rem, 3.5vw, 2rem);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }

        article {
                background: rgba(17, 22, 36, 0.78);
                padding: clamp(1.85rem, 4vw, 2.4rem);
                border-radius: clamp(1.5rem, 4vw, 1.9rem);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.4);
                display: grid;
                gap: 1rem;
                border: 1px solid rgba(124, 133, 178, 0.18);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        article:hover,
        article:focus-within {
                transform: translateY(-5px);
                box-shadow: 0 0 38px rgba(124, 77, 255, 0.2);
        }

        a {
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
        }

        a::after {
                content: '→';
                transition: transform var(--transition-base);
        }

        a:hover::after,
        a:focus-visible::after {
                transform: translateX(4px);
        }
</style>
