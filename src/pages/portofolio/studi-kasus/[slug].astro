---
import MarketingLayout from '../../../layouts/MarketingLayout.astro';

const caseStudies = {
        'finserve-pro': {
                title: 'FinServe Pro',
                summary: 'Portal onboarding dan layanan purna jual untuk perusahaan jasa keuangan B2B.',
                results: [
                        'Waktu onboarding berkurang 45%',
                        'Kepuasan klien meningkat menjadi 4,8/5',
                        'Integrasi pembayaran otomatis untuk layanan retainer',
                ],
        },
        'eduplus-academy': {
                title: 'EduPlus Academy',
                summary: 'Platform edukasi digital dengan katalog kursus dan portal alumni.',
                results: [
                        'Peningkatan pendaftaran kursus 2,3x',
                        'Sistem langganan otomatis via Midtrans',
                        'Knowledge base privat untuk mentor',
                ],
        },
        'crafthub-studio': {
                title: 'CraftHub Studio',
                summary: 'Portal approval desain dan pelacakan produksi untuk brand merchandise.',
                results: [
                        'Siklus revisi berkurang 60%',
                        'Integrasi WhatsApp untuk notifikasi produksi',
                        'Dashboard status produksi real-time',
                ],
        },
} as const;

export function getStaticPaths() {
        return [
                { params: { slug: 'finserve-pro' } },
                { params: { slug: 'eduplus-academy' } },
                { params: { slug: 'crafthub-studio' } },
        ];
}

const { slug } = Astro.params;
const detail = caseStudies[slug as keyof typeof caseStudies];

if (!detail) {
        throw Astro.redirect('/portofolio');
}
---

<MarketingLayout title={`Studi Kasus ${detail.title}`} description={detail.summary}>
        <article class="case-detail">
                <h1>{detail.title}</h1>
                <p class="summary">{detail.summary}</p>
                <section>
                        <h2>Hasil Utama</h2>
                        <ul>
                                {detail.results.map((item) => (
                                        <li>{item}</li>
                                ))}
                        </ul>
                </section>
                <section>
                        <h2>Solusi</h2>
                        <p>
                                Kami mengimplementasikan arsitektur Astro hybrid untuk memadukan halaman pemasaran statis dengan portal klien SSR. Supabase menangani autentikasi, RLS, dan penyimpanan data proyek. Pagefind digunakan untuk pencarian cepat pada knowledge base dan dokumentasi onboarding.
                        </p>
                </section>
                <section>
                        <h2>Tumpukan Teknologi</h2>
                        <ul>
                                <li>Astro + islands interaktif (Solid/React)</li>
                                <li>Supabase Postgres, Auth, Storage</li>
                                <li>Midtrans / Xendit gateway pembayaran</li>
                                <li>Cloudflare Pages &amp; Functions</li>
                        </ul>
                </section>
        </article>
</MarketingLayout>

<style>
        .case-detail {
                background: rgba(17, 22, 36, 0.78);
                padding: clamp(2.5rem, 6vw, 3.5rem);
                border-radius: clamp(1.8rem, 5vw, 2.4rem);
                box-shadow: 0 0 48px rgba(12, 18, 36, 0.45);
                display: grid;
                gap: clamp(1.75rem, 4vw, 2.5rem);
                border: 1px solid rgba(124, 133, 178, 0.18);
        }

        .summary {
                font-size: clamp(1.05rem, 2.4vw, 1.3rem);
                color: rgb(var(--text-secondary));
        }

        section {
                background: rgba(21, 26, 40, 0.72);
                border-radius: 1.35rem;
                padding: clamp(1.6rem, 4vw, 2.1rem);
                border: 1px solid rgba(124, 133, 178, 0.16);
                box-shadow: inset 0 0 22px rgba(10, 14, 28, 0.5);
        }

        ul {
                margin: 0;
                padding-left: 1.5rem;
                display: grid;
                gap: 0.75rem;
        }

        @media (max-width: 720px) {
                .case-detail {
                        padding: 2rem;
                }

                section {
                        padding: 1.5rem;
                }
        }
</style>
