---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import FormInput from '../components/ui/FormInput.astro';
import Modal from '../components/ui/Modal.astro';
import Toast from '../components/ui/Toast.astro';

const showModal = false; // Untuk demo purposes
---

<MarketingLayout title="Login Portal - AstroPro Digital" description="Login ke portal klien untuk mengakses dashboard proyek, billing, dan support.">
  <main class="login-page">
    <div class="login-container">
      <!-- Login Form -->
      <div class="login-form-section">
        <div class="login-header">
          <h1>Selamat Datang Kembali</h1>
          <p class="login-subtitle">Masuk ke portal klien untuk mengelola proyek dan billing Anda</p>
        </div>

        <form id="login-form" class="login-form">
          <FormInput
            label="Email Address"
            type="email"
            id="email"
            name="email"
            icon="email"
            placeholder="nama@perusahaan.com"
            required
            fullWidth
          />

          <FormInput
            label="Password"
            type="password"
            id="password"
            name="password"
            icon="password"
            placeholder="Masukkan password Anda"
            required
            fullWidth
          />

          <div class="form-options">
            <label class="checkbox-label">
              <input type="checkbox" name="remember" id="remember" />
              <span class="checkbox-custom"></span>
              <span class="checkbox-text">Ingat saya</span>
            </label>

            <a href="/forgot-password" class="forgot-link">Lupa password?</a>
          </div>

          <button type="submit" class="btn btn--login-primary">
            <span class="btn-text">Masuk ke Portal</span>
            <span class="btn-icon" aria-hidden="true">→</span>
          </button>
        </form>

        <div class="login-divider">
          <span>atau</span>
        </div>

        <div class="login-alternatives">
          <button type="button" class="btn btn--login-secondary">
            <span aria-hidden="true">🌐</span>
            Lanjutkan dengan Google
          </button>

          <button type="button" class="btn btn--login-secondary">
            <span aria-hidden="true">💼</span>
            Lanjutkan dengan Microsoft
          </button>
        </div>

        <div class="login-footer">
          <p>Belum memiliki akun? <a href="/register" class="register-link">Daftar sekarang</a></p>
        </div>
      </div>

      <!-- Features Preview -->
      <div class="login-features">
        <div class="features-preview">
          <h2>Yang Anda Dapat Akses</h2>

          <div class="feature-list">
            <div class="feature-item">
              <div class="feature-icon" aria-hidden="true">📊</div>
              <div class="feature-content">
                <h3>Dashboard Analytics</h3>
                <p>Monitor progress proyek dan metrics secara real-time</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon" aria-hidden="true">💳</div>
              <div class="feature-content">
                <h3>Billing Management</h3>
                <p>Kelola invoice dan pembayaran dengan mudah</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon" aria-hidden="true">🎫</div>
              <div class="feature-content">
                <h3>Support Tickets</h3>
                <p>Ajukan dan track tiket dukungan teknis</p>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-icon" aria-hidden="true">📚</div>
              <div class="feature-content">
                <h3>Knowledge Base</h3>
                <p>Akses dokumentasi dan panduan lengkap</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Demo Modal -->
    <Modal
      isOpen={showModal}
      title="Login Berhasil!"
      description="Selamat datang kembali ke portal klien"
      size="sm"
    >
      <p>Anda akan diarahkan ke dashboard dalam beberapa detik...</p>

      <div slot="footer" class="modal-actions">
        <button class="btn btn--primary">Lanjut ke Dashboard</button>
      </div>
    </Modal>

    <!-- Demo Toast -->
    <Toast
      type="success"
      title="Login Berhasil"
      message="Selamat datang kembali! Anda telah masuk ke portal klien."
      position="top-right"
      duration={3000}
      isVisible={false}
    />
  </main>
</MarketingLayout>

<style>
  .login-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6);
  }

  .login-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    max-width: 1200px;
    width: 100%;
    align-items: center;
  }

  /* Login Form Section */
  .login-form-section {
    background: var(--gradient-surface);
    backdrop-filter: blur(20px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-12);
    box-shadow: var(--shadow-2xl);
  }

  .login-header {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .login-header h1 {
    font-size: var(--text-3xl);
    font-weight: var(--font-bold);
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-3);
  }

  .login-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .checkbox-custom {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    position: relative;
    transition: all var(--transition-base);
  }

  .checkbox-label input[type="checkbox"]:checked + .checkbox-custom {
    background: var(--gradient-primary);
    border-color: var(--color-primary);
  }

  .checkbox-label input[type="checkbox"]:checked + .checkbox-custom::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: white;
    font-size: 0.75rem;
    font-weight: bold;
  }

  .forgot-link {
    color: var(--color-primary);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--transition-base);
  }

  .forgot-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-full);
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .btn--login-primary {
    background: var(--gradient-primary);
    color: white;
    box-shadow: var(--shadow-gradient);
  }

  .btn--login-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(124, 58, 237, 0.4);
    background: linear-gradient(135deg, #6D28D9 0%, #1E40AF 100%);
  }

  .btn--login-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border);
    backdrop-filter: blur(10px);
  }

  .btn--login-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }

  .btn-icon {
    transition: transform var(--transition-base);
  }

  .btn:hover .btn-icon {
    transform: translateX(4px);
  }

  .login-divider {
    text-align: center;
    margin: var(--space-6) 0;
    position: relative;
  }

  .login-divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-border);
  }

  .login-divider span {
    background: var(--gradient-surface);
    padding: 0 var(--space-4);
    color: var(--color-text-secondary);
    position: relative;
    z-index: 1;
  }

  .login-alternatives {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .login-footer {
    text-align: center;
  }

  .login-footer p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .register-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: var(--font-semibold);
    transition: color var(--transition-base);
  }

  .register-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Features Section */
  .login-features {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .features-preview {
    text-align: center;
    max-width: 500px;
  }

  .features-preview h2 {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    text-align: left;
    padding: var(--space-4);
    background: rgba(255, 255, 255, 0.02);
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: all var(--transition-base);
  }

  .feature-item:hover {
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }

  .feature-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .feature-content h3 {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-1) 0;
  }

  .feature-content p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  /* Modal Actions */
  .modal-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: flex-end;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .login-page {
      padding: var(--space-4);
    }

    .login-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .login-form-section {
      padding: var(--space-8);
    }

    .login-header h1 {
      font-size: var(--text-2xl);
    }

    .login-subtitle {
      font-size: var(--text-base);
    }

    .form-options {
      flex-direction: column;
      gap: var(--space-3);
      align-items: flex-start;
    }

    .login-alternatives {
      gap: var(--space-2);
    }

    .btn {
      width: 100%;
      font-size: var(--text-base);
    }

    .features-preview h2 {
      font-size: var(--text-xl);
    }

    .feature-list {
      gap: var(--space-4);
    }

    .feature-item {
      flex-direction: column;
      text-align: center;
      gap: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .login-form-section {
      padding: var(--space-6);
    }

    .login-header {
      margin-bottom: var(--space-6);
    }

    .login-form {
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }

    .btn:hover {
      transform: none;
    }

    .btn:hover .btn-icon {
      transform: none;
    }

    .feature-item {
      transition: none;
    }

    .feature-item:hover {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .login-form-section {
      border-width: 2px;
    }

    .checkbox-custom {
      border-width: 3px;
    }
  }

  /* Focus Styles for Accessibility */
  .btn:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.8);
    outline-offset: 2px;
  }

  .checkbox-label:focus-within .checkbox-custom {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

  const form = document.getElementById('login-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    try {
      const { error } = await supabase.auth.signInWithPassword({
        email,
        password
      });

      if (error) {
        // Show error toast
        showToast('error', 'Login Gagal', error.message);
      } else {
        // Show success toast and redirect
        showToast('success', 'Login Berhasil', 'Selamat datang kembali!');
        setTimeout(() => {
          window.location.href = '/portal/dashboard';
        }, 1500);
      }
    } catch (err) {
      showToast('error', 'Terjadi Kesalahan', 'Silakan coba lagi nanti');
    }
  });

  // Toast helper function
  function showToast(type: string, title: string, message: string) {
    // Create toast element dynamically
    const toast = document.createElement('div');
    toast.className = `toast toast--${type} toast--visible`;
    toast.innerHTML = `
      <div class="toast__icon">${getIcon(type)}</div>
      <div class="toast__content">
        <div class="toast__title">${title}</div>
        <div class="toast__message">${message}</div>
      </div>
      <button class="toast__close" onclick="this.parentElement.remove()">×</button>
    `;

    document.body.appendChild(toast);

    // Auto remove after 5 seconds
    setTimeout(() => {
      toast.remove();
    }, 5000);
  }

  function getIcon(type: string): string {
    const icons: Record<string, string> = {
      success: '✅',
      error: '❌',
      warning: '⚠️',
      info: 'ℹ️'
    };
    return icons[type] || icons.info;
  }
</script>
