---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Tentang AstroPro Digital" description="Tim multidisiplin yang membantu bisnis B2B membangun website Astro dan portal klien terpadu.">
        <section class="about">
                <h1>Siapa Kami</h1>
                <p>AstroPro Digital adalah tim strategis, desainer, dan engineer yang berfokus menghadirkan pengalaman digital premium melalui pendekatan data dan otomatisasi.</p>
                <div class="pillars">
                        <article>
                                <h2>Strategi &amp; Operasi</h2>
                                <p>Memastikan value proposition jelas, alur portal efisien, dan KPI bisnis tercapai.</p>
                        </article>
                        <article>
                                <h2>Desain &amp; Pengalaman</h2>
                                <p>Design system terpadu, aksesibilitas WCAG 2.2 AA, dan copywriting konversi tinggi.</p>
                        </article>
                        <article>
                                <h2>Teknologi &amp; Keamanan</h2>
                                <p>Astro, Supabase, Cloudflare, serta praktik keamanan terstandarisasi untuk skala enterprise.</p>
                        </article>
                </div>
        </section>
</MarketingLayout>

<style>
        .about {
                display: grid;
                gap: 2rem;
        }

        .pillars {
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        article {
                background: #fff;
                padding: 1.5rem;
                border-radius: 1rem;
                box-shadow: 0 12px 32px rgba(15, 18, 25, 0.06);
        }
</style>
