---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Testimonial Klien" description="Cerita nyata dari klien yang berhasil mengotomasi layanan digital mereka.">
        <section class="intro">
                <h1>Apa kata klien kami</h1>
                <p>Feedback terkurasi dari berbagai industri yang merasakan dampak platform terpadu kami.</p>
        </section>
        <section class="testimonials">
                <article>
                        <p class="quote">“Dalam 6 minggu kami sudah live dengan portal klien lengkap. Tim support sekarang bisa fokus pada issue strategis.”</p>
                        <p class="author">Nadia, COO FinServe Pro</p>
                </article>
                <article>
                        <p class="quote">“Integrasi pembayaran otomatis membuat cashflow bulanan lebih stabil dan mengurangi follow-up manual.”</p>
                        <p class="author">Randy, Founder CraftHub Studio</p>
                </article>
                <article>
                        <p class="quote">“Knowledge base privat membantu tim akademi kami menjawab pertanyaan berulang hanya dengan satu tautan.”</p>
                        <p class="author">Sarah, Academic Director EduPlus</p>
                </article>
        </section>
</MarketingLayout>

<style>
        .intro {
                text-align: center;
                max-width: 720px;
                margin: 0 auto clamp(2.5rem, 6vw, 3.5rem);
        }

        .testimonials {
                display: grid;
                gap: clamp(1.35rem, 3.5vw, 1.85rem);
        }

        article {
                background: rgba(17, 22, 36, 0.78);
                padding: clamp(1.85rem, 4vw, 2.4rem);
                border-radius: clamp(1.5rem, 4vw, 1.85rem);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.4);
                border: 1px solid rgba(124, 133, 178, 0.18);
                position: relative;
                overflow: hidden;
        }

        article::before {
                content: "";
                position: absolute;
                inset: auto -20% -50% auto;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.22), transparent 70%);
                filter: blur(12px);
                opacity: 0.75;
        }

        .quote {
                font-style: italic;
                font-size: clamp(1.05rem, 2.2vw, 1.25rem);
                position: relative;
        }

        .author {
                margin-top: 1rem;
                font-weight: 600;
                color: rgba(196, 203, 240, 0.8);
        }
</style>
