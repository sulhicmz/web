---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MarketingLayout title="Blog & Insight" description="Artikel strategi digital, panduan Astro, dan pembaruan produk {SITE_TITLE}.">
        <section class="blog-intro">
                <h1>Insight Terbaru</h1>
                <p>Pelajari praktik terbaik membangun website berperforma tinggi, portal klien modern, dan otomasi layanan.</p>
        </section>
        <section class="post-grid">
                {posts.map((post) => (
                        <article>
                                <a href={`/blog/${post.id}/`}>
                                        {post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" width="720" height="360" />}
                                        <h2>{post.data.title}</h2>
                                        <p class="date"><FormattedDate date={post.data.pubDate} /></p>
                                        <p class="excerpt">{post.data.description}</p>
                                </a>
                        </article>
                ))}
        </section>
</MarketingLayout>

<style>
        .blog-intro {
                text-align: center;
                max-width: 720px;
                margin: 0 auto 3rem;
        }

        .post-grid {
                display: grid;
                gap: 2rem;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        article {
                background: #fff;
                border-radius: 1rem;
                overflow: hidden;
                box-shadow: 0 18px 36px rgba(15, 18, 25, 0.08);
        }

        article a {
                color: inherit;
                text-decoration: none;
                display: grid;
                gap: 1rem;
                padding: 1.5rem;
        }

        .date {
                font-weight: 600;
                color: rgba(var(--gray), 0.9);
        }

        img {
                width: 100%;
                height: auto;
                object-fit: cover;
        }
</style>
