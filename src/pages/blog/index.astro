---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/ui/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MarketingLayout title="Blog & Insight" description="Artikel strategi digital, panduan Astro, dan pembaruan produk {SITE_TITLE}.">
        <section class="blog-intro">
                <h1>Insight Terbaru</h1>
                <p>Pelajari praktik terbaik membangun website berperforma tinggi, portal klien modern, dan otomasi layanan.</p>
        </section>
        <section class="post-grid">
                {posts.map((post) => (
                        <article>
                                <a href={`/blog/${post.id}/`}>
                                        {post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" width="720" height="360" />}
                                        <h2>{post.data.title}</h2>
                                        <p class="date"><FormattedDate date={post.data.pubDate} /></p>
                                        <p class="excerpt">{post.data.description}</p>
                                </a>
                        </article>
                ))}
        </section>
</MarketingLayout>

<style>
        .blog-intro {
                text-align: center;
                max-width: 760px;
                margin: 0 auto clamp(2.5rem, 6vw, 3.5rem);
        }

        .post-grid {
                display: grid;
                gap: clamp(1.5rem, 4vw, 2.25rem);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }

        article {
                background: rgba(17, 22, 36, 0.82);
                border-radius: clamp(1.4rem, 4vw, 1.75rem);
                overflow: hidden;
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.4);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        article:hover,
        article:focus-within {
                transform: translateY(-6px);
                box-shadow: 0 0 42px rgba(124, 77, 255, 0.2);
        }

        article a {
                color: inherit;
                text-decoration: none;
                display: grid;
                gap: 1.1rem;
                padding: clamp(1.5rem, 4vw, 2rem);
        }

        .date {
                font-weight: 600;
                color: rgba(198, 204, 238, 0.65);
        }

        img {
                width: 100%;
                height: auto;
                object-fit: cover;
        }
</style>
