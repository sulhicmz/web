---
import PortalLayout from '../../../../layouts/PortalLayout.astro';
export const prerender = false;

const { ticketId } = Astro.params;
---

<PortalLayout title={`Detail Tiket ${ticketId}`} description="Lihat percakapan, lampiran, dan SLA.">
        <h1>Tiket {ticketId}</h1>
        <section class="meta">
                <p><strong>Status:</strong> In Progress</p>
                <p><strong>Prioritas:</strong> High</p>
                <p><strong>SLA:</strong> 8 jam (tersisa 2 jam)</p>
        </section>
        <section class="thread">
                <article>
                        <h2>Timeline</h2>
                        <ol>
                                <li>08 Mei 2024 09:10 — Klien membuat tiket</li>
                                <li>08 Mei 2024 09:45 — Tim merespons awal</li>
                                <li>08 Mei 2024 10:15 — Permintaan log tambahan</li>
                        </ol>
                </article>
                <article>
                        <h2>Balasan Terbaru</h2>
                        <p>Tim dev mengulang webhook di sandbox dan membutuhkan akses log tambahan.</p>
                </article>
        </section>
</PortalLayout>

<style>
        .meta {
                display: flex;
                gap: 1.35rem;
                flex-wrap: wrap;
                margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                padding: clamp(1.25rem, 3vw, 1.75rem);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
        }

        .thread {
                display: grid;
                gap: clamp(1.25rem, 3vw, 1.75rem);
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        article {
                background: rgba(17, 22, 36, 0.8);
                padding: clamp(1.75rem, 4vw, 2.25rem);
                border-radius: 1.5rem;
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
        }

        ol {
                margin: 0;
                padding-left: 1.5rem;
                display: grid;
                gap: 0.6rem;
        }
</style>
