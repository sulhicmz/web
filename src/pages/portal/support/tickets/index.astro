---
import PortalLayout from '../../../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Tiket Dukungan" description="Lihat status tiket, SLA, dan ajukan permintaan baru.">
        <h1>Tiket Dukungan</h1>
        <table>
                <thead>
                        <tr>
                                <th>ID</th>
                                <th>Subjek</th>
                                <th>Prioritas</th>
                                <th>Status</th>
                                <th>Pembaruan Terakhir</th>
                        </tr>
                </thead>
                <tbody>
                        <tr>
                                <td>TCK-1021</td>
                                <td>Permintaan revisi landing page</td>
                                <td>Medium</td>
                                <td>In Progress</td>
                                <td>10 Mei 2024</td>
                        </tr>
                        <tr>
                                <td>TCK-1018</td>
                                <td>Payment webhook gagal</td>
                                <td>High</td>
                                <td>Waiting Client</td>
                                <td>08 Mei 2024</td>
                        </tr>
                </tbody>
        </table>
</PortalLayout>

<style>
        table {
                width: 100%;
                border-collapse: collapse;
                background: rgba(17, 22, 36, 0.88);
                border-radius: 1.35rem;
                overflow: hidden;
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.4), 0 0 28px rgba(124, 77, 255, 0.14);
        }

        th,
        td {
                padding: 1rem 1.25rem;
                border-bottom: 1px solid rgba(124, 133, 178, 0.12);
                text-align: left;
        }

        th {
                background: rgba(21, 26, 40, 0.72);
                color: rgb(var(--text-muted));
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-size: 0.75rem;
        }

        tbody tr:last-child td {
                border-bottom: none;
        }

        tbody tr:hover {
                background: rgba(124, 77, 255, 0.12);
        }
</style>
