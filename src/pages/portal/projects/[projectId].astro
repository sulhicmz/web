---
import PortalLayout from '../../../layouts/PortalLayout.astro';
export const prerender = false;

const { projectId } = Astro.params;
---

<PortalLayout title={`Detail Proyek ${projectId}`} description="Pantau milestone, checklist, dan deploy history.">
        <h1>Proyek: {projectId}</h1>
        <section class="grid">
                <article>
                        <h2>Milestone</h2>
                        <ul>
                                <li>Discovery selesai ✅</li>
                                <li>Desain high-fidelity (berjalan)</li>
                                <li>Integrasi pembayaran (antri)</li>
                        </ul>
                </article>
                <article>
                        <h2>Checklist Deploy</h2>
                        <ul>
                                <li>Domain siap</li>
                                <li>Pagefind index terbaru</li>
                                <li>Backup database terjadwal</li>
                        </ul>
                </article>
        </section>
        <section class="timeline">
                <h2>Riwayat Deploy</h2>
                <ol>
                        <li>2024-05-10 — Deploy staging v0.4</li>
                        <li>2024-05-03 — Deploy production v0.3</li>
                </ol>
        </section>
</PortalLayout>

<style>
        .grid {
                display: grid;
                gap: clamp(1.25rem, 3vw, 1.75rem);
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        }

        article {
                background: rgba(17, 22, 36, 0.8);
                padding: clamp(1.75rem, 4vw, 2.25rem);
                border-radius: 1.5rem;
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
        }

        ul {
                margin: 0;
                padding-left: 1.35rem;
                display: grid;
                gap: 0.6rem;
                color: rgb(var(--text-secondary));
        }

        .timeline {
                margin-top: clamp(1.75rem, 4vw, 2.5rem);
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                border: 1px solid rgba(124, 133, 178, 0.18);
                padding: clamp(1.75rem, 4vw, 2.25rem);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
        }

        .timeline ol {
                margin: 0;
                padding-left: 1.35rem;
                display: grid;
                gap: 0.6rem;
        }
</style>
