---
import PortalLayout from '../../../layouts/PortalLayout.astro';
export const prerender = false;

const { projectId } = Astro.params;
---

<PortalLayout title={`Detail Proyek ${projectId}`} description="Pantau milestone, checklist, dan deploy history.">
        <h1>Proyek: {projectId}</h1>
        <section class="grid">
                <article>
                        <h2>Milestone</h2>
                        <ul>
                                <li>Discovery selesai ✅</li>
                                <li>Desain high-fidelity (berjalan)</li>
                                <li>Integrasi pembayaran (antri)</li>
                        </ul>
                </article>
                <article>
                        <h2>Checklist Deploy</h2>
                        <ul>
                                <li>Domain siap</li>
                                <li>Pagefind index terbaru</li>
                                <li>Backup database terjadwal</li>
                        </ul>
                </article>
        </section>
        <section class="timeline">
                <h2>Riwayat Deploy</h2>
                <ol>
                        <li>2024-05-10 — Deploy staging v0.4</li>
                        <li>2024-05-03 — Deploy production v0.3</li>
                </ol>
        </section>
</PortalLayout>

<style>
        .grid {
                display: grid;
                gap: 1.5rem;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        article {
                background: #fff;
                padding: 1.5rem;
                border-radius: 1rem;
                box-shadow: 0 12px 32px rgba(15, 18, 25, 0.06);
        }

        ul {
                margin: 0;
                padding-left: 1.25rem;
                display: grid;
                gap: 0.5rem;
        }

        .timeline {
                margin-top: 2rem;
        }

        .timeline ol {
                margin: 0;
                padding-left: 1.5rem;
                display: grid;
                gap: 0.5rem;
        }
</style>
