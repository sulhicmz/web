---
import PortalLayout from '../../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Proyek Klien" description="Kelola daftar proyek, environment, dan timeline.">
        <h1>Proyek &amp; URL</h1>
        <table>
                <thead>
                        <tr>
                                <th>Nama Proyek</th>
                                <th>Status</th>
                                <th>Staging</th>
                                <th>Produksi</th>
                        </tr>
                </thead>
                <tbody>
                        <tr>
                                <td>Portal Onboarding</td>
                                <td>Dalam Pengembangan</td>
                                <td><a href="#">staging.domain.com</a></td>
                                <td><span class="muted">Belum tersedia</span></td>
                        </tr>
                        <tr>
                                <td>Situs Marketing</td>
                                <td>Live</td>
                                <td><a href="#">preview.domain.com</a></td>
                                <td><a href="#">domain.com</a></td>
                        </tr>
                </tbody>
        </table>
</PortalLayout>

<style>
        table {
                width: 100%;
                border-collapse: collapse;
                background: rgba(17, 22, 36, 0.88);
                border-radius: 1.35rem;
                overflow: hidden;
                border: 1px solid rgba(108, 126, 171, 0.2);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.38), 0 0 24px rgba(34, 156, 235, 0.16);
        }

        th,
        td {
                padding: 1rem 1.25rem;
                border-bottom: 1px solid rgba(124, 133, 178, 0.12);
                text-align: left;
        }

        th {
                background: rgba(21, 26, 40, 0.72);
                color: rgb(var(--text-muted));
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-size: 0.75rem;
        }

        tbody tr:last-child td {
                border-bottom: none;
        }

        tbody tr:hover {
                background: rgba(90, 209, 255, 0.12);
        }

        .muted {
                color: rgba(200, 205, 240, 0.42);
        }
</style>
