---
import PortalLayout from '../../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="API Keys" description="Kelola akses token untuk integrasi custom.">
        <h1>API Keys</h1>
        <table>
                <thead>
                        <tr>
                                <th>Nama</th>
                                <th>Terakhir Digunakan</th>
                                <th>Status</th>
                                <th>Aksi</th>
                        </tr>
                </thead>
                <tbody>
                        <tr>
                                <td>Zapier Automation</td>
                                <td>09 Mei 2024</td>
                                <td>Aktif</td>
                                <td><button type="button">Rotasi</button></td>
                        </tr>
                        <tr>
                                <td>CRM Sync</td>
                                <td>02 Mei 2024</td>
                                <td>Nonaktif</td>
                                <td><button type="button">Aktifkan</button></td>
                        </tr>
                </tbody>
        </table>
        <button type="button" class="create">Buat API Key Baru</button>
</PortalLayout>

<style>
        table {
                width: 100%;
                border-collapse: collapse;
                background: rgba(17, 22, 36, 0.88);
                border-radius: 1.35rem;
                overflow: hidden;
                border: 1px solid rgba(108, 126, 171, 0.2);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.38), 0 0 24px rgba(34, 156, 235, 0.16);
                margin-bottom: 1.75rem;
        }

        th,
        td {
                padding: 1rem 1.3rem;
                border-bottom: 1px solid rgba(124, 133, 178, 0.12);
                text-align: left;
        }

        th {
                background: rgba(21, 26, 40, 0.72);
                color: rgb(var(--text-muted));
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-size: 0.75rem;
        }

        tbody tr:last-child td {
                border-bottom: none;
        }

        tbody tr:hover {
                background: rgba(90, 209, 255, 0.12);
        }

        button {
                border: 1px solid rgba(90, 209, 255, 0.4);
                padding: 0.55rem 1rem;
                border-radius: 0.9rem;
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 0 20px rgba(34, 156, 235, 0.26);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        .create {
                padding: 0.85rem 1.2rem;
        }

        button:hover,
        button:focus-visible {
                background: var(--accent-strong);
                transform: translateY(-2px);
                box-shadow: 0 0 24px rgba(34, 156, 235, 0.32);
        }
</style>
