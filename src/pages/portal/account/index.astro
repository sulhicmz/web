---
import PortalLayout from '../../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Profil & Keamanan" description="Perbarui profil, kata sandi, dan faktor autentikasi.">
        <h1>Profil Akun</h1>
        <form class="profile-form">
                <label>
                        Nama Lengkap
                        <input type="text" value="Nadia Pratama" />
                </label>
                <label>
                        Email
                        <input type="email" value="nadia@finserve.id" />
                </label>
                <label>
                        Nomor WhatsApp
                        <input type="tel" value="081234567890" />
                </label>
                <button type="submit">Simpan Perubahan</button>
        </form>
        <div class="links">
                <a href="/portal/account/api-keys">Kelola API Keys</a>
                <a href="/portal/account/activity">Aktivitas &amp; Audit</a>
        </div>
</PortalLayout>

<style>
        .profile-form {
                display: grid;
                gap: 1.15rem;
                max-width: 520px;
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                border: 1px solid rgba(124, 133, 178, 0.18);
                padding: clamp(1.75rem, 4vw, 2.5rem);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
        }

        label {
                display: grid;
                gap: 0.45rem;
                font-weight: 600;
                color: rgb(var(--text-primary));
        }

        input {
                padding: 0.75rem 1rem;
                border-radius: 0.85rem;
                border: 1px solid rgba(124, 133, 178, 0.24);
                background: rgba(25, 30, 46, 0.85);
                color: rgb(var(--text-primary));
                box-shadow: inset 0 0 12px rgba(10, 12, 22, 0.6);
        }

        button {
                width: fit-content;
                padding: 0.75rem 1.35rem;
                border-radius: 0.95rem;
                border: 1px solid rgba(124, 77, 255, 0.42);
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.85));
                color: #fff;
                font-weight: 600;
                box-shadow: 0 0 20px rgba(124, 77, 255, 0.35);
                cursor: pointer;
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        button:hover,
        button:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 0 28px rgba(124, 77, 255, 0.5);
        }

        .links {
                margin-top: clamp(1.75rem, 4vw, 2.5rem);
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
        }

        .links a {
                padding: 0.6rem 1rem;
                border-radius: 0.85rem;
                border: 1px solid rgba(124, 133, 178, 0.22);
                background: rgba(21, 26, 40, 0.75);
                color: rgb(var(--text-secondary));
                transition: border var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
        }

        .links a:hover,
        .links a:focus-visible {
                border-color: rgba(124, 77, 255, 0.45);
                color: rgb(var(--text-primary));
                box-shadow: 0 0 22px rgba(124, 77, 255, 0.25);
        }
</style>
