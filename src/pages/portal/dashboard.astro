---
import PortalLayout from '../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Dashboard Portal" description="Ringkasan proyek, tagihan, dan notifikasi terbaru.">
        <h1>Dashboard</h1>
        <section class="cards">
                <article>
                        <h2>Proyek Aktif</h2>
                        <p>Tampilkan status sprint, progres deploy, dan URL staging/produksi.</p>
                </article>
                <article>
                        <h2>Invoice &amp; Pembayaran</h2>
                        <p>Invoice jatuh tempo dan riwayat pembayaran terbaru.</p>
                </article>
                <article>
                        <h2>Notifikasi</h2>
                        <p>Update tiket dukungan, aktivitas deployment, dan catatan penting tim.</p>
                </article>
        </section>
</PortalLayout>

<style>
        h1 {
                margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
                font-size: clamp(1.8rem, 3vw, 2.4rem);
        }

        .cards {
                display: grid;
                gap: clamp(1.25rem, 3vw, 1.75rem);
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        }

        article {
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.35rem;
                padding: 1.75rem;
                border: 1px solid rgba(108, 126, 171, 0.2);
                box-shadow: 0 0 30px rgba(12, 18, 36, 0.36), 0 0 22px rgba(34, 156, 235, 0.18);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        article:hover,
        article:focus-within {
                transform: translateY(-4px);
                box-shadow: 0 0 32px rgba(34, 156, 235, 0.22);
        }
</style>
