---
import PortalLayout from '../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Knowledge Base" description="Dokumentasi privat, panduan onboarding, dan FAQ khusus klien.">
        <h1>Knowledge Base</h1>
        <p>Cari artikel bantuan privat berdasarkan kategori.</p>
        <ul class="kb-list">
                <li>
                        <h2>Getting Started</h2>
                        <p>Checklist pre-launch, akses portal, dan konfigurasi domain.</p>
                </li>
                <li>
                        <h2>Pembayaran</h2>
                        <p>Alur penagihan otomatis, cara update metode pembayaran, dan kupon.</p>
                </li>
                <li>
                        <h2>Dukungan Teknis</h2>
                        <p>Troubleshooting umum, cara mengajukan tiket prioritas, dan panduan lampiran.</p>
                </li>
        </ul>
</PortalLayout>

<style>
        .kb-list {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: clamp(1.25rem, 3vw, 1.75rem);
        }

        li {
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                padding: clamp(1.75rem, 4vw, 2.4rem);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        li:hover,
        li:focus-within {
                transform: translateY(-4px);
                box-shadow: 0 0 36px rgba(124, 77, 255, 0.18);
        }
</style>
