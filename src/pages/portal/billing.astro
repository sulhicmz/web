---
import PortalLayout from '../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Invoice & Pembayaran" description="Kelola tagihan, metode pembayaran, dan riwayat transaksi.">
        <h1>Invoice</h1>
        <table>
                <thead>
                        <tr>
                                <th>No</th>
                                <th>Tanggal</th>
                                <th>Jumlah</th>
                                <th>Status</th>
                                <th>Aksi</th>
                        </tr>
                </thead>
                <tbody>
                        <tr>
                                <td>INV-2024-005</td>
                                <td>10 Mei 2024</td>
                                <td>IDR 12.500.000</td>
                                <td><span class="status paid">Lunas</span></td>
                                <td><a href="#">Unduh PDF</a></td>
                        </tr>
                        <tr>
                                <td>INV-2024-006</td>
                                <td>25 Mei 2024</td>
                                <td>IDR 7.500.000</td>
                                <td><span class="status due">Jatuh Tempo</span></td>
                                <td><button type="button">Bayar Sekarang</button></td>
                        </tr>
                </tbody>
        </table>
</PortalLayout>

<style>
        table {
                width: 100%;
                border-collapse: collapse;
                background: rgba(17, 22, 36, 0.88);
                border-radius: 1.35rem;
                overflow: hidden;
                border: 1px solid rgba(108, 126, 171, 0.2);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.38), 0 0 24px rgba(34, 156, 235, 0.16);
        }

        th,
        td {
                padding: 1rem 1.25rem;
                border-bottom: 1px solid rgba(124, 133, 178, 0.12);
                text-align: left;
        }

        th {
                background: rgba(21, 26, 40, 0.72);
                color: rgb(var(--text-muted));
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-size: 0.75rem;
        }

        tbody tr:last-child td {
                border-bottom: none;
        }

        tbody tr:hover {
                background: rgba(90, 209, 255, 0.12);
        }

        .status {
                padding: 0.35rem 0.85rem;
                border-radius: 999px;
                font-weight: 600;
                border: 1px solid transparent;
        }

        .status.paid {
                background: rgba(46, 204, 113, 0.18);
                border-color: rgba(46, 204, 113, 0.28);
                color: #5be282;
        }

        .status.due {
                background: rgba(231, 76, 60, 0.18);
                border-color: rgba(231, 76, 60, 0.28);
                color: #ff8a78;
        }

        button {
                border: 1px solid rgba(90, 209, 255, 0.4);
                padding: 0.55rem 1rem;
                border-radius: 0.95rem;
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 0 20px rgba(34, 156, 235, 0.3);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        button:hover,
        button:focus-visible {
                background: var(--accent-strong);
                transform: translateY(-2px);
                box-shadow: 0 0 24px rgba(34, 156, 235, 0.35);
        }
</style>
