---
import PortalLayout from '../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Tutorial & Onboarding" description="Video panduan dan checklist tugas untuk tim Anda.">
        <h1>Tutorial</h1>
        <ul class="tutorials">
                <li>
                        <h2>Setup Portal Klien</h2>
                        <p>Durasi 12 menit — Aktivasi akun, manajemen pengguna, dan pengaturan notifikasi.</p>
                </li>
                <li>
                        <h2>Workflow Deployment</h2>
                        <p>Durasi 9 menit — Cara request deploy staging ke produksi dan melakukan review.</p>
                </li>
                <li>
                        <h2>Pengelolaan Konten</h2>
                        <p>Durasi 7 menit — Update blog, docs, dan case study melalui content collections.</p>
                </li>
        </ul>
</PortalLayout>

<style>
        .tutorials {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: clamp(1.25rem, 3vw, 1.75rem);
        }

        li {
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                padding: clamp(1.75rem, 4vw, 2.4rem);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        li:hover,
        li:focus-within {
                transform: translateY(-4px);
                box-shadow: 0 0 36px rgba(90, 209, 255, 0.18);
        }
</style>
