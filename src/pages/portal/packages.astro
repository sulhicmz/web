---
import PortalLayout from '../../layouts/PortalLayout.astro';
export const prerender = false;
---

<PortalLayout title="Paket & Upgrade" description="Kelola langganan, add-on, dan permintaan upgrade.">
        <h1>Paket Aktif</h1>
        <section class="package">
                <h2>Scale Plan</h2>
                <p>Termasuk portal multi-proyek, integrasi pembayaran, dan notifikasi otomatis.</p>
                <button type="button">Ajukan Upgrade Enterprise</button>
        </section>
        <section class="addons">
                <h2>Add-on Tersedia</h2>
                <ul>
                        <li>Monitoring Core Web Vitals</li>
                        <li>Integrasi CRM lanjutan</li>
                        <li>Support premium 24/7</li>
                </ul>
        </section>
</PortalLayout>

<style>
        button {
                border: 1px solid rgba(90, 209, 255, 0.4);
                padding: 0.8rem 1.35rem;
                border-radius: 0.95rem;
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.85));
                color: #fff;
                font-weight: 600;
                cursor: pointer;
                box-shadow: 0 0 20px rgba(90, 209, 255, 0.32);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        button:hover,
        button:focus-visible {
                background: var(--accent-dark);
                transform: translateY(-2px);
                box-shadow: 0 0 26px rgba(90, 209, 255, 0.5);
        }

        .package,
        .addons {
                background: rgba(17, 22, 36, 0.8);
                border-radius: 1.5rem;
                padding: clamp(1.75rem, 4vw, 2.5rem);
                box-shadow: 0 0 32px rgba(12, 18, 36, 0.4);
                border: 1px solid rgba(124, 133, 178, 0.18);
                margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
        }

        ul {
                margin: 0;
                padding-left: 1.5rem;
                display: grid;
                gap: 0.55rem;
        }
</style>
