---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { buildWhatsappLink, CONTACT_EMAIL } from '../consts';

const demoWhatsappLink = buildWhatsappLink('Halo, saya ingin menjadwalkan demo');
---

<MarketingLayout title="Hubungi Tim Kami" description="Kirim brief proyek, jadwalkan demo portal, atau konsultasi kebutuhan website Astro Anda.">
        <section class="contact">
                <h1>Kontak &amp; Konsultasi</h1>
                <p>Isi formulir di bawah atau hubungi langsung via WhatsApp untuk diskusi cepat.</p>
                <form class="contact-form">
                        <label>
                                Nama Lengkap
                                <input type="text" name="name" required placeholder="Nama Anda" />
                        </label>
                        <label>
                                Email Kerja
                                <input type="email" name="email" required placeholder="nama@perusahaan.com" />
                        </label>
                        <label>
                                Nomor WhatsApp
                                <input type="tel" name="phone" required placeholder="08xxxxxxxxxx" />
                        </label>
                        <label>
                                Jenis Proyek
                                <select name="projectType" required>
                                        <option value="">Pilih salah satu</option>
                                        <option value="marketing">Website Marketing</option>
                                        <option value="portal">Portal Klien</option>
                                        <option value="keduanya">Keduanya</option>
                                </select>
                        </label>
                        <label>
                                Pesan
                                <textarea name="message" rows="4" placeholder="Ceritakan kebutuhan Anda"></textarea>
                        </label>
                        <label class="consent">
                                <input type="checkbox" name="consent" required />
                                Saya setuju menerima update via email dan WhatsApp.
                        </label>
                        <button type="submit">Kirim Brief</button>
                </form>
                <div class="direct-contact">
                        <a class="whatsapp" href={demoWhatsappLink} target="_blank" rel="noreferrer">Chat WhatsApp</a>
                        <a class="email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
                </div>
        </section>
</MarketingLayout>

<style>
        .contact {
                max-width: 760px;
                margin: 0 auto;
                display: grid;
                gap: clamp(1.75rem, 4vw, 2.5rem);
                background: rgba(17, 22, 36, 0.78);
                border: 1px solid rgba(124, 133, 178, 0.18);
                border-radius: clamp(2rem, 5vw, 2.75rem);
                padding: clamp(2rem, 5vw, 3rem);
                box-shadow: 0 0 42px rgba(12, 18, 36, 0.45);
        }

        form {
                display: grid;
                gap: 1.15rem;
        }

        label {
                display: grid;
                gap: 0.5rem;
                font-weight: 600;
                color: rgb(var(--text-primary));
        }

        button {
                padding: 0.85rem 1.4rem;
                border-radius: 0.95rem;
                border: 1px solid rgba(124, 77, 255, 0.4);
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.85));
                color: #fff;
                font-weight: 600;
                cursor: pointer;
                width: fit-content;
                box-shadow: 0 0 26px rgba(124, 77, 255, 0.42);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        button:hover,
        button:focus-visible {
                background: var(--accent-dark);
                transform: translateY(-2px);
        }

        .consent {
                align-items: center;
                grid-template-columns: auto 1fr;
                font-weight: 400;
                color: rgb(var(--text-secondary));
        }

        .consent input {
                width: 1.2rem;
                height: 1.2rem;
        }

        .direct-contact {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
        }

        .whatsapp,
        .email {
                padding: 0.75rem 1.1rem;
                border-radius: 0.85rem;
                text-decoration: none;
                font-weight: 600;
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        .whatsapp {
                background: linear-gradient(120deg, #25d366, #30f28a);
                color: #051017;
                box-shadow: 0 0 20px rgba(37, 211, 102, 0.4);
        }

        .email {
                background: rgba(21, 25, 43, 0.82);
                color: rgb(var(--text-secondary));
                border: 1px solid rgba(124, 133, 178, 0.22);
        }

        .whatsapp:hover,
        .whatsapp:focus-visible,
        .email:hover,
        .email:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 0 26px rgba(124, 77, 255, 0.28);
        }
</style>
