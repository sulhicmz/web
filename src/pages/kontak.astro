---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Hubungi Tim Kami" description="Kirim brief proyek, jadwalkan demo portal, atau konsultasi kebutuhan website Astro Anda.">
        <section class="contact">
                <h1>Kontak &amp; Konsultasi</h1>
                <p>Isi formulir di bawah atau hubungi langsung via WhatsApp untuk diskusi cepat.</p>
                <form class="contact-form">
                        <label>
                                Nama Lengkap
                                <input type="text" name="name" required placeholder="Nama Anda" />
                        </label>
                        <label>
                                Email Kerja
                                <input type="email" name="email" required placeholder="nama@perusahaan.com" />
                        </label>
                        <label>
                                Nomor WhatsApp
                                <input type="tel" name="phone" required placeholder="08xxxxxxxxxx" />
                        </label>
                        <label>
                                Jenis Proyek
                                <select name="projectType" required>
                                        <option value="">Pilih salah satu</option>
                                        <option value="marketing">Website Marketing</option>
                                        <option value="portal">Portal Klien</option>
                                        <option value="keduanya">Keduanya</option>
                                </select>
                        </label>
                        <label>
                                Pesan
                                <textarea name="message" rows="4" placeholder="Ceritakan kebutuhan Anda"></textarea>
                        </label>
                        <label class="consent">
                                <input type="checkbox" name="consent" required />
                                Saya setuju menerima update via email dan WhatsApp.
                        </label>
                        <button type="submit">Kirim Brief</button>
                </form>
                <div class="direct-contact">
                        <a class="whatsapp" href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20menjadwalkan%20demo" target="_blank" rel="noreferrer">Chat WhatsApp</a>
                        <a class="email" href="mailto:halo@astropro.id">halo@astropro.id</a>
                </div>
        </section>
</MarketingLayout>

<style>
        .contact {
                max-width: 720px;
                margin: 0 auto;
                display: grid;
                gap: 2rem;
        }

        form {
                display: grid;
                gap: 1rem;
        }

        label {
                display: grid;
                gap: 0.5rem;
                font-weight: 600;
        }

        input,
        textarea,
        select {
                padding: 0.75rem 1rem;
                border-radius: 0.75rem;
                border: 1px solid rgba(var(--gray), 0.3);
                font-size: 1rem;
        }

        button {
                padding: 0.75rem 1rem;
                border-radius: 0.75rem;
                border: none;
                background: var(--accent);
                color: #fff;
                font-weight: 600;
                cursor: pointer;
        }

        button:hover,
        button:focus-visible {
                background: var(--accent-dark);
        }

        .consent {
                align-items: center;
                grid-template-columns: auto 1fr;
                font-weight: 400;
        }

        .consent input {
                width: 1.2rem;
                height: 1.2rem;
        }

        .direct-contact {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
        }

        .whatsapp,
        .email {
                padding: 0.75rem 1rem;
                border-radius: 0.75rem;
                text-decoration: none;
                font-weight: 600;
        }

        .whatsapp {
                background: #25d366;
                color: #0f1219;
        }

        .email {
                background: rgba(var(--gray), 0.1);
                color: rgb(var(--black));
        }
</style>
