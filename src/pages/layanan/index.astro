---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
const launchWhatsappLink = 'https://wa.me/6281234567890?text=Ingin%20diskusi%20paket%20Launch';
const scaleWhatsappLink = 'https://wa.me/6281234567890?text=Ingin%20diskusi%20paket%20Scale';
---

<MarketingLayout title="Paket Layanan & Harga" description="Pilihan paket website Astro, portal klien, dan otomasi operasional sesuai kebutuhan bisnis Anda.">
        <section class="pricing-intro">
                <h1>Paket fleksibel untuk tiap tahap pertumbuhan</h1>
                <p>Kami menyediakan paket siap pakai dengan opsi add-on agar implementasi berjalan cepat namun tetap terukur.</p>
        </section>

        <section class="pricing-table">
                <div class="plan">
                        <h2>Launch</h2>
                        <p class="price">IDR 35jt</p>
                        <ul>
                                <li>Situs marketing 5 halaman</li>
                                <li>Blog &amp; knowledge base dasar</li>
                                <li>Portal klien dengan 1 proyek aktif</li>
                                <li>Integrasi WhatsApp CTA</li>
                        </ul>
                        <a class="btn" href={launchWhatsappLink} target="_blank" rel="noreferrer">Konsultasi Paket Launch</a>
                </div>
                <div class="plan highlight">
                        <p class="badge">Terpopuler</p>
                        <h2>Scale</h2>
                        <p class="price">IDR 55jt</p>
                        <ul>
                                <li>Semua fitur Launch</li>
                                <li>Portal multi-proyek + staging/production URLs</li>
                                <li>Integrasi pembayaran Midtrans/Xendit</li>
                                <li>Automasi notifikasi WA &amp; email</li>
                        </ul>
                        <a class="btn" href={scaleWhatsappLink} target="_blank" rel="noreferrer">Konsultasi Paket Scale</a>
                </div>
                <div class="plan">
                        <h2>Enterprise</h2>
                        <p class="price">Mulai IDR 80jt</p>
                        <ul>
                                <li>Integrasi SSO &amp; RBAC kustom</li>
                                <li>Workflow approval &amp; SLA khusus</li>
                                <li>Dedicated success manager</li>
                                <li>Support 24/7 &amp; pelatihan tim</li>
                        </ul>
                        <a class="btn" href="/kontak">Jadwalkan Diskusi Enterprise</a>
                </div>
        </section>

        <section class="addons">
                <h2>Add-on Opsional</h2>
                <ul>
                        <li>Pengelolaan konten &amp; copywriting bulanan</li>
                        <li>Integrasi CRM &amp; automation (HubSpot, Pipedrive)</li>
                        <li>Pengembangan fitur custom portal klien</li>
                        <li>Monitoring performa &amp; SEO berkelanjutan</li>
                </ul>
        </section>
</MarketingLayout>

<style>
        .pricing-intro {
                text-align: center;
                max-width: 780px;
                margin: 0 auto clamp(2.5rem, 6vw, 3.5rem);
        }

        .pricing-table {
                display: grid;
                gap: clamp(1.5rem, 4vw, 2.2rem);
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        }

        .plan {
                background: rgba(17, 22, 36, 0.8);
                border-radius: clamp(1.5rem, 4vw, 2rem);
                padding: clamp(2rem, 5vw, 2.75rem);
                box-shadow: 0 0 38px rgba(12, 18, 36, 0.42);
                border: 1px solid rgba(108, 126, 171, 0.2);
                display: grid;
                gap: 1.15rem;
                position: relative;
                overflow: hidden;
                transition: transform var(--transition-base), box-shadow var(--transition-base), border var(--transition-base);
        }

        .plan::after {
                content: "";
                position: absolute;
                inset: -40% -40% auto auto;
                width: 200px;
                height: 200px;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.22), transparent 70%);
                filter: blur(10px);
                opacity: 0;
                transition: opacity var(--transition-base);
        }

        .plan.highlight {
                border-color: rgba(90, 209, 255, 0.45);
                box-shadow: 0 0 45px rgba(34, 156, 235, 0.26);
        }

        .plan:hover,
        .plan:focus-within {
                transform: translateY(-6px);
                box-shadow: 0 0 46px rgba(34, 156, 235, 0.22);
        }

        .plan:hover::after,
        .plan:focus-within::after {
                opacity: 1;
        }

        .badge {
                position: absolute;
                top: 1.25rem;
                right: 1.75rem;
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.85));
                color: #fff;
                padding: 0.3rem 0.85rem;
                border-radius: 999px;
                font-size: 0.75rem;
                font-weight: 700;
                letter-spacing: 0.1em;
                text-transform: uppercase;
        }

        .price {
                font-size: clamp(2.1rem, 4vw, 2.5rem);
                font-weight: 700;
                margin: 0;
                color: rgb(var(--text-primary));
        }

        ul {
                margin: 0;
                padding-left: 1.35rem;
                display: grid;
                gap: 0.6rem;
                color: rgb(var(--text-secondary));
        }

        .btn {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                padding: 0.85rem 1.3rem;
                border-radius: 0.95rem;
                background: rgba(21, 26, 40, 0.9);
                color: #fff;
                text-decoration: none;
                font-weight: 600;
                border: 1px solid rgba(90, 209, 255, 0.38);
                transition: transform var(--transition-base), box-shadow var(--transition-base), background var(--transition-base);
        }

        .plan.highlight .btn {
                background: var(--accent-gradient);
                box-shadow: 0 0 26px rgba(34, 156, 235, 0.28);
        }

        .btn:hover,
        .btn:focus-visible {
                background: var(--accent-strong);
                box-shadow: 0 0 26px rgba(34, 156, 235, 0.32);
                transform: translateY(-3px);
        }

        .addons {
                margin-top: clamp(3rem, 8vw, 4.5rem);
                background: rgba(17, 22, 36, 0.74);
                padding: clamp(2rem, 5vw, 2.75rem);
                border-radius: clamp(1.6rem, 4vw, 2rem);
                border: 1px solid rgba(108, 126, 171, 0.2);
                box-shadow: 0 0 36px rgba(12, 18, 36, 0.4);
        }

        .addons ul {
                padding-left: 1.5rem;
                display: grid;
                gap: 0.6rem;
        }
</style>
