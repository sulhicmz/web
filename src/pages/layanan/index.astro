---
import MarketingLayout from '../../layouts/MarketingLayout.astro';
const launchWhatsappLink = 'https://wa.me/6281234567890?text=Ingin%20diskusi%20paket%20Launch';
const scaleWhatsappLink = 'https://wa.me/6281234567890?text=Ingin%20diskusi%20paket%20Scale';
---

<MarketingLayout title="Paket Layanan & Harga" description="Pilihan paket website Astro, portal klien, dan otomasi operasional sesuai kebutuhan bisnis Anda.">
        <section class="pricing-intro">
                <h1>Paket fleksibel untuk tiap tahap pertumbuhan</h1>
                <p>Kami menyediakan paket siap pakai dengan opsi add-on agar implementasi berjalan cepat namun tetap terukur.</p>
        </section>

        <section class="pricing-table">
                <div class="plan">
                        <h2>Launch</h2>
                        <p class="price">IDR 35jt</p>
                        <ul>
                                <li>Situs marketing 5 halaman</li>
                                <li>Blog &amp; knowledge base dasar</li>
                                <li>Portal klien dengan 1 proyek aktif</li>
                                <li>Integrasi WhatsApp CTA</li>
                        </ul>
                        <a class="btn" href={launchWhatsappLink} target="_blank" rel="noreferrer">Konsultasi Paket Launch</a>
                </div>
                <div class="plan highlight">
                        <p class="badge">Terpopuler</p>
                        <h2>Scale</h2>
                        <p class="price">IDR 55jt</p>
                        <ul>
                                <li>Semua fitur Launch</li>
                                <li>Portal multi-proyek + staging/production URLs</li>
                                <li>Integrasi pembayaran Midtrans/Xendit</li>
                                <li>Automasi notifikasi WA &amp; email</li>
                        </ul>
                        <a class="btn" href={scaleWhatsappLink} target="_blank" rel="noreferrer">Konsultasi Paket Scale</a>
                </div>
                <div class="plan">
                        <h2>Enterprise</h2>
                        <p class="price">Mulai IDR 80jt</p>
                        <ul>
                                <li>Integrasi SSO &amp; RBAC kustom</li>
                                <li>Workflow approval &amp; SLA khusus</li>
                                <li>Dedicated success manager</li>
                                <li>Support 24/7 &amp; pelatihan tim</li>
                        </ul>
                        <a class="btn" href="/kontak">Jadwalkan Diskusi Enterprise</a>
                </div>
        </section>

        <section class="addons">
                <h2>Add-on Opsional</h2>
                <ul>
                        <li>Pengelolaan konten &amp; copywriting bulanan</li>
                        <li>Integrasi CRM &amp; automation (HubSpot, Pipedrive)</li>
                        <li>Pengembangan fitur custom portal klien</li>
                        <li>Monitoring performa &amp; SEO berkelanjutan</li>
                </ul>
        </section>
</MarketingLayout>

<style>
        .pricing-intro {
                text-align: center;
                max-width: 800px;
                margin: 0 auto clamp(3rem, 6vw, 4rem);
                display: grid;
                gap: var(--space-3);
        }

        .pricing-intro h1 {
                font-size: clamp(2.2rem, 2rem + 1vw, 3rem);
                margin: 0;
                color: var(--color-text-primary);
                text-shadow: 0 0 26px rgba(147, 51, 234, 0.25);
        }

        .pricing-intro p {
                margin: 0;
                color: rgba(var(--text-secondary), 0.85);
                font-size: var(--text-lg);
                line-height: var(--leading-relaxed);
        }

        .pricing-table {
                display: grid;
                gap: clamp(1.75rem, 3vw, 2.5rem);
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        }

        .plan {
                background: linear-gradient(150deg, rgba(6, 12, 32, 0.82) 0%, rgba(17, 26, 48, 0.78) 60%, rgba(30, 40, 70, 0.85) 100%);
                border-radius: var(--radius-2xl);
                padding: clamp(2.25rem, 4vw, 3rem);
                box-shadow: 0 26px 56px rgba(2, 6, 23, 0.55);
                border: 1px solid rgba(56, 189, 248, 0.2);
                display: grid;
                gap: var(--space-4);
                position: relative;
                overflow: hidden;
                transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
        }

        .plan::before {
                content: '';
                position: absolute;
                inset: -35% -40% auto auto;
                width: 220px;
                height: 220px;
                background: radial-gradient(circle, rgba(56, 189, 248, 0.3), transparent 70%);
                opacity: 0.7;
                pointer-events: none;
        }

        .plan.highlight {
                border-color: rgba(244, 114, 182, 0.45);
                box-shadow: 0 30px 60px rgba(244, 114, 182, 0.18);
        }

        .plan:hover,
        .plan:focus-within {
                transform: translateY(-6px);
                box-shadow: var(--glow-secondary);
                border-color: rgba(56, 189, 248, 0.45);
        }

        .badge {
                position: absolute;
                top: 1.5rem;
                right: 1.5rem;
                background: var(--accent-gradient);
                color: var(--color-text-primary);
                padding: 0.35rem 1rem;
                border-radius: var(--radius-full);
                font-size: var(--text-xs);
                font-weight: var(--font-semibold);
                letter-spacing: 0.18em;
                text-transform: uppercase;
        }

        .price {
                font-size: clamp(2.1rem, 2rem + 0.6vw, 2.6rem);
                font-weight: var(--font-bold);
                margin: 0;
                color: var(--color-text-primary);
        }

        ul {
                margin: 0;
                padding-left: 1.5rem;
                display: grid;
                gap: 0.7rem;
                color: rgba(var(--text-secondary), 0.8);
        }

        .btn {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                padding: 0.9rem 1.4rem;
                border-radius: var(--radius-full);
                background: var(--accent-gradient);
                color: var(--color-text-primary);
                text-decoration: none;
                font-weight: var(--font-semibold);
                border: 1px solid rgba(var(--accent-rgb), 0.5);
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        .plan.highlight .btn {
                box-shadow: var(--glow-primary);
        }

        .btn:hover,
        .btn:focus-visible {
                transform: translateY(-3px);
                box-shadow: var(--glow-secondary);
                outline: none;
        }

        .addons {
                margin-top: clamp(3rem, 7vw, 4.5rem);
                background: linear-gradient(150deg, rgba(8, 12, 32, 0.82) 0%, rgba(17, 26, 48, 0.78) 70%);
                padding: clamp(2.5rem, 5vw, 3rem);
                border-radius: var(--radius-2xl);
                border: 1px solid rgba(56, 189, 248, 0.2);
                box-shadow: 0 22px 48px rgba(2, 6, 23, 0.55);
        }

        .addons h2 {
                margin-top: 0;
                color: var(--color-text-primary);
                text-shadow: 0 0 18px rgba(147, 51, 234, 0.25);
        }

        .addons ul {
                padding-left: 1.5rem;
                gap: 0.6rem;
                color: rgba(var(--text-secondary), 0.85);
        }

        @media (max-width: 720px) {
                .plan {
                        padding: var(--space-5);
                }

                .badge {
                        position: static;
                        margin: 0 auto var(--space-3);
                        display: inline-block;
                }
        }
</style>
