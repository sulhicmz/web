const iconSvg = (icons as Record<string, string>)[name] || (icons as Record<string, string>)['user'];
const iconLabel = label || name.charAt(0).toUpperCase() + name.slice(1);
---

<svg
    width={svgSize}
    height={svgSize}
    viewBox="0 0 24 24"
    fill="currentColor"
    class={customClass}
    aria-label={iconLabel}
    role="img"
    set:html={iconSvg}
/>
