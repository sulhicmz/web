---
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const scriptSrc = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL ?? 'https://plausible.io/js/script.js';
const consentKey = 'analytics-consent';
const shouldRender = Boolean(domain);
---
{shouldRender && (
        <>
                <div id="analytics-consent-banner" class="analytics-consent" hidden>
                        <div class="analytics-consent__surface" aria-hidden="true"></div>
                        <div class="analytics-consent__content" role="dialog" aria-live="polite">
                                <div class="analytics-consent__header">
                                        <h2 class="analytics-consent__title">Penggunaan Analitik</h2>
                                        <p class="analytics-consent__subtitle">Kami hanya mengumpulkan metrik anonim untuk meningkatkan pengalaman Anda.</p>
                                </div>
                                <div class="analytics-consent__actions">
                                        <button type="button" class="btn btn-ghost" data-action="decline">
                                                Tolak
                                        </button>
                                        <button type="button" class="btn" data-action="accept">
                                                Izinkan
                                        </button>
                                </div>
                        </div>
                </div>
                <script type="module">
                        const consentStorageKey = ${JSON.stringify(consentKey)};
                        const plausibleDomain = ${JSON.stringify(domain)};
                        const plausibleSrc = ${JSON.stringify(scriptSrc)};

                        const ensureScript = () => {
                                if (document.querySelector("script[data-analytics='plausible']")) {
                                        return;
                                }
                                const script = document.createElement('script');
                                script.defer = true;
                                script.src = plausibleSrc;
                                script.dataset.analytics = 'plausible';
                                script.dataset.domain = plausibleDomain;
                                document.head.appendChild(script);
                                document.dispatchEvent(new CustomEvent('analytics:loaded', { detail: { provider: 'plausible' } }));
                        };

                        const banner = document.getElementById('analytics-consent-banner');

                        const applyConsent = (state) => {
                                if (state === 'granted') {
                                        ensureScript();
                                        banner?.remove();
                                } else if (state === 'denied') {
                                        banner?.remove();
                                } else {
                                        banner?.removeAttribute('hidden');
                                }
                        };

                        const savedState = localStorage.getItem(consentStorageKey);
                        if (savedState === 'granted' || savedState === 'denied') {
                                applyConsent(savedState);
                        } else {
                                applyConsent(null);
                        }

                        banner?.addEventListener('click', (event) => {
                                const target = event.target;
                                if (!(target instanceof HTMLElement) || !target.dataset.action) {
                                        return;
                                }
                                const action = target.dataset.action;
                                if (action === 'accept') {
                                        localStorage.setItem(consentStorageKey, 'granted');
                                        applyConsent('granted');
                                } else if (action === 'decline') {
                                        localStorage.setItem(consentStorageKey, 'denied');
                                        applyConsent('denied');
                                }
                        });

                        if (banner) {
                                window.analyticsConsent = {
                                        reset() {
                                                localStorage.removeItem(consentStorageKey);
                                                if (!banner.isConnected) {
                                                        document.body.appendChild(banner);
                                                }
                                                banner.setAttribute('hidden', '');
                                                requestAnimationFrame(() => {
                                                        banner.removeAttribute('hidden');
                                                });
                                        },
                                };
                        }
                </script>
        </>
)}

<style>
        .analytics-consent {
                position: fixed;
                bottom: 1.5rem;
                left: 50%;
                transform: translateX(-50%);
                z-index: 9999;
                max-width: min(520px, calc(100% - 2.4rem));
                width: 100%;
        }

        .analytics-consent__surface {
                position: absolute;
                inset: -25%;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.28), transparent 72%);
                filter: blur(28px);
        }

        .analytics-consent__content {
                position: relative;
                background: rgba(12, 16, 29, 0.9);
                backdrop-filter: blur(20px);
                border-radius: 1.35rem;
                border: 1px solid rgba(108, 126, 171, 0.22);
                box-shadow: 0 18px 40px rgba(7, 11, 22, 0.45);
                padding: 1.7rem;
                display: grid;
                gap: 1.25rem;
        }

        .analytics-consent__header {
                display: grid;
                gap: 0.55rem;
        }

        .analytics-consent__title {
                margin: 0;
                font-size: 1.25rem;
                color: rgb(var(--text-primary));
        }

        .analytics-consent__subtitle {
                margin: 0;
                font-size: 0.95rem;
                color: rgb(var(--text-secondary));
        }

        .analytics-consent__actions {
                display: flex;
                justify-content: flex-end;
                gap: 0.75rem;
        }

        .btn {
                border-radius: 999px;
                padding: 0.6rem 1.4rem;
                border: 1px solid rgba(90, 209, 255, 0.4);
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 600;
                cursor: pointer;
                transition: transform var(--transition-base), box-shadow var(--transition-base);
        }

        .btn:hover,
        .btn:focus-visible {
                transform: translateY(-1px);
                box-shadow: 0 12px 24px rgba(42, 176, 255, 0.25);
        }

        .btn-ghost {
                background: rgba(13, 18, 32, 0.8);
                border-color: rgba(108, 126, 171, 0.3);
                color: rgb(var(--text-secondary));
        }

        .btn-ghost:hover,
        .btn-ghost:focus-visible {
                color: rgb(var(--text-primary));
        }

        @media (max-width: 720px) {
                .analytics-consent {
                        bottom: 1rem;
                }

                .analytics-consent__content {
                        padding: 1.4rem;
                }

                .analytics-consent__actions {
                        flex-direction: column;
                        align-items: stretch;
                }

                .analytics-consent__actions .btn,
                .analytics-consent__actions .btn-ghost {
                        width: 100%;
                        text-align: center;
                }
        }
</style>
