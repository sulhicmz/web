---
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN ?? '';
const scriptSrc = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL ?? 'https://plausible.io/js/script.js';
const consentKey = 'analytics-consent';
const shouldRender = Boolean(domain);
---
{shouldRender && (
        <>
                <div id="analytics-consent-banner" class="analytics-consent" hidden>
                        <div class="analytics-consent__glow" aria-hidden="true"></div>
                        <div class="analytics-consent__content" role="dialog" aria-live="polite">
                                <h2 class="analytics-consent__title">Penggunaan Analitik</h2>
                                <p class="analytics-consent__text">
                                        Kami menggunakan Plausible Analytics untuk memahami performa situs tanpa melacak data
                                        pribadi. Pilih "Izinkan" untuk membantu kami meningkatkan layanan atau "Tolak" untuk
                                        menonaktifkan.
                                </p>
                                <div class="analytics-consent__actions">
                                        <button type="button" class="analytics-consent__button analytics-consent__button--ghost" data-action="decline">
                                                Tolak
                                        </button>
                                        <button type="button" class="analytics-consent__button" data-action="accept">
                                                Izinkan
                                        </button>
                                </div>
                        </div>
                </div>
                <script type="module">
                        const consentStorageKey = ${JSON.stringify(consentKey)};
                        const plausibleDomain = ${JSON.stringify(domain)};
                        const plausibleSrc = ${JSON.stringify(scriptSrc)};

                        const ensureScript = () => {
                                if (document.querySelector("script[data-analytics='plausible']")) {
                                        return;
                                }
                                const script = document.createElement('script');
                                script.defer = true;
                                script.src = plausibleSrc;
                                script.dataset.analytics = 'plausible';
                                script.dataset.domain = plausibleDomain;
                                document.head.appendChild(script);
                                document.dispatchEvent(new CustomEvent('analytics:loaded', { detail: { provider: 'plausible' } }));
                        };

                        const banner = document.getElementById('analytics-consent-banner');

                        const applyConsent = (state) => {
                                if (state === 'granted') {
                                        ensureScript();
                                        banner?.remove();
                                } else if (state === 'denied') {
                                        banner?.remove();
                                } else {
                                        banner?.removeAttribute('hidden');
                                }
                        };

                        const savedState = localStorage.getItem(consentStorageKey);
                        if (savedState === 'granted' || savedState === 'denied') {
                                applyConsent(savedState);
                        } else {
                                applyConsent(null);
                        }

                        banner?.addEventListener('click', (event) => {
                                const target = event.target;
                                if (!(target instanceof HTMLElement) || !target.dataset.action) {
                                        return;
                                }
                                const action = target.dataset.action;
                                if (action === 'accept') {
                                        localStorage.setItem(consentStorageKey, 'granted');
                                        applyConsent('granted');
                                } else if (action === 'decline') {
                                        localStorage.setItem(consentStorageKey, 'denied');
                                        applyConsent('denied');
                                }
                        });

                        if (banner) {
                                window.analyticsConsent = {
                                        reset() {
                                                localStorage.removeItem(consentStorageKey);
                                                if (!banner.isConnected) {
                                                        document.body.appendChild(banner);
                                                }
                                                banner.setAttribute('hidden', '');
                                                requestAnimationFrame(() => {
                                                        banner.removeAttribute('hidden');
                                                });
                                        },
                                };
                        }
                </script>
        </>
)}

<style>
        .analytics-consent {
                position: fixed;
                bottom: 1.5rem;
                left: 50%;
                transform: translateX(-50%);
                z-index: 9999;
                max-width: min(520px, calc(100% - 2rem));
                width: 100%;
        }

        .analytics-consent__glow {
                position: absolute;
                inset: -30%;
                background: radial-gradient(circle, rgba(124, 77, 255, 0.4), transparent 70%);
                filter: blur(24px);
                opacity: 0.75;
        }

        .analytics-consent__content {
                position: relative;
                background: rgba(17, 21, 34, 0.88);
                backdrop-filter: blur(18px);
                border-radius: 1.25rem;
                border: 1px solid rgba(124, 133, 178, 0.25);
                box-shadow: 0 18px 40px rgba(6, 10, 26, 0.6), 0 0 32px rgba(124, 77, 255, 0.18);
                padding: 1.7rem;
        }

        .analytics-consent__title {
                margin: 0 0 0.75rem 0;
                font-size: 1.35rem;
                color: rgb(var(--text-primary));
        }

        .analytics-consent__text {
                margin: 0 0 1.5rem 0;
                font-size: 0.95rem;
                color: rgb(var(--text-secondary));
        }

        .analytics-consent__actions {
                display: flex;
                justify-content: flex-end;
                gap: 0.75rem;
        }

        .analytics-consent__button {
                border-radius: 999px;
                border: 1px solid transparent;
                padding: 0.5rem 1.25rem;
                font-weight: 600;
                cursor: pointer;
                transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.85));
                color: #fff;
                box-shadow: 0 0 18px rgba(124, 77, 255, 0.35);
        }

        .analytics-consent__button:focus-visible {
                outline: 3px solid rgba(124, 77, 255, 0.35);
                outline-offset: 2px;
        }

        .analytics-consent__button--ghost {
                background: rgba(21, 25, 43, 0.9);
                color: rgb(var(--text-secondary));
                border-color: rgba(124, 133, 178, 0.25);
        }

        .analytics-consent__button--ghost:hover,
        .analytics-consent__button--ghost:focus-visible {
                background: rgba(124, 77, 255, 0.18);
                color: rgb(var(--text-primary));
        }

        .analytics-consent__button:not(.analytics-consent__button--ghost):hover,
        .analytics-consent__button:not(.analytics-consent__button--ghost):focus-visible {
                background: var(--accent-dark);
                box-shadow: 0 0 26px rgba(124, 77, 255, 0.5);
        }

        @media (max-width: 720px) {
                .analytics-consent {
                        bottom: 1rem;
                }

                .analytics-consent__content {
                        padding: 1.4rem;
                }
        }
</style>
