---
import NavLink from '../marketing/NavLink.astro';
---

<nav class="portal-nav" aria-label="Navigasi portal klien">
        <div class="portal-nav__header">
                <span class="logo-burst" aria-hidden="true"></span>
                <p class="portal-nav__title">Area Klien</p>
                <p class="portal-nav__subtitle">Kelola proyek dan layanan secara terpadu</p>
        </div>
        <ul>
                <li><NavLink class="inverse" href="/portal/dashboard">Dashboard</NavLink></li>
                <li><NavLink class="inverse" href="/portal/projects">Proyek</NavLink></li>
                <li><NavLink class="inverse" href="/portal/packages">Paket</NavLink></li>
                <li><NavLink class="inverse" href="/portal/billing">Invoice &amp; Pembayaran</NavLink></li>
                <li><NavLink class="inverse" href="/portal/support">Dukungan</NavLink></li>
                <li><NavLink class="inverse" href="/portal/knowledge-base">Knowledge Base</NavLink></li>
                <li><NavLink class="inverse" href="/portal/tutorials">Tutorial</NavLink></li>
                <li><NavLink class="inverse" href="/portal/account">Akun</NavLink></li>
        </ul>
</nav>

<style>
        .portal-nav {
                background: transparent;
                color: #f5f7fb;
                padding: clamp(1.5rem, 4vw, 2.25rem) clamp(1.4rem, 4vw, 2.25rem);
                display: grid;
                gap: clamp(1.5rem, 4vw, 2.2rem);
        }

        .portal-nav__header {
                position: relative;
                padding: 1rem 1.25rem;
                border-radius: 1.25rem;
                background: rgba(20, 24, 38, 0.75);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: 0 0 24px rgba(124, 77, 255, 0.18);
                overflow: hidden;
        }

        .logo-burst {
                position: absolute;
                inset: -30% auto auto -30%;
                width: 160px;
                height: 160px;
                background: radial-gradient(circle, rgba(124, 77, 255, 0.4), transparent 70%);
                filter: blur(8px);
                opacity: 0.8;
        }

        .portal-nav__title {
                margin: 0;
                font-size: 1rem;
                font-weight: 700;
                letter-spacing: 0.08em;
                text-transform: uppercase;
        }

        .portal-nav__subtitle {
                margin: 0.4rem 0 0;
                font-size: 0.85rem;
                color: rgba(245, 247, 251, 0.65);
        }

        ul {
                margin: 0;
                padding: 0;
                list-style: none;
                display: grid;
                gap: 0.4rem;
        }

        li {
                display: block;
        }

        a {
                color: inherit;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                width: 100%;
                padding: 0.65rem 1rem;
                border-radius: 0.95rem;
                transition: background var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
        }

        a:hover,
        a:focus-visible,
        a.active {
                background: rgba(124, 77, 255, 0.18);
                box-shadow: 0 0 18px rgba(124, 77, 255, 0.28);
                text-decoration: none;
        }
</style>
