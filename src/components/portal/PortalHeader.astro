---
// ==========================================================================
// AstroPro Digital - Portal Header Component
// Header dengan breadcrumbs dan user menu untuk portal klien
// ==========================================================================

import type { UserProfile } from '../../types';
import Icon from '../ui/Icon.astro';

interface Props {
  title?: string;
  subtitle?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  user?: UserProfile;
  showNotifications?: boolean;
  class?: string;
}

const {
  title = "Portal Klien",
  subtitle,
  breadcrumbs = [],
  user,
  showNotifications = true,
  class: className = ""
} = Astro.props;
---

<header class={`portal-header ${className}`}>
  <div class="portal-header__content">
    <!-- Breadcrumbs -->
    {breadcrumbs.length > 0 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumbs__list">
          {breadcrumbs.map((crumb, index) => (
            <li class="breadcrumbs__item">
              {index === breadcrumbs.length - 1 ? (
                <span class="breadcrumbs__current" aria-current="page">
                  {crumb.label}
                </span>
              ) : (
                <a href={crumb.href} class="breadcrumbs__link">
                  {crumb.label}
                </a>
              )}
              {index < breadcrumbs.length - 1 && (
                <span class="breadcrumbs__separator" aria-hidden="true">→</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Page Title -->
    <div class="portal-header__title">
      <h1 class="page-title">{title}</h1>
      {subtitle && <p class="page-subtitle">{subtitle}</p>}
    </div>

    <!-- User Actions -->
    <div class="portal-header__actions">
      {showNotifications && (
        <button class="notification-btn" aria-label="Notifikasi">
          <span class="notification-btn__icon"><Icon name="notification" size={20} /></span>
          <span class="notification-btn__badge">3</span>
        </button>
      )}

      {user && (
        <div class="user-menu">
          <button
            class="user-menu__trigger"
            aria-label="Menu pengguna"
            aria-haspopup="true"
            aria-expanded="false"
            id="user-menu-trigger"
          >
            {user.avatar_url ? (
              <img src={user.avatar_url} alt={user.full_name} class="user-avatar" />
            ) : (
              <div class="user-avatar user-avatar--initial">
                {user.full_name.charAt(0).toUpperCase()}
              </div>
            )}
            <span class="user-menu__name">{user.full_name}</span>
          </button>

          <div
            class="user-menu__dropdown"
            role="menu"
            aria-labelledby="user-menu-trigger"
            hidden
          >
            <a href="/portal/account" class="user-menu__item" role="menuitem">
              <span class="user-menu__item-icon"><Icon name="user" size={16} /></span>
              Profil Akun
            </a>
            <a href="/portal/account/settings" class="user-menu__item" role="menuitem">
              <span class="user-menu__item-icon"><Icon name="settings-gear" size={16} /></span>
              Pengaturan
            </a>
            <a href="/portal/support" class="user-menu__item" role="menuitem">
              <span class="user-menu__item-icon"><Icon name="support" size={16} /></span>
              Dukungan
            </a>
            <hr class="user-menu__divider" />
            <button class="user-menu__item user-menu__logout" role="menuitem">
              <span class="user-menu__item-icon"><Icon name="logout" size={16} /></span>
              Keluar
            </button>
          </div>
        </div>
      )}
    </div>
  </div>
</header>

<style>
  .portal-header {
    background: var(--gradient-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) var(--space-6);
  }

  .portal-header__content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .portal-header__title {
    flex: 1;
  }

  .page-title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    margin: 0;
    color: var(--color-text-primary);
  }

  .page-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin: var(--space-1) 0 0 0;
  }

  .portal-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  /* Breadcrumbs */
  .breadcrumbs {
    margin-bottom: var(--space-2);
  }

  .breadcrumbs__list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .breadcrumbs__link {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus-visible {
    color: var(--color-primary);
    background: rgba(124, 58, 237, 0.1);
  }

  .breadcrumbs__current {
    color: var(--color-text-primary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .breadcrumbs__separator {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  /* Notification Button */
  .notification-btn {
    position: relative;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: transparent;
    color: var(--color-text-secondary);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .notification-btn:hover,
  .notification-btn:focus-visible {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-primary);
  }

  .notification-btn__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
  }

  .notification-btn__badge {
    position: absolute;
    top: 0.25rem;
    right: 0.25rem;
    background: var(--color-danger);
    color: white;
    font-size: 0.75rem;
    font-weight: var(--font-bold);
    padding: 0 0.375rem;
    border-radius: var(--radius-full);
    min-width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* User Menu */
  .user-menu {
    position: relative;
  }

  .user-menu__trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-decoration: none;
    cursor: pointer;
    transition: all var(--transition-base);
  }

  .user-menu__trigger:hover,
  .user-menu__trigger:focus-visible {
    border-color: var(--color-primary);
    background: rgba(124, 58, 237, 0.05);
  }

  .user-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    object-fit: cover;
  }

  .user-avatar--initial {
    background: var(--gradient-primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
  }

  .user-menu__name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .user-menu__dropdown {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2);
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all var(--transition-base);
    z-index: 1000;
  }

  .user-menu__dropdown[hidden] {
    display: none;
  }

  .user-menu__dropdown:not([hidden]) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .user-menu__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    text-decoration: none;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    background: transparent;
    border: none;
    cursor: pointer;
    width: 100%;
    text-align: left;
  }

  .user-menu__item-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
  }

  .user-menu__item:hover,
  .user-menu__item:focus-visible {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-primary);
  }

  .user-menu__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-2) calc(-1 * var(--space-2));
  }

  .user-menu__logout {
    color: var(--color-error);
  }

  .user-menu__logout:hover,
  .user-menu__logout:focus-visible {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-error);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .portal-header {
      padding: var(--space-3) var(--space-4);
    }

    .portal-header__content {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .portal-header__actions {
      align-self: flex-end;
    }

    .page-title {
      font-size: var(--text-xl);
    }

    .user-menu__name {
      max-width: 100px;
    }
  }

  @media (max-width: 480px) {
    .portal-header__actions {
      flex-direction: column;
      align-items: flex-end;
      gap: var(--space-2);
    }

    .user-menu__trigger {
      padding: var(--space-1) var(--space-2);
    }

    .user-menu__name {
      display: none;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .breadcrumbs__link,
    .notification-btn,
    .user-menu__trigger,
    .user-menu__item,
    .user-menu__dropdown {
      transition: none;
    }

    .user-menu__dropdown {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .portal-header {
      border-bottom-width: 2px;
    }

    .user-menu__trigger,
    .notification-btn {
      border-width: 2px;
    }
  }

  /* Focus Styles for Accessibility */
  .notification-btn:focus-visible,
  .user-menu__trigger:focus-visible,
  .user-menu__item:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>

<script>
  // Handle user menu dropdown
  document.addEventListener('DOMContentLoaded', () => {
    const userMenu = document.querySelector('.user-menu');
    const userMenuTrigger = document.getElementById('user-menu-trigger') as HTMLButtonElement;
    const userMenuDropdown = document.querySelector('.user-menu__dropdown') as HTMLDivElement;
    const logoutButton = document.querySelector('.user-menu__logout');

    const toggleDropdown = () => {
      const isExpanded = userMenuTrigger?.getAttribute('aria-expanded') === 'true';
      userMenuTrigger?.setAttribute('aria-expanded', String(!isExpanded));

      if (userMenuDropdown) {
        userMenuDropdown.hidden = isExpanded;
      }

      if (!isExpanded) {
        const firstItem = userMenuDropdown?.querySelector('.user-menu__item') as HTMLElement;
        firstItem?.focus();
      } else {
        userMenuTrigger?.focus();
      }
    };

    const closeDropdown = () => {
      userMenuTrigger?.setAttribute('aria-expanded', 'false');

      if (userMenuDropdown) {
        userMenuDropdown.hidden = true;
      }
    };

    if (userMenuTrigger && userMenuDropdown) {
      // Click handler for toggle
      userMenuTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        toggleDropdown();
      });

      // Keyboard handlers
      userMenuTrigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
          e.preventDefault();
          toggleDropdown();
        }
      });

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        const isClickInsideMenu = userMenu?.contains(e.target as Node);

        if (!isClickInsideMenu && userMenuDropdown && !userMenuDropdown.hidden) {
          closeDropdown();
        }
      });

      // Close dropdown on Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && userMenuDropdown && !userMenuDropdown.hidden) {
          e.preventDefault();
          closeDropdown();
        }
      });

      // Handle logout button
      if (logoutButton) {
        logoutButton.addEventListener('click', async (e) => {
          e.preventDefault();

          try {
            const response = await fetch('/api/auth/logout', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
            });

            if (response.ok) {
              window.location.href = '/login';
            } else {
              console.error('Logout failed');
            }
          } catch (error) {
            console.error('Logout error:', error);
          }
        });
      }

      // Focus trap within dropdown
      userMenuDropdown.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeDropdown();
        }

        if (e.key === 'Tab') {
          const focusableItems = Array.from(
            userMenuDropdown.querySelectorAll('.user-menu__item[href], .user-menu__item[role="menuitem"]')
          ).filter((item) => {
            const el = item as HTMLElement;
            return el.offsetParent !== null;
          });

          const activeElement = document.activeElement as HTMLElement;
          const currentIndex = focusableItems.indexOf(activeElement);

          if (e.shiftKey && currentIndex === 0) {
            e.preventDefault();
            const lastItem = focusableItems[focusableItems.length - 1] as HTMLElement;
            lastItem?.focus();
          } else if (!e.shiftKey && currentIndex === focusableItems.length - 1) {
            e.preventDefault();
            const firstItem = focusableItems[0] as HTMLElement;
            firstItem?.focus();
          }
        }
      });
    }
  });
</script>