---
// ==========================================================================
// AstroPro Digital - Portal Project Card Component
// Kartu proyek untuk portal klien dengan informasi lengkap
// ==========================================================================

import type { Project, UserProfile } from '../../types';

interface Props {
  project: Project;
  variant?: 'default' | 'compact' | 'detailed';
  showActions?: boolean;
  class?: string;
}

const {
  project,
  variant = 'default',
  showActions = true,
  class: className = ""
} = Astro.props;

// Calculate progress color based on status
const getProgressColor = (status: Project['status'], progress: number) => {
  if (status === 'completed') return 'success';
  if (status === 'on_hold') return 'warning';
  if (status === 'cancelled') return 'danger';
  if (progress >= 80) return 'success';
  if (progress >= 50) return 'primary';
  return 'secondary';
};

// Format currency
const formatCurrency = (amount: number) => {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    minimumFractionDigits: 0,
    maximumFractionDigits: 0,
  }).format(amount);
};

// Get status label in Indonesian
const getStatusLabel = (status: Project['status']) => {
  const statusMap = {
    active: 'Aktif',
    completed: 'Selesai',
    on_hold: 'Ditunda',
    cancelled: 'Dibatalkan'
  };
  return statusMap[status] || status;
};

// Get priority label in Indonesian
const getPriorityLabel = (priority: Project['priority']) => {
  const priorityMap = {
    low: 'Rendah',
    medium: 'Sedang',
    high: 'Tinggi',
    urgent: 'Darurat'
  };
  return priorityMap[priority] || priority;
};
---

<div class={`project-card project-card--${variant} ${className}`}>
  <div class="project-card__header">
    <div class="project-card__title-section">
      <h3 class="project-card__title">
        <a href={`/portal/projects/${project.id}`} class="project-card__link">
          {project.title}
        </a>
      </h3>
      <div class="project-card__badges">
        <span class={`badge badge--${project.status}`}>
          {getStatusLabel(project.status)}
        </span>
        <span class={`badge badge--${project.priority}`}>
          {getPriorityLabel(project.priority)}
        </span>
      </div>
    </div>

    {variant !== 'compact' && (
      <div class="project-card__budget">
        {formatCurrency(project.budget)}
      </div>
    )}
  </div>

  {variant !== 'compact' && (
    <div class="project-card__body">
      <p class="project-card__description">
        {project.description}
      </p>

      <div class="project-card__progress">
        <div class="progress-bar">
          <div
            class={`progress-bar__fill progress-bar--${getProgressColor(project.status, project.progress)}`}
            style={`width: ${project.progress}%`}
            role="progressbar"
            aria-valuenow={project.progress}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label={`Progres proyek: ${project.progress}%`}
          ></div>
        </div>
        <span class="progress-text">{project.progress}%</span>
      </div>

      <div class="project-card__meta">
        <div class="project-card__client">
          <span class="meta-label">Klien:</span>
          <span class="meta-value">{project.client?.name || 'Tidak ada klien'}</span>
        </div>

        <div class="project-card__due-date">
          <span class="meta-label">Deadline:</span>
          <span class={`meta-value ${new Date(project.due_date) < new Date() && project.status === 'active' ? 'overdue' : ''}`}>
            {new Date(project.due_date).toLocaleDateString('id-ID')}
          </span>
        </div>
      </div>

      {project.team_members && project.team_members.length > 0 && (
        <div class="project-card__team">
          <span class="meta-label">Tim:</span>
          <div class="team-avatars">
            {project.team_members.slice(0, 3).map((member) => (
              <div class="team-avatar" title={member.user?.full_name || member.role}>
                {member.user?.avatar_url ? (
                  <img src={member.user.avatar_url} alt={member.user.full_name} />
                ) : (
                  <span class="avatar-initial">
                    {(member.user?.full_name || member.role).charAt(0).toUpperCase()}
                  </span>
                )}
              </div>
            ))}
            {project.team_members.length > 3 && (
              <div class="team-avatar team-avatar--more" title={`+${project.team_members.length - 3} lainnya`}>
                +{project.team_members.length - 3}
              </div>
            )}
          </div>
        </div>
      )}

      {project.tags && project.tags.length > 0 && (
        <div class="project-card__tags">
          {project.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  )}

  {showActions && (
    <div class="project-card__actions">
      <a href={`/portal/projects/${project.id}`} class="btn btn--sm btn--primary">
        Lihat Detail
      </a>
      <button class="btn btn--sm btn--ghost">
        Edit
      </button>
    </div>
  )}
</div>

<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--transition-base);
  }

  .project-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
    box-shadow: var(--shadow-sm);
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .project-card__title-section {
    flex: 1;
  }

  .project-card__title {
    margin: 0 0 var(--space-2) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .project-card__link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .project-card__link:hover,
  .project-card__link:focus-visible {
    color: var(--color-primary);
  }

  .project-card__badges {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .badge {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge--active {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
  }

  .badge--completed {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-primary);
  }

  .badge--on_hold {
    background: rgba(245, 158, 11, 0.1);
    color: var(--color-warning);
  }

  .badge--cancelled {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-error);
  }

  .badge--low {
    background: rgba(156, 163, 175, 0.1);
    color: var(--color-text-secondary);
  }

  .badge--medium {
    background: rgba(59, 130, 246, 0.1);
    color: var(--color-info);
  }

  .badge--high {
    background: rgba(245, 101, 101, 0.1);
    color: rgb(245, 101, 101);
  }

  .badge--urgent {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-error);
  }

  .project-card__budget {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-primary);
  }

  .project-card__body {
    margin-bottom: var(--space-4);
  }

  .project-card__description {
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-4) 0;
    line-height: var(--leading-relaxed);
  }

  .project-card__progress {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .progress-bar {
    flex: 1;
    height: 0.5rem;
    background: var(--color-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-bar__fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width var(--transition-base);
  }

  .progress-bar--success {
    background: var(--color-success);
  }

  .progress-bar--primary {
    background: var(--gradient-primary);
  }

  .progress-bar--warning {
    background: var(--color-warning);
  }

  .progress-bar--danger {
    background: var(--color-error);
  }

  .progress-bar--secondary {
    background: var(--color-text-secondary);
  }

  .progress-text {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    min-width: 2.5rem;
    text-align: right;
  }

  .project-card__meta {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .meta-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-value {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .meta-value.overdue {
    color: var(--color-danger);
    font-weight: var(--font-medium);
  }

  .project-card__team {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .team-avatars {
    display: flex;
    gap: var(--space-1);
  }

  .team-avatar {
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-full);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    background: var(--color-border);
    color: var(--color-text-secondary);
  }

  .team-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-initial {
    background: var(--gradient-primary);
    color: white;
  }

  .team-avatar--more {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .project-card__tags {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .tag {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-primary);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }

  .project-card__actions {
    display: flex;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all var(--transition-base);
    white-space: nowrap;
  }

  .btn--sm {
    padding: var(--space-1) var(--space-2);
    font-size: var(--text-xs);
  }

  .btn--primary {
    background: var(--gradient-primary);
    color: white;
  }

  .btn--primary:hover,
  .btn--primary:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--shadow-gradient);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .btn--ghost:hover,
  .btn--ghost:focus-visible {
    background: rgba(124, 58, 237, 0.1);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  /* Variants */
  .project-card--compact {
    padding: var(--space-4);
  }

  .project-card--compact .project-card__header {
    margin-bottom: var(--space-2);
  }

  .project-card--compact .project-card__body {
    margin-bottom: var(--space-2);
  }

  .project-card--detailed {
    border: 2px solid transparent;
  }

  .project-card--detailed:hover {
    border-color: var(--color-primary);
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .project-card {
      padding: var(--space-4);
    }

    .project-card__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .project-card__actions {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .btn,
    .progress-bar__fill {
      transition: none;
    }

    .btn:hover,
    .btn:focus-visible {
      transform: none;
    }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    .project-card {
      border-width: 2px;
    }

    .badge,
    .tag {
      border: 1px solid currentColor;
    }
  }

  /* Focus Styles for Accessibility */
  .project-card__link:focus-visible,
  .btn:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring-color);
    outline-offset: var(--focus-ring-offset);
  }
</style>