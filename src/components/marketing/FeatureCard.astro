---
import type { astroHTML } from 'astro/types';

interface FeatureCardProps extends astroHTML.JSX.HTMLAttributes<'article'> {
    title: string;
    description: string;
    icon?: string;
    image?: string;
    benefits?: string[];
    ctaText?: string;
    ctaHref?: string;
    variant?: 'default' | 'compact' | 'detailed';
    orientation?: 'left' | 'right' | 'center';
}

const {
    title,
    description,
    icon,
    image,
    benefits = [],
    ctaText,
    ctaHref,
    variant = 'default',
    orientation = 'center',
    class: customClass = '',
    ...rest
} = Astro.props as FeatureCardProps & Record<string, unknown>;

const classes = [
    'feature-card',
    `feature-card--${variant}`,
    `feature-card--${orientation}`,
    typeof customClass === 'string' ? customClass : ''
].filter(Boolean).join(' ');

// Icon mapping untuk berbagai fitur
const getIcon = (iconName?: string): string => {
    const icons: Record<string, string> = {
        'rocket': '🚀',
        'shield': '🛡️',
        'zap': '⚡',
        'users': '👥',
        'chart': '📊',
        'lock': '🔒',
        'globe': '🌐',
        'payment': '💳',
        'support': '🎧',
        'automation': '🤖',
        'analytics': '📈',
        'integration': '🔗',
        'default': '✨'
    };
    return icons[iconName || 'default'] || icons.default;
};

// Benefit icons untuk list
const getBenefitIcon = (index: number): string => {
    const icons = ['✅', '🎯', '💡', '🔥', '⭐'];
    return icons[index % icons.length];
};
---

<article class={`feature-card ${classes}`} {...rest}>
    <div class="feature-card__visual">
        {image ? (
            <div class="feature-card__image-wrapper">
                <img
                    src={image}
                    alt=""
                    class="feature-card__image"
                    loading="lazy"
                />
                <div class="feature-card__image-overlay"></div>
            </div>
        ) : (
            <div class="feature-card__icon-wrapper">
                <div class="feature-card__icon" aria-hidden="true">
                    {getIcon(icon)}
                </div>
                <div class="feature-card__icon-bg"></div>
            </div>
        )}
    </div>

    <div class="feature-card__content">
        <header class="feature-card__header">
            <h3 class="feature-card__title">{title}</h3>
            <p class="feature-card__description">{description}</p>
        </header>

        {benefits.length > 0 && (
            <div class="feature-card__benefits">
                <ul class="benefits-list">
                    {benefits.map((benefit, index) => (
                        <li class="benefits-list__item">
                            <span class="benefits-list__icon" aria-hidden="true">
                                {getBenefitIcon(index)}
                            </span>
                            <span class="benefits-list__text">{benefit}</span>
                        </li>
                    ))}
                </ul>
            </div>
        )}

        {ctaText && ctaHref && (
            <div class="feature-card__cta">
                <a href={ctaHref} class="feature-card__cta-btn">
                    {ctaText}
                    <span class="feature-card__cta-icon" aria-hidden="true">→</span>
                </a>
            </div>
        )}
    </div>
</article>

<style>
    .feature-card {
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.75rem, 3vw, 2.75rem);
        padding: clamp(2.5rem, 4vw, 3.25rem);
        border-radius: var(--radius-2xl);
        background: linear-gradient(155deg, rgba(6, 12, 32, 0.92) 0%, rgba(17, 26, 48, 0.82) 55%, rgba(24, 32, 56, 0.85) 100%);
        border: 1px solid rgba(56, 189, 248, 0.16);
        box-shadow: 0 18px 40px rgba(2, 6, 23, 0.45);
        position: relative;
        overflow: hidden;
        transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    }

    .feature-card::before {
        content: '';
        position: absolute;
        inset: -30% -25% auto;
        height: 200px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.18), transparent 70%);
        opacity: 0.45;
        pointer-events: none;
        transition: opacity var(--transition-base), transform var(--transition-base);
    }

    .feature-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: 1px solid rgba(147, 51, 234, 0.12);
        pointer-events: none;
    }

    .feature-card:hover,
    .feature-card:focus-within {
        transform: translateY(-4px);
        box-shadow: 0 24px 44px rgba(2, 6, 23, 0.5);
        border-color: rgba(56, 189, 248, 0.3);
    }

    .feature-card:hover::before,
    .feature-card:focus-within::before {
        opacity: 0.7;
        transform: translate3d(0, -6px, 0) scale(1.03);
    }

    .feature-card--compact {
        padding: clamp(2rem, 3vw, 2.5rem);
        gap: var(--space-5);
    }

    .feature-card--detailed {
        padding: clamp(3rem, 5vw, 3.75rem);
        gap: var(--space-8);
    }

    .feature-card--left {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
        align-items: center;
        text-align: left;
    }

    .feature-card--right {
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        align-items: center;
        text-align: right;
    }

    .feature-card--right .feature-card__visual {
        order: 2;
    }

    .feature-card--center {
        text-align: center;
    }

    .feature-card__visual {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    .feature-card__icon-wrapper {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        isolation: isolate;
    }

    .feature-card__icon {
        width: clamp(4rem, 6vw, 5rem);
        height: clamp(4rem, 6vw, 5rem);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: clamp(2rem, 3vw, 2.6rem);
        border-radius: var(--radius-2xl);
        background: linear-gradient(135deg, rgba(147, 51, 234, 0.45), rgba(56, 189, 248, 0.35));
        color: var(--color-text-primary);
        box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.24), 0 12px 24px rgba(2, 6, 23, 0.45);
        position: relative;
        z-index: 1;
    }

    .feature-card__icon-bg {
        position: absolute;
        inset: -28px;
        border-radius: inherit;
        background: radial-gradient(circle, rgba(147, 51, 234, 0.32), transparent 70%);
        filter: blur(12px);
        opacity: 0.45;
        z-index: 0;
    }

    .feature-card__image-wrapper {
        position: relative;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: 0 16px 32px rgba(2, 6, 23, 0.45);
    }

    .feature-card__image {
        width: 100%;
        height: auto;
        display: block;
        transition: transform var(--transition-slow);
    }

    .feature-card__image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(160deg, rgba(56, 189, 248, 0.25), transparent 60%);
        opacity: 0;
        transition: opacity var(--transition-base);
    }

    .feature-card:hover .feature-card__image {
        transform: scale(1.05);
    }

    .feature-card:hover .feature-card__image-overlay {
        opacity: 1;
    }

    .feature-card__content {
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 2.5vw, 2.25rem);
        position: relative;
        z-index: 1;
    }

    .feature-card__header {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .feature-card__title {
        font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.65rem);
        margin: 0;
        color: var(--color-text-primary);
        letter-spacing: 0.015em;
        text-shadow: 0 0 20px rgba(147, 51, 234, 0.25);
    }

    .feature-card__description {
        margin: 0;
        color: rgba(var(--text-secondary), 0.85);
        font-size: var(--text-base);
        line-height: var(--leading-relaxed);
    }

    .feature-card__benefits {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .benefits-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: var(--space-3);
    }

    .benefits-list__item {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--space-2);
        align-items: center;
        font-size: var(--text-sm);
        color: rgba(var(--text-secondary), 0.8);
    }

    .benefits-list__icon {
        width: 30px;
        height: 30px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.18), rgba(147, 51, 234, 0.18));
        display: grid;
        place-items: center;
        font-size: 0.95rem;
        color: var(--accent-color);
        box-shadow: inset 0 0 0 1px rgba(147, 51, 234, 0.18);
    }

    .feature-card__cta {
        display: flex;
        justify-content: flex-start;
    }

    .feature-card__cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        padding: var(--space-3) var(--space-5);
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.16), rgba(147, 51, 234, 0.16));
        color: var(--color-text-primary);
        text-decoration: none;
        border: 1px solid rgba(var(--accent-rgb), 0.35);
        transition: all var(--transition-base);
        box-shadow: inset 0 0 0 1px rgba(147, 51, 234, 0.18);
    }

    .feature-card__cta-btn:hover,
    .feature-card__cta-btn:focus-visible {
        background: var(--accent-gradient);
        color: var(--color-text-primary);
        transform: translateY(-2px);
        box-shadow: 0 14px 24px rgba(8, 15, 32, 0.45);
        outline: none;
    }

    .feature-card__cta-icon {
        font-size: 1.25rem;
    }

    @media (max-width: 1080px) {
        .feature-card--left,
        .feature-card--right {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .feature-card--right .feature-card__visual {
            order: 0;
        }

        .feature-card__cta {
            justify-content: center;
        }
    }

    @media (max-width: 720px) {
        .feature-card {
            padding: var(--space-5);
        }

        .feature-card__title {
            font-size: clamp(1.2rem, 1.05rem + 1vw, 1.45rem);
        }

        .feature-card__description {
            font-size: var(--text-sm);
        }
    }
</style>
