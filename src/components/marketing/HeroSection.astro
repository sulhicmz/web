---
import type { astroHTML } from 'astro/types';

interface HeroSectionProps extends astroHTML.JSX.HTMLAttributes<'section'> {
    title: string;
    subtitle: string;
    primaryCTA: {
        text: string;
        href: string;
    };
    secondaryCTA?: {
        text: string;
        href: string;
    };
    backgroundPattern?: 'gradient' | 'dots' | 'mesh';
}

const {
    title,
    subtitle,
    primaryCTA,
    secondaryCTA,
    backgroundPattern = 'gradient',
    class: customClass = '',
    ...rest
} = Astro.props as HeroSectionProps & Record<string, unknown>;

const classes = [
    'hero-section',
    `hero-section--${backgroundPattern}`,
    typeof customClass === 'string' ? customClass : ''
].filter(Boolean).join(' ');

// Animation delay helpers untuk staggered animations
const getAnimationDelay = (index: number): string => `${index * 0.1}s`;
---

<section class={`hero-section ${classes}`} {...rest}>
    <div class="hero-section__background">
        <div class="hero-bg-shape hero-bg-shape--1" aria-hidden="true"></div>
        <div class="hero-bg-shape hero-bg-shape--2" aria-hidden="true"></div>
        <div class="hero-bg-shape hero-bg-shape--3" aria-hidden="true"></div>
        <div class="hero-section__halo" aria-hidden="true"></div>
    </div>

    <div class="hero-section__container">
        <div class="hero-section__content">
            <div class="hero-section__text">
                <h1 class="hero-section__title">
                    <span class="hero-section__title-line" style={`animation-delay: ${getAnimationDelay(0)}`}>
                        {title}
                    </span>
                </h1>

                <p class="hero-section__subtitle" style={`animation-delay: ${getAnimationDelay(1)}`}>
                    {subtitle}
                </p>

                <div class="hero-section__cta" style={`animation-delay: ${getAnimationDelay(2)}`}>
                    <a href={primaryCTA.href} class="btn btn--hero-primary">
                        {primaryCTA.text}
                        <span class="btn__icon" aria-hidden="true">→</span>
                    </a>

                    {secondaryCTA && (
                        <a href={secondaryCTA.href} class="btn btn--hero-secondary">
                            {secondaryCTA.text}
                        </a>
                    )}
                </div>
            </div>

            <div class="hero-section__features" style={`animation-delay: ${getAnimationDelay(3)}`}>
                <div class="feature-highlight">
                    <div class="feature-highlight__icon" aria-hidden="true">⚡</div>
                    <div class="feature-highlight__content">
                        <div class="feature-highlight__title">Setup Cepat</div>
                        <div class="feature-highlight__desc">Deploy dalam hitungan menit</div>
                    </div>
                </div>

                <div class="feature-highlight">
                    <div class="feature-highlight__icon" aria-hidden="true">🔒</div>
                    <div class="feature-highlight__content">
                        <div class="feature-highlight__title">Enterprise Security</div>
                        <div class="feature-highlight__desc">RBAC dan enkripsi end-to-end</div>
                    </div>
                </div>

                <div class="feature-highlight">
                    <div class="feature-highlight__icon" aria-hidden="true">💳</div>
                    <div class="feature-highlight__content">
                        <div class="feature-highlight__title">Payment Ready</div>
                        <div class="feature-highlight__desc">Midtrans terintegrasi</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-section__scroll-indicator" aria-hidden="true">
        <div class="scroll-indicator">
            <div class="scroll-indicator__line"></div>
            <div class="scroll-indicator__text">Scroll</div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        position: relative;
        min-height: 82vh;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: radial-gradient(circle at 15% 15%, rgba(147, 51, 234, 0.25), transparent 50%),
            radial-gradient(circle at 85% 20%, rgba(34, 211, 238, 0.22), transparent 55%),
            linear-gradient(135deg, rgba(5, 7, 22, 0.98) 0%, rgba(8, 12, 32, 0.92) 45%, rgba(12, 20, 42, 0.9) 100%);
        border-radius: clamp(1.8rem, 3vw, 2.8rem);
        padding: clamp(2rem, 6vw, 3rem) 0;
    }

    .hero-section--gradient {
        background: linear-gradient(140deg, rgba(15, 23, 42, 0.95) 0%, rgba(12, 18, 36, 0.92) 40%, rgba(17, 26, 48, 0.85) 70%),
            radial-gradient(circle at 30% 20%, rgba(147, 51, 234, 0.4), transparent 55%),
            radial-gradient(circle at 80% 10%, rgba(34, 211, 238, 0.35), transparent 65%);
    }

    .hero-section--dots {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.9), rgba(8, 12, 30, 0.92));
        background-image: radial-gradient(circle at 1px 1px, rgba(148, 163, 184, 0.12) 1px, transparent 0);
        background-size: 18px 18px;
    }

    .hero-section--mesh {
        background: linear-gradient(135deg, rgba(12, 20, 42, 0.92), rgba(6, 10, 26, 0.95));
        background-image:
            linear-gradient(90deg, rgba(148, 163, 184, 0.06) 1px, transparent 1px),
            linear-gradient(rgba(148, 163, 184, 0.06) 1px, transparent 1px);
        background-size: 22px 22px;
    }

    .hero-section__background {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .hero-bg-shape {
        position: absolute;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.5), transparent 65%);
        backdrop-filter: blur(2px);
        animation: float 10s ease-in-out infinite alternate;
    }

    .hero-bg-shape--1 {
        width: clamp(160px, 20vw, 220px);
        height: clamp(160px, 20vw, 220px);
        top: 8%;
        left: 6%;
        animation-delay: 0s;
    }

    .hero-bg-shape--2 {
        width: clamp(120px, 18vw, 180px);
        height: clamp(120px, 18vw, 180px);
        top: 58%;
        right: 12%;
        animation-delay: 2s;
    }

    .hero-bg-shape--3 {
        width: clamp(120px, 16vw, 160px);
        height: clamp(120px, 16vw, 160px);
        bottom: 18%;
        left: 26%;
        animation-delay: 3.5s;
    }

    .hero-section__halo {
        position: absolute;
        inset: 10% 20% 15% 10%;
        border-radius: 50% / 35%;
        background: radial-gradient(circle at 50% 50%, rgba(147, 51, 234, 0.28), rgba(56, 189, 248, 0.12) 45%, transparent 70%);
        filter: blur(60px);
        opacity: 0.85;
        animation: haloPulse 18s ease-in-out infinite alternate;
    }

    .hero-section__container {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-6);
    }

    .hero-section__content {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        gap: clamp(2rem, 5vw, 3.75rem);
        align-items: center;
        min-height: 66vh;
        padding: clamp(2rem, 6vw, 2.8rem);
        border-radius: clamp(1.4rem, 3vw, 2.5rem);
        background: linear-gradient(135deg, rgba(9, 14, 32, 0.85) 0%, rgba(8, 15, 32, 0.82) 45%, rgba(17, 26, 48, 0.75) 100%);
        border: 1px solid rgba(56, 189, 248, 0.2);
        box-shadow: 0 30px 60px rgba(2, 6, 23, 0.55);
        backdrop-filter: blur(18px);
        position: relative;
        overflow: hidden;
    }

    .hero-section__content::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(56, 189, 248, 0.22), transparent 55%);
        opacity: 0.7;
        pointer-events: none;
    }

    .hero-section__text {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        position: relative;
        z-index: 1;
    }

    .hero-section__title {
        font-size: clamp(2.5rem, 2rem + 3vw, 3.75rem);
        margin: 0;
        position: relative;
        display: inline-block;
        line-height: 1.05;
    }

    .hero-section__title-line {
        display: inline-block;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: slideUp 0.6s ease-out;
        text-shadow: 0 0 30px rgba(147, 51, 234, 0.25);
    }

    .hero-section__subtitle {
        font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem);
        color: rgba(var(--text-secondary), 0.85);
        margin: 0;
        max-width: 560px;
        animation: slideUp 0.6s ease-out;
    }

    .hero-section__cta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        align-items: center;
    }

    .btn {
        min-width: 180px;
    }

    .btn--hero-primary {
        background: var(--accent-gradient);
        border-radius: var(--radius-full);
        padding: var(--space-3) var(--space-6);
        border: 1px solid rgba(var(--accent-rgb), 0.55);
        box-shadow: 0 18px 36px rgba(5, 12, 32, 0.45);
    }

    .btn--hero-primary .btn__icon {
        display: inline-flex;
        margin-left: var(--space-2);
        transition: transform var(--transition-fast);
    }

    .btn--hero-primary:hover .btn__icon {
        transform: translateX(4px);
    }

    .btn--hero-secondary {
        background: rgba(6, 12, 32, 0.72);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: var(--color-text-primary);
        border-radius: var(--radius-full);
        padding: var(--space-3) var(--space-6);
        transition: transform var(--transition-base), box-shadow var(--transition-base);
        box-shadow: inset 0 0 0 1px rgba(147, 51, 234, 0.18);
    }

    .btn--hero-secondary:hover {
        transform: translateY(-2px);
        box-shadow: var(--glow-secondary);
    }

    .hero-section__features {
        display: grid;
        gap: var(--space-4);
        background: linear-gradient(160deg, rgba(8, 12, 32, 0.82) 0%, rgba(17, 26, 48, 0.78) 100%);
        border-radius: var(--radius-xl);
        padding: var(--space-6);
        border: 1px solid rgba(56, 189, 248, 0.22);
        box-shadow: inset 0 0 0 1px rgba(147, 51, 234, 0.12);
        backdrop-filter: blur(12px);
        position: relative;
        z-index: 1;
    }

    .feature-highlight {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: var(--space-4);
        align-items: center;
    }

    .feature-highlight__icon {
        width: 44px;
        height: 44px;
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(147, 51, 234, 0.3), rgba(56, 189, 248, 0.25));
        display: grid;
        place-items: center;
        font-size: 1.5rem;
        box-shadow: inset 0 0 0 1px rgba(34, 211, 238, 0.25);
    }

    .feature-highlight__content {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .feature-highlight__title {
        font-weight: 600;
        color: var(--color-text-primary);
        letter-spacing: 0.02em;
    }

    .feature-highlight__desc {
        color: rgba(var(--text-secondary), 0.75);
        font-size: var(--text-sm);
    }

    .hero-section__scroll-indicator {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
    }

    .scroll-indicator {
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text-secondary);
        font-size: var(--text-xs);
        letter-spacing: 0.2em;
        text-transform: uppercase;
    }

    .scroll-indicator__line {
        width: 2px;
        height: 38px;
        background: rgba(148, 163, 184, 0.35);
        border-radius: var(--radius-full);
        overflow: hidden;
        position: relative;
    }

    .scroll-indicator__line::after {
        content: '';
        position: absolute;
        top: 4px;
        left: 50%;
        transform: translateX(-50%);
        width: 2px;
        height: 12px;
        border-radius: var(--radius-full);
        background: var(--accent-color);
        animation: scrollPulse 1.6s ease-in-out infinite;
    }

    .scroll-indicator__text {
        letter-spacing: 0.3em;
        font-weight: 600;
        opacity: 0.8;
    }

    @keyframes scrollPulse {
        0% {
            transform: translate(-50%, 0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, 12px);
            opacity: 1;
        }
        100% {
            transform: translate(-50%, 24px);
            opacity: 0;
        }
    }

    @keyframes float {
        0% {
            transform: translate3d(0, 0, 0) scale(1);
            opacity: 0.75;
        }
        50% {
            transform: translate3d(12px, -16px, 0) scale(1.05);
            opacity: 1;
        }
        100% {
            transform: translate3d(-8px, 10px, 0) scale(0.98);
            opacity: 0.7;
        }
    }

    @keyframes haloPulse {
        0% {
            transform: scale(0.98);
            opacity: 0.7;
        }
        50% {
            transform: scale(1.05);
            opacity: 0.85;
        }
        100% {
            transform: scale(1);
            opacity: 0.75;
        }
    }

    @media (max-width: 960px) {
        .hero-section__content {
            grid-template-columns: 1fr;
            text-align: center;
            gap: var(--space-8);
        }

        .hero-section__cta {
            justify-content: center;
        }

        .hero-section__subtitle {
            margin: 0 auto;
        }

        .hero-section__features {
            justify-items: center;
        }

        .feature-highlight {
            justify-items: center;
            text-align: center;
        }
    }

    @media (max-width: 720px) {
        .hero-section {
            min-height: 95vh;
            padding: var(--space-12) 0;
        }

        .hero-section__container {
            padding: 0 var(--space-4);
        }

        .hero-section__title {
            font-size: clamp(2.2rem, 1.8rem + 4vw, 3.2rem);
        }

        .hero-section__subtitle {
            font-size: clamp(1rem, 0.95rem + 0.5vw, 1.2rem);
        }

        .hero-section__cta {
            flex-direction: column;
            align-items: stretch;
            gap: var(--space-3);
        }

        .hero-section__cta .btn {
            width: 100%;
            justify-content: center;
        }

        .hero-section__features {
            padding: var(--space-5);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-bg-shape,
        .hero-section__halo,
        .scroll-indicator__line::after,
        .hero-section__title-line,
        .hero-section__subtitle,
        .hero-section__cta,
        .hero-section__features {
            animation: none !important;
        }
    }
</style>
