---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const baseUrl = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '');
const rawPathname = Astro.url.pathname;
const pathname = rawPathname.startsWith(baseUrl) ? rawPathname.slice(baseUrl.length) || '/' : rawPathname;
const subpath = pathname.match(/[^\/]+/g);
const isActive =
        href === pathname ||
        (href !== '/' && pathname.startsWith(href)) ||
        href === '/' + (subpath?.[0] || '');
---

<a href={href} class:list={["nav-link", className, { active: isActive }]} {...props}>
        <slot />
</a>
<style>
        .nav-link {
                display: inline-block;
                text-decoration: none;
                color: rgb(var(--text-secondary));
                font-weight: 500;
                padding: 0.38rem 0.95rem;
                border-radius: 999px;
                position: relative;
                transition: color var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
        }

        .nav-link.inverse {
                color: inherit;
        }

        .nav-link:hover,
        .nav-link:focus-visible {
                color: rgb(var(--text-primary));
                background: rgba(90, 209, 255, 0.16);
                box-shadow: 0 10px 18px rgba(42, 176, 255, 0.22);
        }

        .nav-link.active {
                font-weight: 700;
                color: rgb(var(--text-primary));
                background: rgba(90, 209, 255, 0.25);
                box-shadow: 0 12px 22px rgba(42, 176, 255, 0.25);
        }

        .nav-link.inverse:hover,
        .nav-link.inverse:focus-visible,
        .nav-link.inverse.active {
                color: #f5f7fb;
        }
</style>
