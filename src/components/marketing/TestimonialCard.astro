---
import type { astroHTML } from 'astro/types';

interface TestimonialCardProps extends astroHTML.JSX.HTMLAttributes<'article'> {
    quote: string;
    author: {
        name: string;
        role: string;
        company: string;
        avatar?: string;
    };
    rating?: number;
    metrics?: {
        label: string;
        value: string;
    }[];
    variant?: 'default' | 'compact' | 'featured';
}

const {
    quote,
    author,
    rating = 5,
    metrics = [],
    variant = 'default',
    class: customClass = '',
    ...rest
} = Astro.props as TestimonialCardProps & Record<string, unknown>;

const classes = [
    'testimonial-card',
    `testimonial-card--${variant}`,
    typeof customClass === 'string' ? customClass : ''
].filter(Boolean).join(' ');

// Generate stars untuk rating
const renderStars = (rating: number): string => {
    const fullStars = Math.floor(rating);
    const hasHalfStar = rating % 1 !== 0;
    const emptyStars = 5 - Math.ceil(rating);

    return '★'.repeat(fullStars) +
           (hasHalfStar ? '☆' : '') +
           '☆'.repeat(emptyStars);
};
---

<article class={`testimonial-card ${classes}`} {...rest}>
    <div class="testimonial-card__quote-mark" aria-hidden="true">"</div>

    {rating > 0 && (
        <div class="testimonial-card__rating">
            <div class="rating-stars" aria-label={`${rating} dari 5 bintang`}>
                {renderStars(rating).split('').map((star) => (
                    <span class={`rating-stars__star rating-stars__star--${star === '★' ? 'full' : 'empty'}`}>
                        {star}
                    </span>
                ))}
            </div>
        </div>
    )}

    <blockquote class="testimonial-card__quote">
        {quote}
    </blockquote>

    {metrics.length > 0 && (
        <div class="testimonial-card__metrics">
            {metrics.map((metric) => (
                <div class="testimonial-metric">
                    <div class="testimonial-metric__value">{metric.value}</div>
                    <div class="testimonial-metric__label">{metric.label}</div>
                </div>
            ))}
        </div>
    )}

    <footer class="testimonial-card__footer">
        <div class="testimonial-author">
            <div class="testimonial-author__avatar">
                {author.avatar ? (
                    <img src={author.avatar} alt={author.name} />
                ) : (
                    <div class="testimonial-author__avatar-fallback">
                        {author.name.charAt(0).toUpperCase()}
                    </div>
                )}
            </div>

            <div class="testimonial-author__info">
                <cite class="testimonial-author__name">{author.name}</cite>
                <div class="testimonial-author__title">
                    <span class="testimonial-author__role">{author.role}</span>
                    <span class="testimonial-author__company">di {author.company}</span>
                </div>
            </div>
        </div>
    </footer>

    <div class="testimonial-card__bg-decoration" aria-hidden="true"></div>
</article>

<style>
    .testimonial-card {
        display: flex;
        flex-direction: column;
        gap: clamp(1.5rem, 2.5vw, 2.25rem);
        padding: clamp(2.5rem, 4vw, 3.25rem);
        border-radius: var(--radius-2xl);
        background: linear-gradient(160deg, rgba(6, 12, 32, 0.78) 0%, rgba(17, 26, 48, 0.82) 55%, rgba(30, 40, 70, 0.85) 100%);
        border: 1px solid rgba(56, 189, 248, 0.18);
        box-shadow: 0 24px 50px rgba(2, 6, 23, 0.55);
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(16px);
        transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
    }

    .testimonial-card::before {
        content: '';
        position: absolute;
        inset: -35% -30% auto -10%;
        height: 260px;
        background: radial-gradient(circle, rgba(244, 114, 182, 0.25), transparent 70%);
        opacity: 0.65;
        pointer-events: none;
        transition: opacity var(--transition-base), transform var(--transition-base);
    }

    .testimonial-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        border: 1px solid rgba(147, 51, 234, 0.12);
        pointer-events: none;
    }

    .testimonial-card:hover,
    .testimonial-card:focus-within {
        transform: translateY(-6px);
        box-shadow: var(--glow-accent);
        border-color: rgba(244, 114, 182, 0.45);
    }

    .testimonial-card:hover::before,
    .testimonial-card:focus-within::before {
        opacity: 0.9;
        transform: translate3d(0, -12px, 0) scale(1.05);
    }

    .testimonial-card--compact {
        padding: clamp(2rem, 3vw, 2.4rem);
        gap: var(--space-3);
    }

    .testimonial-card--featured {
        padding: clamp(2.75rem, 4.5vw, 3.5rem);
        background: linear-gradient(150deg, rgba(147, 51, 234, 0.28) 0%, rgba(56, 189, 248, 0.22) 45%, rgba(244, 114, 182, 0.28) 100%);
        border: 1px solid rgba(244, 114, 182, 0.45);
        box-shadow: 0 30px 60px rgba(2, 6, 23, 0.6);
    }

    .testimonial-card__quote-mark {
        position: absolute;
        top: 1.5rem;
        left: 1.75rem;
        font-size: clamp(4rem, 6vw, 5.5rem);
        color: rgba(244, 114, 182, 0.55);
        opacity: 0.35;
        font-family: 'Georgia', serif;
        line-height: 1;
        pointer-events: none;
    }

    .testimonial-card__rating {
        display: flex;
        gap: var(--space-2);
        align-items: center;
    }

    .rating-stars {
        display: inline-flex;
        gap: var(--space-1);
    }

    .rating-stars__star {
        font-size: 1.2rem;
        color: #facc15;
        text-shadow: 0 0 12px rgba(250, 204, 21, 0.45);
    }

    .rating-stars__star--empty {
        color: rgba(250, 204, 21, 0.25);
    }

    .testimonial-card__quote {
        font-size: clamp(1.1rem, 1rem + 0.4vw, 1.35rem);
        line-height: var(--leading-relaxed);
        color: var(--color-text-primary);
        margin: 0;
        position: relative;
        z-index: 2;
        font-style: italic;
        text-shadow: 0 0 18px rgba(147, 51, 234, 0.18);
    }

    .testimonial-card__metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: var(--space-3);
    }

    .testimonial-metric {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-lg);
        background: rgba(15, 23, 42, 0.55);
        border: 1px solid rgba(56, 189, 248, 0.18);
        box-shadow: inset 0 0 0 1px rgba(147, 51, 234, 0.12);
    }

    .testimonial-metric__value {
        font-size: var(--text-xl);
        font-weight: var(--font-semibold);
        color: var(--color-text-primary);
    }

    .testimonial-metric__label {
        font-size: var(--text-xs);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: rgba(var(--text-secondary), 0.75);
    }

    .testimonial-card__footer {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        margin-top: var(--space-2);
    }

    .testimonial-author {
        display: flex;
        align-items: center;
        gap: var(--space-4);
    }

    .testimonial-author__avatar {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        overflow: hidden;
        position: relative;
        box-shadow: 0 12px 24px rgba(2, 6, 23, 0.55);
        border: 2px solid rgba(var(--accent-rgb), 0.45);
    }

    .testimonial-author__avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .testimonial-author__avatar-fallback {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        font-size: 1.5rem;
        font-weight: var(--font-semibold);
        color: var(--color-text-primary);
        background: linear-gradient(135deg, rgba(56, 189, 248, 0.25), rgba(147, 51, 234, 0.25));
    }

    .testimonial-author__name {
        font-style: normal;
        font-weight: var(--font-semibold);
        color: var(--color-text-primary);
    }

    .testimonial-author__title {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        color: rgba(var(--text-secondary), 0.75);
        font-size: var(--text-sm);
    }

    .testimonial-card__bg-decoration {
        position: absolute;
        inset: 15% -40% -20% 40%;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.25), transparent 70%);
        filter: blur(80px);
        opacity: 0.6;
        pointer-events: none;
    }

    @media (max-width: 960px) {
        .testimonial-card {
            padding: var(--space-6);
        }

        .testimonial-metric {
            align-items: center;
            text-align: center;
        }

        .testimonial-author {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .testimonial-card__footer {
            justify-content: center;
        }
    }

    @media (max-width: 720px) {
        .testimonial-card {
            padding: var(--space-5);
        }

        .testimonial-card__quote {
            font-size: clamp(1rem, 0.95rem + 0.4vw, 1.2rem);
        }
    }
</style>
