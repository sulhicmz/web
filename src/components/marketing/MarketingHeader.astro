---
import NavLink from './NavLink.astro';
import { SITE_TITLE, buildWhatsappLink } from '../../consts';
---

<header class="marketing-header" data-scroll-shadow>
        <nav class="marketing-nav" aria-label="Navigasi utama">
                <a class="brand" href="/">
                        <span class="brand-glow" aria-hidden="true"></span>
                        <span>{SITE_TITLE}</span>
                </a>
                <div class="nav-links">
                        <NavLink href="/">Beranda</NavLink>
                        <NavLink href="/layanan">Layanan</NavLink>
                        <NavLink href="/portofolio">Portofolio</NavLink>
                        <NavLink href="/blog">Blog</NavLink>
                        <NavLink href="/faq">FAQ</NavLink>
                        <NavLink href="/kontak">Kontak</NavLink>
                </div>
                <a class="cta" href={buildWhatsappLink()} rel="noreferrer" target="_blank">
                        Konsultasi Gratis
                </a>
        </nav>
</header>
<style>
        .marketing-header {
                margin: 0;
                padding: clamp(0.75rem, 2vw, 1.25rem) clamp(1.5rem, 6vw, 3rem);
                position: sticky;
                top: 0;
                z-index: 20;
                backdrop-filter: blur(18px);
                background: rgba(10, 12, 22, 0.75);
                border-bottom: 1px solid rgba(124, 133, 178, 0.12);
                box-shadow: 0 10px 35px rgba(6, 10, 26, 0.45);
                transition: background var(--transition-smooth), border var(--transition-smooth), box-shadow var(--transition-smooth);
        }

        .marketing-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
        }

        .brand {
                font-weight: 700;
                font-size: clamp(1rem, 2.2vw, 1.2rem);
                color: rgb(var(--text-primary));
                text-decoration: none;
                position: relative;
                display: inline-flex;
                align-items: center;
                gap: 0.65rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
        }

        .brand-glow {
                width: 10px;
                height: 10px;
                border-radius: 999px;
                background: radial-gradient(circle, var(--accent) 0%, rgba(124, 77, 255, 0.15) 70%);
                box-shadow: 0 0 12px rgba(124, 77, 255, 0.75), 0 0 22px rgba(0, 187, 255, 0.4);
                animation: glowPulse 3s ease-in-out infinite alternate;
        }

        .nav-links {
                display: flex;
                gap: 0.75rem;
                align-items: center;
                padding: 0.35rem;
                border-radius: 999px;
                background: rgba(21, 25, 43, 0.65);
                border: 1px solid rgba(124, 133, 178, 0.18);
                box-shadow: inset 0 0 16px rgba(16, 19, 32, 0.65);
        }

        .cta {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.6rem 1.4rem;
                border-radius: 999px;
                background: linear-gradient(120deg, var(--accent), rgba(0, 187, 255, 0.9));
                color: #fff;
                font-weight: 600;
                text-decoration: none;
                white-space: nowrap;
                border: 1px solid rgba(124, 77, 255, 0.4);
                box-shadow: 0 0 24px rgba(124, 77, 255, 0.45);
                transition: transform var(--transition-base), box-shadow var(--transition-base), filter var(--transition-base);
        }

        .cta:hover,
        .cta:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 0 34px rgba(124, 77, 255, 0.6);
                filter: saturate(1.15);
                outline: none;
        }

        @media (max-width: 960px) {
                .marketing-nav {
                        flex-wrap: wrap;
                }

                .nav-links {
                        width: 100%;
                        justify-content: center;
                        flex-wrap: wrap;
                        gap: 0.35rem;
                }

                .cta {
                        width: 100%;
                        justify-content: center;
                        margin-top: 0.75rem;
                }
        }

        @keyframes glowPulse {
                0% {
                        opacity: 0.65;
                        transform: scale(1);
                }
                100% {
                        opacity: 1;
                        transform: scale(1.18);
                }
        }
</style>
