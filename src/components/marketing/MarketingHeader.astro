---
import NavLink from './NavLink.astro';
import { SITE } from '../../consts';
---

<header class="marketing-header" data-scroll-shadow>
        <nav class="marketing-nav" aria-label="Navigasi utama">
                <a class="brand" href="/">
                        <span class="brand-icon" aria-hidden="true"></span>
                        <span class="brand-text">{SITE.title}</span>
                </a>
                <div class="nav-links">
                        <NavLink href="/">Beranda</NavLink>
                        <NavLink href="/layanan">Layanan</NavLink>
                        <NavLink href="/portofolio">Portofolio</NavLink>
                        <NavLink href="/blog">Blog</NavLink>
                        <NavLink href="/faq">FAQ</NavLink>
                        <NavLink href="/kontak">Kontak</NavLink>
                </div>
                <a class="cta" href="https://wa.me/6281234567890?text=Halo%20AstroPro%2C%20saya%20ingin%20konsultasi%20tentang%20proyek%20digital" rel="noreferrer" target="_blank">
                        Konsultasi Gratis
                </a>
        </nav>
</header>
<style>
        .marketing-header {
                margin: 0;
                padding: clamp(0.9rem, 2vw, 1.4rem) clamp(1.6rem, 6vw, 3.2rem);
                position: sticky;
                top: 0;
                z-index: 20;
                backdrop-filter: blur(16px);
                background: rgba(9, 12, 24, 0.72);
                border-bottom: 1px solid rgba(108, 126, 171, 0.22);
                box-shadow: 0 8px 24px rgba(7, 11, 22, 0.32);
                transition: background var(--transition-smooth), border var(--transition-smooth), box-shadow var(--transition-smooth);
        }

        .marketing-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: clamp(1rem, 2vw, 1.5rem);
        }

        .brand {
                display: inline-flex;
                align-items: center;
                gap: 0.65rem;
                text-decoration: none;
                color: rgb(var(--text-primary));
        }

        .brand-icon {
                width: 14px;
                height: 14px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--accent), rgba(168, 137, 255, 0.85));
                box-shadow: 0 0 14px rgba(90, 209, 255, 0.4);
                animation: brandPulse 3.6s ease-in-out infinite;
        }

        .brand-text {
                font-weight: 700;
                font-size: clamp(1rem, 2.1vw, 1.15rem);
                letter-spacing: 0.1em;
                text-transform: uppercase;
        }

        .nav-links {
                display: flex;
                gap: clamp(0.4rem, 1vw, 0.85rem);
                align-items: center;
                padding: 0.35rem 0.5rem;
                border-radius: 999px;
                background: rgba(13, 18, 32, 0.62);
                border: 1px solid rgba(108, 126, 171, 0.24);
        }

        .cta {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.65rem 1.6rem;
                border-radius: 999px;
                background: var(--accent-gradient);
                color: #fff;
                font-weight: 600;
                text-decoration: none;
                white-space: nowrap;
                border: 1px solid rgba(90, 209, 255, 0.45);
                box-shadow: 0 10px 24px rgba(34, 156, 235, 0.25);
                transition: transform var(--transition-base), box-shadow var(--transition-base), filter var(--transition-base);
        }

        .cta:hover,
        .cta:focus-visible {
                transform: translateY(-2px);
                box-shadow: 0 18px 34px rgba(34, 156, 235, 0.35);
                filter: saturate(1.08);
                outline: none;
        }

        @media (max-width: 960px) {
                .marketing-nav {
                        flex-wrap: wrap;
                }

                .nav-links {
                        width: 100%;
                        justify-content: center;
                        flex-wrap: wrap;
                }

                .cta {
                        width: 100%;
                        justify-content: center;
                        margin-top: 0.75rem;
                }
        }

        @keyframes brandPulse {
                0% {
                        transform: scale(0.92);
                        opacity: 0.8;
                }
                100% {
                        transform: scale(1.08);
                        opacity: 1;
                }
        }
</style>
