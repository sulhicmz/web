---
import NavLink from './NavLink.astro';
import { SITE } from '../../consts';
---

<header class="marketing-header" data-scroll-shadow>
        <div class="marketing-header__wrap">
        <nav class="marketing-nav" aria-label="Navigasi utama">
                <a class="brand" href="/">
                        <span class="brand-icon" aria-hidden="true"></span>
                        <span class="brand-text">{SITE.title}</span>
                </a>
                <div class="nav-links">
                        <NavLink href="/">Beranda</NavLink>
                        <NavLink href="/layanan">Layanan</NavLink>
                        <NavLink href="/portofolio">Portofolio</NavLink>
                        <NavLink href="/blog">Blog</NavLink>
                        <NavLink href="/faq">FAQ</NavLink>
                        <NavLink href="/kontak">Kontak</NavLink>
                </div>
                <a class="cta" href="https://wa.me/6281234567890?text=Halo%20AstroPro%2C%20saya%20ingin%20konsultasi%20tentang%20proyek%20digital" rel="noreferrer" target="_blank">
                        Konsultasi Gratis
                </a>
        </nav>
        </div>
</header>
<style>
        .marketing-header {
                margin: 0;
                padding: clamp(1rem, 1.5vw, 1.4rem) clamp(1.2rem, 4vw, 2.2rem) 0;
                position: sticky;
                top: 1.2rem;
                z-index: 20;
                background: transparent;
                transition: transform var(--transition-base), opacity var(--transition-base);
        }

        .marketing-header__wrap {
                width: min(1180px, 100%);
                margin: 0 auto;
                padding: 0 clamp(0.75rem, 4vw, 2rem);
        }

        .marketing-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: clamp(1rem, 2vw, 1.6rem);
                padding: clamp(0.65rem, 1.4vw, 1rem) clamp(1rem, 2.5vw, 1.75rem);
                border-radius: clamp(1.4rem, 3vw, 2.4rem);
                background: rgba(10, 16, 32, 0.92);
                border: 1px solid rgba(56, 189, 248, 0.16);
                box-shadow: 0 12px 24px rgba(5, 9, 24, 0.35);
        }

        .brand {
                display: inline-flex;
                align-items: center;
                gap: 0.65rem;
                text-decoration: none;
                color: var(--color-text-primary);
                position: relative;
        }

        .brand-icon {
                width: 18px;
                height: 18px;
                border-radius: 999px;
                background: linear-gradient(135deg, rgba(56, 189, 248, 0.9), rgba(147, 51, 234, 0.9));
                box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
        }

        .brand-text {
                font-weight: 700;
                font-size: clamp(1rem, 2.1vw, 1.15rem);
                letter-spacing: 0.1em;
                text-transform: uppercase;
                text-shadow: 0 0 18px rgba(147, 51, 234, 0.25);
        }

        .nav-links {
                display: flex;
                gap: clamp(0.6rem, 1.2vw, 1rem);
                align-items: center;
                padding: 0.4rem 0.6rem;
                border-radius: 999px;
                background: rgba(15, 23, 42, 0.7);
                border: 1px solid rgba(148, 163, 184, 0.18);
        }

        .cta {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.65rem 1.6rem;
                border-radius: 999px;
                background: var(--accent-gradient);
                color: var(--color-text-primary);
                font-weight: 600;
                text-decoration: none;
                white-space: nowrap;
                border: 1px solid rgba(var(--accent-rgb), 0.35);
                box-shadow: 0 10px 24px rgba(5, 12, 32, 0.35);
                transition: transform var(--transition-base), box-shadow var(--transition-base), filter var(--transition-base);
                position: relative;
        }

        .cta:hover,
        .cta:focus-visible {
                transform: translateY(-2px);
                box-shadow: var(--glow-primary);
                filter: saturate(1.08);
                outline: none;
        }

        @media (max-width: 960px) {
                .marketing-nav {
                        flex-wrap: wrap;
                }

                .nav-links {
                        width: 100%;
                        justify-content: center;
                        flex-wrap: wrap;
                }

                .cta {
                        width: 100%;
                        justify-content: center;
                        margin-top: 0.75rem;
                }
        }

        @media (prefers-reduced-motion: reduce) {
                .marketing-nav,
                .brand-icon,
                .cta {
                        transition: none;
                }
        }
</style>
