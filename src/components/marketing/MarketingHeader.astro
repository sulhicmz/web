---
import NavLink from './NavLink.astro';
import { SITE_TITLE, buildWhatsappLink } from '../../consts';
---

<header class="marketing-header">
        <nav class="marketing-nav" aria-label="Navigasi utama">
                <a class="brand" href="/">{SITE_TITLE}</a>
                <div class="nav-links">
                        <NavLink href="/">Beranda</NavLink>
                        <NavLink href="/layanan">Layanan</NavLink>
                        <NavLink href="/portofolio">Portofolio</NavLink>
                        <NavLink href="/blog">Blog</NavLink>
                        <NavLink href="/faq">FAQ</NavLink>
                        <NavLink href="/kontak">Kontak</NavLink>
                </div>
                <a class="cta" href={buildWhatsappLink()} rel="noreferrer" target="_blank">
                        Konsultasi Gratis
                </a>
        </nav>
</header>
<style>
        .marketing-header {
                margin: 0;
                padding: 0.75rem 1.5rem;
                background: #ffffff;
                border-bottom: 1px solid rgba(var(--gray-light), 0.8);
        }

        .marketing-nav {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
        }

        .brand {
                font-weight: 700;
                font-size: 1.1rem;
                color: rgb(var(--black));
                text-decoration: none;
        }

        .nav-links {
                display: flex;
                gap: 0.75rem;
                align-items: center;
        }

        .cta {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0.5rem 1rem;
                border-radius: 999px;
                background: var(--accent);
                color: #fff;
                font-weight: 600;
                text-decoration: none;
                white-space: nowrap;
        }

        .cta:hover,
        .cta:focus-visible {
                background: var(--accent-dark);
                outline: none;
        }

        @media (max-width: 960px) {
                .marketing-nav {
                        flex-wrap: wrap;
                }

                .nav-links {
                        width: 100%;
                        justify-content: center;
                        flex-wrap: wrap;
                }

                .cta {
                        width: 100%;
                        justify-content: center;
                }
        }
</style>
