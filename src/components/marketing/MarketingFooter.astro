---
import {
        SITE_TITLE,
        SITE_DESCRIPTION,
        CONTACT_EMAIL,
        buildWhatsappLink,
} from '../../consts';

const currentYear = new Date().getFullYear();
---

<footer class="marketing-footer">
        <div class="footer-grid">
                <section class="footer-about">
                        <p class="brand">{SITE_TITLE}</p>
                        <p>{SITE_DESCRIPTION}</p>
                </section>
                <section>
                        <h2>Navigasi</h2>
                        <ul>
                                <li><a href="/layanan">Layanan &amp; Harga</a></li>
                                <li><a href="/portofolio">Portofolio</a></li>
                                <li><a href="/blog">Blog &amp; Insight</a></li>
                                <li><a href="/faq">FAQ</a></li>
                                <li><a href="/portal">Portal Klien</a></li>
                        </ul>
                </section>
                <section>
                        <h2>Kontak</h2>
                        <ul>
                                <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
                                <li><a href={buildWhatsappLink()} rel="noreferrer" target="_blank">WhatsApp Tim</a></li>
                                <li>Jam operasional: Senin–Jumat, 09.00–18.00 WIB</li>
                        </ul>
                </section>
        </div>
        <div class="footer-bottom">
                <span>&copy; {currentYear} {SITE_TITLE}. Seluruh hak cipta dilindungi.</span>
        </div>
</footer>
<style>
        .marketing-footer {
                padding: clamp(3rem, 8vw, 5rem) clamp(1.75rem, 6vw, 4rem) clamp(2.5rem, 5vw, 3.5rem);
                background: rgba(8, 11, 22, 0.85);
                border-top: 1px solid rgba(108, 126, 171, 0.18);
                position: relative;
                overflow: hidden;
        }

        .marketing-footer::before {
                content: "";
                position: absolute;
                inset: auto -20% -40%;
                height: 280px;
                background: radial-gradient(circle, rgba(90, 209, 255, 0.2), transparent 70%);
                filter: blur(30px);
                opacity: 0.6;
        }

        .footer-grid {
                position: relative;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: clamp(1.5rem, 4vw, 2.5rem);
                max-width: 1080px;
                margin: 0 auto;
        }

        .brand {
                font-size: 1.25rem;
                font-weight: 700;
                margin-bottom: 0.5rem;
                color: rgb(var(--text-primary));
        }

        .footer-about p:last-of-type {
                color: rgb(var(--text-secondary));
        }

        h2 {
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 0.9rem;
                color: rgb(var(--text-muted));
        }

        ul {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                gap: 0.55rem;
        }

        a {
                color: rgb(var(--text-secondary));
                text-decoration: none;
                transition: color var(--transition-base), text-shadow var(--transition-base);
        }

        a:hover,
        a:focus-visible {
                color: rgb(var(--text-primary));
                text-shadow: 0 0 12px rgba(90, 209, 255, 0.35);
        }

        .footer-bottom {
                margin-top: clamp(2rem, 5vw, 3rem);
                text-align: center;
                font-size: 0.85rem;
                color: rgba(var(--text-muted), 0.85);
        }

        @media (max-width: 720px) {
                .marketing-footer {
                        text-align: center;
                }
        }
</style>
