---
import {
        SITE_TITLE,
        SITE_DESCRIPTION,
        CONTACT_EMAIL,
        buildWhatsappLink,
} from '../../consts';

const currentYear = new Date().getFullYear();
---

<footer class="marketing-footer">
        <div class="footer-grid">
                <section>
                        <p class="brand">{SITE_TITLE}</p>
                        <p>{SITE_DESCRIPTION}</p>
                </section>
                <section>
                        <h2>Navigasi</h2>
                        <ul>
                                <li><a href="/layanan">Layanan &amp; Harga</a></li>
                                <li><a href="/portofolio">Portofolio</a></li>
                                <li><a href="/blog">Blog &amp; Insight</a></li>
                                <li><a href="/faq">FAQ</a></li>
                                <li><a href="/portal">Portal Klien</a></li>
                        </ul>
                </section>
                <section>
                        <h2>Kontak</h2>
                        <ul>
                                <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
                                <li><a href={buildWhatsappLink()} rel="noreferrer" target="_blank">WhatsApp Tim</a></li>
                                <li>Jam operasional: Senin–Jumat, 09.00–18.00 WIB</li>
                        </ul>
                </section>
        </div>
        <p class="copyright">&copy; {currentYear} {SITE_TITLE}. Seluruh hak cipta dilindungi.</p>
</footer>
<style>
        .marketing-footer {
                padding: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 6vw, 4rem) clamp(3rem, 6vw, 4.5rem);
                background: linear-gradient(180deg, rgba(12, 15, 26, 0.85) 0%, rgba(5, 6, 15, 0.95) 100%);
                color: rgb(var(--text-secondary));
                border-top: 1px solid rgba(124, 133, 178, 0.16);
                position: relative;
                overflow: hidden;
        }

        .footer-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 2rem;
                max-width: 1080px;
                margin: 0 auto;
                position: relative;
        }

        .brand {
                font-size: 1.35rem;
                font-weight: 700;
                margin-bottom: 0.5rem;
                color: rgb(var(--text-primary));
                text-shadow: 0 0 18px rgba(124, 77, 255, 0.35);
        }

        h2 {
                font-size: 0.95rem;
                text-transform: uppercase;
                letter-spacing: 0.1em;
                margin-bottom: 0.9rem;
                color: rgb(var(--text-muted));
        }

        ul {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                gap: 0.5rem;
        }

        a {
                color: rgb(var(--text-secondary));
                text-decoration: none;
                transition: color var(--transition-base), text-shadow var(--transition-base);
        }

        a:hover,
        a:focus-visible {
                color: rgb(var(--text-primary));
                text-decoration: none;
                text-shadow: 0 0 16px rgba(124, 77, 255, 0.5);
        }

        .copyright {
                margin-top: clamp(2rem, 5vw, 3rem);
                text-align: center;
                font-size: 0.85rem;
                opacity: 0.65;
                color: rgb(var(--text-muted));
        }

        @media (max-width: 720px) {
                .marketing-footer {
                        text-align: center;
                }

                .footer-grid {
                        gap: 1.75rem;
                }
        }
</style>
