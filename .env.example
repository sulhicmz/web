# ==========================================================================
# AstroPro Digital - Environment Variables
# Copy this file to .env and fill in your actual values
# ==========================================================================

# Site Configuration
PUBLIC_SITE_URL=https://your-domain.com
PUBLIC_SITE_NAME="AstroPro Digital"
PUBLIC_SITE_DESCRIPTION="Platform manajemen proyek dan konsultasi digital terpercaya untuk bisnis Anda."

# Supabase Configuration (Required)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Gateway (Midtrans)
PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
PUBLIC_MIDTRANS_IS_PRODUCTION=false

# WhatsApp Business API (Optional)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Analytics (Optional)
PUBLIC_ENABLE_ANALYTICS=true
PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
PUBLIC_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Feature Flags
PUBLIC_ENABLE_PAYMENTS=true
PUBLIC_ENABLE_WHATSAPP=true

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@your-domain.com

# File Upload (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Security
JWT_SECRET=your-jwt-secret-key-here
ENCRYPTION_KEY=your-32-character-encryption-key

# Development
NODE_ENV=development
PUBLIC_API_URL=http://localhost:4321/api

# Production (uncomment for production)
# NODE_ENV=production
# PUBLIC_API_URL=https://your-domain.com/api

# ==========================================================================
# IMPORTANT NOTES:
# ==========================================================================
# 1. Never commit .env file to version control
# 2. Use different values for development and production
# 3. Keep sensitive keys secure and rotate them regularly
# 4. Use strong, unique passwords for all services
# 5. Enable 2FA on all external services where possible
# ==========================================================================